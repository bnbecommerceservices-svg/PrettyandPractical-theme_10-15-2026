{{ 'pp-404.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pp-404.js' | asset_url }}" defer></script>

{% liquid
  assign pp_garden_url = collections['home-garden'].url | default: '/collections/home-garden'
  assign pp_garden_try = 'garden-outdoor,garden-and-outdoor,outdoor-garden,garden,home-garden,home-and-garden' | split: ','
  for h in pp_garden_try
    if collections[h].url != blank
      assign pp_garden_url = collections[h].url
      break
    endif
  endfor
%}

<main id="main" class="pp-404">
  <div class="pp-wrap">
    <div class="pp-404__inner">
      <svg class="pp-404__art" viewBox="0 0 320 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M30 28 H290 V196 H30 Z" fill="var(--pp-bg-subtle)"/>
        <path d="M30 196 L4 252 H316 L290 196 Z" fill="var(--pp-bg-subtle)"/>
        <path d="M30 196 H290" stroke="var(--pp-navy)" stroke-width="2" stroke-linecap="round"/>
        <path d="M30 196 L4 252" stroke="var(--pp-navy)" stroke-width="2" stroke-linecap="round"/>
        <path d="M290 196 L316 252" stroke="var(--pp-navy)" stroke-width="2" stroke-linecap="round"/>
        <path d="M30 28 H290 V196" stroke="var(--pp-navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M120 196 L104 252" stroke="var(--pp-navy)" stroke-width="1" stroke-opacity="0.25" stroke-linecap="round"/>
        <path d="M200 196 L212 252" stroke="var(--pp-navy)" stroke-width="1" stroke-opacity="0.25" stroke-linecap="round"/>
        <rect x="58" y="58" width="78" height="74" rx="3" fill="var(--pp-white)" stroke="var(--pp-navy)" stroke-width="2"/>
        <path d="M97 58 V132 M58 95 H136" stroke="var(--pp-navy)" stroke-width="1.5" stroke-opacity="0.55"/>
        <g>
          <rect x="176" y="118" width="92" height="68" rx="4" transform="rotate(-6 176 118)" fill="var(--pp-white)" stroke="var(--pp-primary)" stroke-width="2.5"/>
          <text x="218" y="160" transform="rotate(-6 218 160)" text-anchor="middle" font-family="Sora, sans-serif" font-size="30" font-weight="800" fill="var(--pp-primary)">404</text>
        </g>
        <g>
          <path d="M70 150 q0 -42 30 -42 h22 q30 0 30 42 v6 H70 Z" fill="var(--pp-white)" stroke="var(--pp-navy)" stroke-width="2" stroke-linejoin="round"/>
          <path d="M66 156 h94 v18 q0 6 -6 6 H72 q-6 0 -6 -6 Z" fill="var(--pp-white)" stroke="var(--pp-navy)" stroke-width="2" stroke-linejoin="round"/>
          <path d="M66 156 q-8 0 -8 12 v16 q0 6 6 6 h6 v-22 q0 -12 -4 -12 Z" fill="var(--pp-white)" stroke="var(--pp-navy)" stroke-width="2" stroke-linejoin="round"/>
          <path d="M160 156 q8 0 8 12 v16 q0 6 -6 6 h-6 v-22 q0 -12 4 -12 Z" fill="var(--pp-white)" stroke="var(--pp-navy)" stroke-width="2" stroke-linejoin="round"/>
          <path d="M70 186 v8 M156 186 v8" stroke="var(--pp-navy)" stroke-width="2" stroke-linecap="round"/>
          <rect x="92" y="124" width="42" height="34" rx="7" fill="var(--pp-primary)"/>
          <path d="M99 141 h28" stroke="var(--pp-white)" stroke-width="1.5" stroke-opacity="0.6" stroke-linecap="round"/>
        </g>
      </svg>

      <h1 class="pp-404__title">This room is empty.</h1>
      <p class="pp-404__sub">The page you're looking for has moved, been removed, or never existed. Let's get you back on track.</p>

      <form class="pp-404__search" role="search" action="{{ routes.search_url }}" method="get">
        <button type="button" class="pp-404__search-icon" id="searchIcon" aria-label="Search products">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <input type="search" id="searchInput" name="q" placeholder="Search furniture, decor, bedding..." aria-label="Search products">
        <button type="button" class="pp-404__search-btn" id="searchSubmit" aria-label="Submit search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>

      <p class="pp-404__divider">Or browse by category</p>

      <ul class="pp-404__pills" role="list">
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Furniture" data-url="{% if section.settings.furniture_url != blank %}{{ section.settings.furniture_url }}{% else %}{{ routes.search_url }}?q={{ 'Furniture' | url_encode }}{% endif %}">Furniture</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Garden & Outdoor" data-url="{% if section.settings.outdoor_url != blank %}{{ section.settings.outdoor_url }}{% else %}{{ pp_garden_url }}{% endif %}">Garden &amp; Outdoor</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Kitchen" data-url="{% if section.settings.kitchen_url != blank %}{{ section.settings.kitchen_url }}{% else %}{{ routes.search_url }}?q={{ 'Kitchen' | url_encode }}{% endif %}">Kitchen</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Decor" data-url="{% if section.settings.decor_url != blank %}{{ section.settings.decor_url }}{% else %}{{ routes.search_url }}?q={{ 'Decor' | url_encode }}{% endif %}">Decor</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Bath" data-url="{% if section.settings.bath_url != blank %}{{ section.settings.bath_url }}{% else %}{{ routes.search_url }}?q={{ 'Bath' | url_encode }}{% endif %}">Bath</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Baby &amp; Kids" data-url="{% if section.settings.baby_kids_url != blank %}{{ section.settings.baby_kids_url }}{% else %}{{ routes.search_url }}?q={{ 'Baby & Kids' | url_encode }}{% endif %}">Baby &amp; Kids</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Toys" data-url="{% if section.settings.toys_url != blank %}{{ section.settings.toys_url }}{% else %}{{ routes.search_url }}?q={{ 'Toys' | url_encode }}{% endif %}">Toys</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Hobbies" data-url="{% if section.settings.hobbies_url != blank %}{{ section.settings.hobbies_url }}{% else %}{{ routes.search_url }}?q={{ 'Hobbies' | url_encode }}{% endif %}">Hobbies</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Sports" data-url="{% if section.settings.sports_url != blank %}{{ section.settings.sports_url }}{% else %}{{ routes.search_url }}?q={{ 'Sports' | url_encode }}{% endif %}">Sports</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Pets" data-url="{% if section.settings.pets_url != blank %}{{ section.settings.pets_url }}{% else %}{{ routes.search_url }}?q={{ 'Pets' | url_encode }}{% endif %}">Pets</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Lighting" data-url="{% if section.settings.lighting_url != blank %}{{ section.settings.lighting_url }}{% else %}{{ routes.search_url }}?q={{ 'Lighting' | url_encode }}{% endif %}">Lighting</button></li>
        <li role="listitem"><button type="button" class="pp-404__pill" data-cat="Bedding" data-url="{% if section.settings.bedding_url != blank %}{{ section.settings.bedding_url }}{% else %}{{ routes.search_url }}?q={{ 'Bedding' | url_encode }}{% endif %}">Bedding</button></li>
      </ul>

      <a href="{{ routes.root_url }}" class="pp-404__back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to home
      </a>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "PP 404",
  "settings": [
    {
      "type": "url",
      "id": "furniture_url",
      "label": "Furniture URL"
    },
    {
      "type": "url",
      "id": "outdoor_url",
      "label": "Garden & Outdoor URL"
    },
    {
      "type": "url",
      "id": "kitchen_url",
      "label": "Kitchen URL"
    },
    {
      "type": "url",
      "id": "decor_url",
      "label": "Decor URL"
    },
    {
      "type": "url",
      "id": "bath_url",
      "label": "Bath URL"
    },
    {
      "type": "url",
      "id": "baby_kids_url",
      "label": "Baby & Kids URL"
    },
    {
      "type": "url",
      "id": "toys_url",
      "label": "Toys URL"
    },
    {
      "type": "url",
      "id": "hobbies_url",
      "label": "Hobbies URL"
    },
    {
      "type": "url",
      "id": "sports_url",
      "label": "Sports URL"
    },
    {
      "type": "url",
      "id": "pets_url",
      "label": "Pets URL"
    },
    {
      "type": "url",
      "id": "lighting_url",
      "label": "Lighting URL"
    },
    {
      "type": "url",
      "id": "bedding_url",
      "label": "Bedding URL"
    }
  ]
}
{% endschema %}
