{{ 'pp-404.css' | asset_url | stylesheet_tag }}
{{ 'pp-product-card.css' | asset_url | stylesheet_tag }}
{{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}

{% liquid
  assign pp_garden_url = collections['home-garden'].url | default: '/collections/home-garden'
  assign pp_garden_try = 'garden-outdoor,garden-and-outdoor,outdoor-garden,garden,home-garden,home-and-garden' | split: ','
  for h in pp_garden_try
    if collections[h].url != blank
      assign pp_garden_url = collections[h].url
      break
    endif
  endfor

  assign pp_404_collection = section.settings.products_collection
  if pp_404_collection == blank
    assign pp_404_collection = collections.all
  endif
  assign pp_404_products_url = pp_404_collection.url | default: routes.all_products_collection_url
%}

<div class="pp-404">
  <div class="pp-wrap">
    <div class="pp-404__inner">
      <div class="pp-404__hero" aria-hidden="true">
        <span class="pp-404__digit">4</span>
        <span class="pp-404__digit">0</span>
        <span class="pp-404__digit">4</span>
        <span class="pp-404__plant">
          <svg viewBox="0 0 80 110" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M40 62 C22 52 12 34 16 14 C32 22 42 40 40 62 Z" fill="#3f9d5c"/>
            <path d="M40 62 C56 50 66 34 62 10 C46 20 38 40 40 62 Z" fill="#3f9d5c"/>
            <path d="M40 64 C30 58 18 56 6 60 C16 70 30 72 40 64 Z" fill="#3f9d5c"/>
            <path d="M40 64 C50 56 64 54 76 58 C66 70 52 72 40 64 Z" fill="#3f9d5c"/>
            <path d="M12 62 H68 L60 104 Q59 108 55 108 H25 Q21 108 20 104 Z" fill="#0f172a"/>
          </svg>
        </span>
      </div>

      <p class="pp-404__eyebrow">Error 404 &middot; Page not found</p>
      <h1 class="pp-404__title">{{ section.settings.heading | default: "Oops! This room's empty." }}</h1>
      <p class="pp-404__sub">{{ section.settings.text | default: "The page you're looking for has moved, been removed, or never existed. Try a search or pick a room below." }}</p>

      <form class="pp-404__search" role="search" action="{{ routes.search_url }}" method="get">
        <svg class="pp-404__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" name="q" placeholder="Search furniture, decor, mirrors..." aria-label="Search products">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="pp-404__search-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>

      <div class="pp-404__actions">
        <a href="{{ routes.root_url }}" class="pp-404__btn pp-404__btn--primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to home
        </a>
        <a href="{{ pp_404_products_url }}" class="pp-404__btn pp-404__btn--outline">Shop all products</a>
      </div>

      <p class="pp-404__divider"><span>Or browse by room</span></p>

      <ul class="pp-404__pills" role="list">
        <li><a class="pp-404__pill" href="{% if section.settings.furniture_url != blank %}{{ section.settings.furniture_url }}{% else %}{{ routes.search_url }}?q={{ 'Furniture' | url_encode }}{% endif %}">Furniture</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.outdoor_url != blank %}{{ section.settings.outdoor_url }}{% else %}{{ pp_garden_url }}{% endif %}">Garden &amp; Outdoor</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.kitchen_url != blank %}{{ section.settings.kitchen_url }}{% else %}{{ routes.search_url }}?q={{ 'Kitchen' | url_encode }}{% endif %}">Kitchen</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.decor_url != blank %}{{ section.settings.decor_url }}{% else %}{{ routes.search_url }}?q={{ 'Decor' | url_encode }}{% endif %}">Decor</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.bath_url != blank %}{{ section.settings.bath_url }}{% else %}{{ routes.search_url }}?q={{ 'Bath' | url_encode }}{% endif %}">Bath</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.baby_kids_url != blank %}{{ section.settings.baby_kids_url }}{% else %}{{ routes.search_url }}?q={{ 'Baby & Kids' | url_encode }}{% endif %}">Baby &amp; Kids</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.toys_url != blank %}{{ section.settings.toys_url }}{% else %}{{ routes.search_url }}?q={{ 'Toys' | url_encode }}{% endif %}">Toys</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.hobbies_url != blank %}{{ section.settings.hobbies_url }}{% else %}{{ routes.search_url }}?q={{ 'Hobbies' | url_encode }}{% endif %}">Hobbies</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.sports_url != blank %}{{ section.settings.sports_url }}{% else %}{{ routes.search_url }}?q={{ 'Sports' | url_encode }}{% endif %}">Sports</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.pets_url != blank %}{{ section.settings.pets_url }}{% else %}{{ routes.search_url }}?q={{ 'Pets' | url_encode }}{% endif %}">Pets</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.lighting_url != blank %}{{ section.settings.lighting_url }}{% else %}{{ routes.search_url }}?q={{ 'Lighting' | url_encode }}{% endif %}">Lighting</a></li>
        <li><a class="pp-404__pill" href="{% if section.settings.bedding_url != blank %}{{ section.settings.bedding_url }}{% else %}{{ routes.search_url }}?q={{ 'Bedding' | url_encode }}{% endif %}">Bedding</a></li>
      </ul>
    </div>

    {%- if section.settings.show_products and pp_404_collection.products_count > 0 -%}
      <div class="pp-404__products">
        <div class="pp-404__products-head">
          <h2 class="pp-404__products-title">{{ section.settings.products_heading | default: 'Popular right now' }}</h2>
          <a href="{{ pp_404_products_url }}" class="pp-404__products-link">View all</a>
        </div>
        <div class="pp-cards pp-cards--grid">
          {%- for product in pp_404_collection.products limit: 4 -%}
            {% render 'pp-collection-product-card', product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PP 404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oops! This room's empty."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The page you're looking for has moved, been removed, or never existed. Try a search or pick a room below."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show products",
      "default": true
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products heading",
      "default": "Popular right now"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products collection",
      "info": "Shows the first 4 products. Uses all products when empty."
    },
    {
      "type": "header",
      "content": "Room links"
    },
    {
      "type": "url",
      "id": "furniture_url",
      "label": "Furniture URL"
    },
    {
      "type": "url",
      "id": "outdoor_url",
      "label": "Garden & Outdoor URL"
    },
    {
      "type": "url",
      "id": "kitchen_url",
      "label": "Kitchen URL"
    },
    {
      "type": "url",
      "id": "decor_url",
      "label": "Decor URL"
    },
    {
      "type": "url",
      "id": "bath_url",
      "label": "Bath URL"
    },
    {
      "type": "url",
      "id": "baby_kids_url",
      "label": "Baby & Kids URL"
    },
    {
      "type": "url",
      "id": "toys_url",
      "label": "Toys URL"
    },
    {
      "type": "url",
      "id": "hobbies_url",
      "label": "Hobbies URL"
    },
    {
      "type": "url",
      "id": "sports_url",
      "label": "Sports URL"
    },
    {
      "type": "url",
      "id": "pets_url",
      "label": "Pets URL"
    },
    {
      "type": "url",
      "id": "lighting_url",
      "label": "Lighting URL"
    },
    {
      "type": "url",
      "id": "bedding_url",
      "label": "Bedding URL"
    }
  ]
}
{% endschema %}
