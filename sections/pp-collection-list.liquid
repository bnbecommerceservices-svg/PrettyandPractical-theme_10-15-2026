{%- comment -%}
  "Shop by category" page at /collections (list-collections template).

  Built only from the store's own data, following Shopify's list-collections
  guidance (shopify.dev/docs/storefronts/themes/architecture/templates/list-collections):
  - Collections come from the global `collections` object (alphabetical), or
    from a menu picked in the theme editor when a custom order is wanted.
  - When that menu has nested items (departments with sub-categories), the page
    is grouped: each department gets a heading, a "Shop all" link and a grid of
    its sub-categories. Departments without sub-categories share one grid.
  - Card images use `collection.featured_image`, which is the collection image
    or, when none is set, the first product's featured image.
  - Counts use `collection.all_products_count`.
  - "Shop by product type" lists `shop.types`, linking to the all-products
    collection filtered by type. Types that differ only in capitalisation
    ("Plant Stand" / "Plant stand") share one link that covers both.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign total_products = collections.all.all_products_count | default: 0
  assign grouped = false
  if menu != blank and menu.links.size > 0
    for link in menu.links
      if link.links.size > 0
        assign grouped = true
        break
      endif
    endfor
  endif
-%}

{%- assign department_count = 0 -%}
{%- capture department_blocks -%}
  {%- if grouped -%}
    {%- capture single_cards -%}
      {%- for link in menu.links -%}
        {%- if link.links.size == 0 and link.type == 'collection_link' and link.object.all_products_count > 0 -%}
          {%- render 'pp-collection-list-card', collection: link.object -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- for link in menu.links -%}
      {%- if link.links.size == 0 -%}{%- continue -%}{%- endif -%}
      {%- capture child_cards -%}
        {%- for child in link.links -%}
          {%- if child.type == 'collection_link' and child.object.all_products_count > 0 -%}
            {%- render 'pp-collection-list-card', collection: child.object, heading_tag: 'h3' -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if child_cards == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign department_count = department_count | plus: 1
        assign dept_count = 0
        if link.type == 'collection_link'
          assign dept_count = link.object.all_products_count | default: 0
        endif
        assign dept_id = 'pp-clist-' | append: link.handle
      -%}
      <section class="pp-clist__dept" id="{{ dept_id }}" aria-labelledby="{{ dept_id }}-title">
        <div class="pp-clist__dept-head">
          <div>
            <h2 id="{{ dept_id }}-title" class="pp-clist__dept-title"><a href="{{ link.url }}">{{ link.title | escape }}</a></h2>
            {%- if dept_count > 0 -%}
              <p class="pp-clist__dept-meta">{{ dept_count }} {% if dept_count == 1 %}product{% else %}products{% endif %}</p>
            {%- endif -%}
          </div>
          <a class="pp-clist__dept-all" href="{{ link.url }}">Shop all {{ link.title | escape }} <span aria-hidden="true">→</span></a>
        </div>
        <ul class="pp-clist__grid" role="list">
          {{ child_cards }}
        </ul>
      </section>
    {%- endfor -%}
    {%- if single_cards != blank -%}
      <section class="pp-clist__dept" aria-labelledby="pp-clist-more-title">
        <div class="pp-clist__dept-head">
          <h2 id="pp-clist-more-title" class="pp-clist__dept-title">More categories</h2>
        </div>
        <ul class="pp-clist__grid" role="list">
          {{ single_cards }}
        </ul>
      </section>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign department_blocks = department_blocks | strip -%}

{%- assign collection_count = 0 -%}
{%- capture collection_cards -%}
  {%- if grouped -%}
  {%- elsif menu != blank and menu.links.size > 0 -%}
    {%- for link in menu.links -%}
      {%- if link.type == 'collection_link' and link.object != blank and link.object.all_products_count > 0 -%}
        {%- assign collection_count = collection_count | plus: 1 -%}
        {%- render 'pp-collection-list-card', collection: link.object -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- paginate collections by 48 -%}
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' or collection.handle == 'all' or collection.all_products_count == 0 -%}
          {%- assign collection_count = collection_count | plus: 1 -%}
          {%- render 'pp-collection-list-card', collection: collection -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign collection_cards = collection_cards | strip -%}

<section class="pp-clist" aria-labelledby="pp-clist-title">
  <div class="pp-clist__head">
    <div class="pp-wrap">
      <nav class="pp-clist__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <span aria-current="page">{{ section.settings.breadcrumb_label | default: 'Collections' | escape }}</span>
      </nav>
      <h1 id="pp-clist-title" class="pp-clist__title">{{ section.settings.heading | default: 'Shop by category' | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="pp-clist__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <p class="pp-clist__stats">
        {%- if grouped and department_count > 0 -%}
          <span>{{ department_count }} {% if department_count == 1 %}department{% else %}departments{% endif %}</span>
          {%- assign collection_count = department_count -%}
        {%- elsif collection_count > 0 -%}
          <span>{{ collection_count }} {% if collection_count == 1 %}collection{% else %}collections{% endif %}</span>
        {%- endif -%}
        {%- if collection_count > 0 and total_products > 0 -%}
          <span aria-hidden="true">·</span>
        {%- endif -%}
        {%- if total_products > 0 -%}
          <a href="{{ routes.all_products_collection_url }}">Shop all {{ total_products }} products</a>
        {%- endif -%}
      </p>
      {%- if grouped and department_count > 1 -%}
        <nav class="pp-clist__jump" aria-label="Departments">
          <ul class="pp-clist__chips" role="list">
            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                <li><a class="pp-clist__chip" href="#pp-clist-{{ link.handle }}">{{ link.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>

  <div class="pp-wrap">
    {%- if department_blocks != blank -%}
      {{ department_blocks }}
    {%- elsif collection_cards != blank -%}
      <ul class="pp-clist__grid" role="list">
        {{ collection_cards }}
      </ul>
    {%- else -%}
      <p class="pp-clist__empty">There are no collections to show yet.</p>
    {%- endif -%}

    {%- if section.settings.show_types and shop.types.size > 0 -%}
      {%- assign sorted_types = shop.types | sort_natural -%}
      {%- capture type_chips -%}
        {%- assign seen = '|' -%}
        {%- for type in sorted_types -%}
          {%- assign type_label = type | strip -%}
          {%- assign type_key = type_label | downcase -%}
          {%- assign seen_key = '|' | append: type_key | append: '|' -%}
          {%- if type_label == blank or seen contains seen_key -%}{%- continue -%}{%- endif -%}
          {%- assign seen = seen | append: type_key | append: '|' -%}
          {%- comment -%} One link covering every spelling of this type, e.g. "Plant Stand" and "Plant stand". {%- endcomment -%}
          {%- assign type_query = '' -%}
          {%- for other in sorted_types -%}
            {%- assign other_label = other | strip -%}
            {%- assign other_key = other_label | downcase -%}
            {%- if other_key == type_key -%}
              {%- if type_query != '' -%}{%- assign type_query = type_query | append: '&' -%}{%- endif -%}
              {%- assign other_value = other_label | url_encode -%}
              {%- assign type_query = type_query | append: 'filter.p.product_type=' | append: other_value -%}
            {%- endif -%}
          {%- endfor -%}
          <li><a class="pp-clist__chip" href="{{ routes.all_products_collection_url }}?{{ type_query }}">{{ type_label | escape }}</a></li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if type_chips != blank -%}
        <div class="pp-clist__types" aria-labelledby="pp-clist-types-title">
          <h2 id="pp-clist-types-title" class="pp-clist__types-title">{{ section.settings.types_heading | default: 'Shop by product type' | escape }}</h2>
          <ul class="pp-clist__chips" role="list">
            {{ type_chips }}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{%- if collection_cards != blank or department_blocks != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ section.settings.heading | default: 'Shop by category' | json }},
      "url": {{ request.origin | append: routes.collections_url | json }},
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection_count }},
        "itemListElement": [
          {%- assign position = 0 -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            {%- for link in menu.links -%}
              {%- if link.type == 'collection_link' and link.object != blank and link.object.all_products_count > 0 -%}
                {%- assign position = position | plus: 1 -%}
                {%- unless position == 1 -%},{%- endunless -%}
                {"@type": "ListItem", "position": {{ position }}, "name": {{ link.object.title | json }}, "url": {{ request.origin | append: link.object.url | json }}}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for collection in collections -%}
              {%- unless collection.handle == 'frontpage' or collection.handle == 'all' or collection.all_products_count == 0 -%}
                {%- assign position = position | plus: 1 -%}
                {%- unless position == 1 -%},{%- endunless -%}
                {"@type": "ListItem", "position": {{ position }}, "name": {{ collection.title | json }}, "url": {{ request.origin | append: collection.url | json }}}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        ]
      }
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .pp-clist {
    padding-bottom: 64px;
    background: #fff;
  }

  .pp-clist__head {
    margin-bottom: 32px;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--pp-border-light, #f3f4f6);
    background: var(--pp-bg-subtle, #f7f8fa);
  }

  .pp-clist__crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
    font-size: 13px;
    color: var(--pp-text-muted, #9ca3af);
  }

  .pp-clist__crumbs a {
    color: var(--pp-text-secondary, #4b5563);
    text-decoration: none;
  }

  .pp-clist__crumbs a:hover {
    color: var(--pp-primary, #e8532a);
  }

  .pp-clist__crumbs svg {
    width: 14px;
    height: 14px;
  }

  .pp-clist__title {
    margin: 0;
    font-family: var(--pp-font-heading);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--pp-navy, #111827);
  }

  .pp-clist__sub {
    max-width: 640px;
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--pp-text-secondary, #4b5563);
  }

  .pp-clist__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--pp-text-secondary, #4b5563);
  }

  .pp-clist__stats a {
    color: var(--pp-primary, #e8532a);
    text-decoration: none;
  }

  .pp-clist__stats a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pp-clist__jump {
    margin-top: 20px;
  }

  .pp-clist__dept {
    scroll-margin-top: 140px;
  }

  .pp-clist__dept + .pp-clist__dept {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--pp-border-light, #f3f4f6);
  }

  .pp-clist__dept-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .pp-clist__dept-title {
    margin: 0;
    font-family: var(--pp-font-heading);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--pp-navy, #111827);
  }

  .pp-clist__dept-title a {
    color: inherit;
    text-decoration: none;
  }

  .pp-clist__dept-title a:hover {
    color: var(--pp-primary, #e8532a);
  }

  .pp-clist__dept-meta {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--pp-text-secondary, #4b5563);
  }

  .pp-clist__dept-all {
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--pp-primary, #e8532a);
    text-decoration: none;
    white-space: nowrap;
  }

  .pp-clist__dept-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pp-clist__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pp-clist__card {
    min-width: 0;
  }

  .pp-clist__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .pp-clist__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--pp-border-light, #f3f4f6);
    border-radius: var(--pp-radius-lg, 16px);
    background: #fff;
  }

  .pp-clist__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .pp-clist__link:hover .pp-clist__media img {
    transform: scale(1.04);
  }

  .pp-clist__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: var(--pp-text-muted, #9ca3af);
    background: var(--pp-bg-subtle, #f7f8fa);
  }

  .pp-clist__placeholder svg {
    width: 40px;
    height: 40px;
    opacity: 0.5;
  }

  .pp-clist__info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 4px 0;
  }

  .pp-clist__name {
    margin: 0;
    font-family: var(--pp-font-heading);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--pp-navy, #111827);
    transition: color 0.2s ease;
  }

  .pp-clist__count {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    color: var(--pp-text-secondary, #4b5563);
  }

  .pp-clist__arrow {
    display: inline-flex;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--pp-border, #e5e7eb);
    border-radius: 50%;
    color: var(--pp-navy, #111827);
    transition: background-color 0.22s ease, border-color 0.22s ease, color 0.22s ease, translate 0.22s ease;
  }

  .pp-clist__arrow svg {
    width: 16px;
    height: 16px;
  }

  .pp-clist__link:hover .pp-clist__name {
    color: var(--pp-primary, #e8532a);
  }

  .pp-clist__link:hover .pp-clist__arrow {
    border-color: var(--pp-primary, #e8532a);
    background: var(--pp-primary, #e8532a);
    color: #fff;
    translate: 2px 0;
  }

  .pp-clist__link:focus-visible {
    outline: 2px solid var(--pp-primary, #e8532a);
    outline-offset: 4px;
    border-radius: var(--pp-radius-lg, 16px);
  }

  .pp-clist__empty {
    padding: 40px 0;
    color: var(--pp-text-secondary, #4b5563);
  }

  .pp-clist__types {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--pp-border-light, #f3f4f6);
  }

  .pp-clist__types-title {
    margin: 0 0 18px;
    font-family: var(--pp-font-heading);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--pp-navy, #111827);
  }

  .pp-clist__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pp-clist__chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--pp-border, #e5e7eb);
    border-radius: 999px;
    background: #fff;
    color: var(--pp-navy, #111827);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .pp-clist__chip:hover {
    border-color: var(--pp-primary-light, #fff1ec);
    background: var(--pp-primary-light, #fff1ec);
    color: var(--pp-primary-dark, #c73e18);
  }

  @media (max-width: 1100px) {
    .pp-clist__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .pp-clist__head {
      margin-bottom: 22px;
      padding: 20px 0 22px;
    }

    .pp-clist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 12px;
    }

    .pp-clist__info {
      padding-top: 10px;
    }

    .pp-clist__name {
      font-size: 14px;
    }

    .pp-clist__arrow {
      display: none;
    }

    .pp-clist__types {
      margin-top: 40px;
      padding-top: 28px;
    }

    .pp-clist__dept + .pp-clist__dept {
      margin-top: 32px;
      padding-top: 28px;
    }

    .pp-clist__dept-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-clist__media img,
    .pp-clist__arrow {
      transition: none;
    }

    .pp-clist__link:hover .pp-clist__media img {
      transform: none;
    }

    .pp-clist__link:hover .pp-clist__arrow {
      translate: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list (P&P)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse every collection in the Pretty & Practical range."
    },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Breadcrumb label",
      "default": "Collections"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Shop by category menu",
      "info": "Optional. A menu of collection links sets which collections show and their order. Nested items group the page by department. Leave empty to show every collection alphabetically."
    },
    {
      "type": "checkbox",
      "id": "show_types",
      "label": "Show product types",
      "default": true
    },
    {
      "type": "text",
      "id": "types_heading",
      "label": "Product types heading",
      "default": "Shop by product type"
    }
  ],
  "presets": [
    {
      "name": "Collection list (P&P)"
    }
  ]
}
{% endschema %}
