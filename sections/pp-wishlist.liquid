{{ 'pp-wishlist.css' | asset_url | stylesheet_tag }}
{{ 'pp-product-card.css' | asset_url | stylesheet_tag }}
{{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pp-wishlist-page.js' | asset_url }}" defer></script>

{%- liquid
  assign pp_wl_collection = section.settings.collection
  if pp_wl_collection == blank
    assign pp_wl_collection = collections.all
  endif
  assign pp_wl_shop_url = pp_wl_collection.url | default: routes.all_products_collection_url
-%}

<section class="pp-wishlist-page" data-pp-wishlist-page>
  <div class="pp-wrap">
    <div class="pp-wishlist-page__head">
      <nav class="pp-wishlist-page__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span class="pp-wishlist-page__crumb-current">Wishlist</span>
      </nav>
      <div class="pp-wishlist-page__title-row">
        <div class="pp-wishlist-page__title-group">
          <h1 class="pp-wishlist-page__title">{{ section.settings.heading | default: 'My Wishlist' }}</h1>
          <p class="pp-wishlist-page__sub" data-pp-wishlist-summary hidden></p>
        </div>
        <button type="button" class="pp-wishlist-page__clear" data-pp-wishlist-clear hidden>Clear all</button>
      </div>
    </div>

    <div class="pp-wishlist-page__grid pp-cards pp-cards--grid" data-pp-wishlist-grid aria-live="polite"></div>

    <div class="pp-wishlist-empty" data-pp-wishlist-empty hidden>
      <span class="pp-wishlist-empty__icon">{% render 'pp-icon-3d', icon: 'heart', uid: 'wishlist-empty' %}</span>
      <h2>Your wishlist is empty</h2>
      <p>Tap the heart on any product to save it here, then come back when you're ready.</p>
      <a href="{{ pp_wl_shop_url }}">Start shopping</a>
    </div>

    {%- if section.settings.show_products and pp_wl_collection.products_count > 0 -%}
      <div class="pp-wishlist-page__more" data-pp-wishlist-more>
        <div class="pp-wishlist-page__more-head">
          <h2>{{ section.settings.products_heading | default: 'You might also like' }}</h2>
          <a href="{{ pp_wl_shop_url }}">View all</a>
        </div>
        <div class="pp-cards pp-cards--grid" data-pp-wishlist-more-grid>
          {%- for product in pp_wl_collection.products limit: 8 -%}
            {% render 'pp-collection-product-card', product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Wishlist"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show products below the wishlist",
      "default": true
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products heading",
      "default": "You might also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products collection",
      "info": "Shows 4 products that aren't in the wishlist. Uses all products when empty."
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
