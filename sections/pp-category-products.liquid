{%- comment -%}
  "More from {collection}" row below the product reviews.

  Uses the most specific collection the product belongs to: of its
  collections (skipping the catch-all "all" and "frontpage"), the one with
  the fewest products that still has others to show. Up to 4 other products
  from it are rendered with the page. When no collection fits, the row is
  left out.
{%- endcomment -%}

{%- liquid
  assign more_collection = blank
  assign more_count = 0
  for candidate in product.collections
    if candidate.handle == 'all' or candidate.handle == 'frontpage'
      continue
    endif
    if candidate.all_products_count < 2
      continue
    endif
    if more_collection == blank or candidate.all_products_count < more_count
      assign more_collection = candidate
      assign more_count = candidate.all_products_count
    endif
  endfor
-%}

{%- if more_collection != blank -%}
  {%- liquid
    assign rendered_count = 0
    capture more_cards
      for more_product in more_collection.products limit: 12
        if more_product.id == product.id or rendered_count >= 4
          continue
        endif
        render 'pp-rec-card', card_product: more_product
        assign rendered_count = rendered_count | plus: 1
      endfor
    endcapture
  -%}

  {%- if rendered_count > 0 -%}
    {{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}
    {{ 'pp-product-card.css' | asset_url | stylesheet_tag }}
    <div class="pp-category-products" data-pp-category-products>
      <section class="pp-recommend" aria-labelledby="category-products-heading-{{ section.id }}">
        <div class="pp-section-head">
          <div class="pp-section-head__text">
            <h2 id="category-products-heading-{{ section.id }}">More from {{ more_collection.title | escape }}</h2>
            <p class="pp-section-head__sub">Explore more in this range</p>
          </div>
          <a class="pp-view-all" href="{{ more_collection.url }}">
            View all
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
        <div class="pp-recommend__grid pp-cards pp-cards--grid">
          {{ more_cards }}
        </div>
      </section>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "More from collection",
  "settings": [],
  "presets": []
}
{% endschema %}
