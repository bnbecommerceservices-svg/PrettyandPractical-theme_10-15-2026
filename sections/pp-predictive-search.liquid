{%- if predictive_search.performed -%}
  {% assign total_results = predictive_search.resources.products.size | plus: predictive_search.resources.collections.size | plus: predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size %}
  {% assign query_suggestions_count = predictive_search.resources.queries.size %}
  {% assign has_display_results = false %}
  {% if total_results > 0 %}
    {% assign has_display_results = true %}
  {% elsif query_suggestions_count > 0 %}
    {% assign has_display_results = true %}
  {% endif %}

  {% assign single_result_url = blank %}
  {% if total_results == 1 %}
    {% if predictive_search.resources.products.size == 1 %}
      {% assign single_result_product = predictive_search.resources.products | first %}
      {% assign single_result_url = single_result_product.url %}
    {% elsif predictive_search.resources.collections.size == 1 %}
      {% assign single_result_collection = predictive_search.resources.collections | first %}
      {% assign single_result_url = single_result_collection.url %}
    {% elsif predictive_search.resources.pages.size == 1 %}
      {% assign single_result_page = predictive_search.resources.pages | first %}
      {% assign single_result_url = single_result_page.url %}
    {% elsif predictive_search.resources.articles.size == 1 %}
      {% assign single_result_article = predictive_search.resources.articles | first %}
      {% assign single_result_url = single_result_article.url %}
    {% endif %}
  {% endif %}

  <div id="predictive-search-results" role="listbox" aria-label="{{ 'content.search_results_label' | t }}" data-search-results>
    <div class="visually-hidden" role="status">
      {%- if total_results > 0 -%}
        {{ 'accessibility.search_results_count' | t: count: total_results, query: predictive_search.terms }}
      {%- elsif query_suggestions_count > 0 -%}
        {{ 'accessibility.search_suggestions_available' | t: query: predictive_search.terms }}
      {%- else -%}
        {{ 'accessibility.search_results_no_results' | t: query: predictive_search.terms }}
      {%- endif -%}
    </div>

    {% if has_display_results %}
      <div class="pp-dropdown-section">
        <p class="pp-dropdown-label">Results</p>
        <ul class="pp-results" role="presentation">
          {% assign rendered_results = 0 %}

          {% for resource in predictive_search.resources.queries %}
            {% if rendered_results >= 6 %}
              {% break %}
            {% endif %}
            {% assign rendered_results = rendered_results | plus: 1 %}
            <li ref="resultsItems[]" on:keydown="/onSearchKeyDown">
              <a class="pp-result" href="{{ resource.url }}" role="option" aria-label="{{ resource.text | escape }}">
                <span class="pp-result-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </span>
                <span class="pp-result-text">
                  <span class="pp-result-name">{{ resource.styled_text }}</span>
                  <span class="pp-result-cat">in Search suggestion</span>
                </span>
                <span class="pp-result-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                    <path d="M9 14l-4-4 4-4"></path>
                    <path d="M5 10h9a4 4 0 1 1 0 8h-2"></path>
                  </svg>
                </span>
              </a>
            </li>
          {% endfor %}

          {% for resource in predictive_search.resources.products %}
            {% if rendered_results >= 6 %}
              {% break %}
            {% endif %}
            {% assign resource_category = resource.type | strip %}
            {% if resource_category == blank %}
              {% assign resource_category = resource.vendor | strip %}
            {% endif %}
            {% if resource_category == blank %}
              {% assign resource_category = 'Product' %}
            {% endif %}
            {% assign rendered_results = rendered_results | plus: 1 %}
            <li ref="resultsItems[]" on:keydown="/onSearchKeyDown">
              <a class="pp-result" href="{{ resource.url }}" role="option" aria-label="{{ resource.title | escape }}">
                <span class="pp-result-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </span>
                <span class="pp-result-text">
                  <span class="pp-result-name">{{ resource.title | highlight: predictive_search.terms }}</span>
                  <span class="pp-result-cat">in {{ resource_category | escape }}</span>
                </span>
                <span class="pp-result-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                    <path d="M9 14l-4-4 4-4"></path>
                    <path d="M5 10h9a4 4 0 1 1 0 8h-2"></path>
                  </svg>
                </span>
              </a>
            </li>
          {% endfor %}

          {% for resource in predictive_search.resources.collections %}
            {% if rendered_results >= 6 %}
              {% break %}
            {% endif %}
            {% assign rendered_results = rendered_results | plus: 1 %}
            <li ref="resultsItems[]" on:keydown="/onSearchKeyDown">
              <a class="pp-result" href="{{ resource.url }}" role="option" aria-label="{{ resource.title | escape }}">
                <span class="pp-result-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </span>
                <span class="pp-result-text">
                  <span class="pp-result-name">{{ resource.title | highlight: predictive_search.terms }}</span>
                  <span class="pp-result-cat">in Collection</span>
                </span>
                <span class="pp-result-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                    <path d="M9 14l-4-4 4-4"></path>
                    <path d="M5 10h9a4 4 0 1 1 0 8h-2"></path>
                  </svg>
                </span>
              </a>
            </li>
          {% endfor %}

          {% for resource in predictive_search.resources.pages %}
            {% if rendered_results >= 6 %}
              {% break %}
            {% endif %}
            {% assign rendered_results = rendered_results | plus: 1 %}
            <li ref="resultsItems[]" on:keydown="/onSearchKeyDown">
              <a class="pp-result" href="{{ resource.url }}" role="option" aria-label="{{ resource.title | escape }}">
                <span class="pp-result-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </span>
                <span class="pp-result-text">
                  <span class="pp-result-name">{{ resource.title | highlight: predictive_search.terms }}</span>
                  <span class="pp-result-cat">in Page</span>
                </span>
                <span class="pp-result-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                    <path d="M9 14l-4-4 4-4"></path>
                    <path d="M5 10h9a4 4 0 1 1 0 8h-2"></path>
                  </svg>
                </span>
              </a>
            </li>
          {% endfor %}

          {% for resource in predictive_search.resources.articles %}
            {% if rendered_results >= 6 %}
              {% break %}
            {% endif %}
            {% assign rendered_results = rendered_results | plus: 1 %}
            <li ref="resultsItems[]" on:keydown="/onSearchKeyDown">
              <a class="pp-result" href="{{ resource.url }}" role="option" aria-label="{{ resource.title | escape }}">
                <span class="pp-result-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </span>
                <span class="pp-result-text">
                  <span class="pp-result-name">{{ resource.title | highlight: predictive_search.terms }}</span>
                  <span class="pp-result-cat">in Article</span>
                </span>
                <span class="pp-result-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                    <path d="M9 14l-4-4 4-4"></path>
                    <path d="M5 10h9a4 4 0 1 1 0 8h-2"></path>
                  </svg>
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      {% if single_result_url != blank %}
        <div data-single-result-url="{{ single_result_url }}"></div>
      {% endif %}
    {% else %}
      <div class="pp-no-results">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        <p class="pp-no-results-title">No matches for "<strong>{{ predictive_search.terms | escape }}</strong>"</p>
        <p class="pp-no-results-subtext">Try a different keyword or browse all categories.</p>
      </div>
    {% endif %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PP predictive search",
  "settings": [],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
