{% javascript %}
  (function () {
    'use strict';

    var root = document.querySelector('[data-pp-search-page]');
    if (!root) return;

    var currentUrl = new URL(window.location.href);
    var currentTypes = currentUrl.searchParams.get('type');
    if (currentTypes !== 'product') {
      currentUrl.searchParams.set('type', 'product');
      window.location.replace(currentUrl.toString());
      return;
    }

    document.addEventListener('click', function (e) {
      var toggle = e.target.closest('[data-group-toggle]');
      if (!toggle || !root.contains(toggle)) return;

      var section = toggle.closest('.pp-filtergroup');
      if (!section) return;

      section.classList.toggle('is-collapsed');
      var expanded = !section.classList.contains('is-collapsed');
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    });

    var sortEl = root.querySelector('[data-sort]');
    var sortBtn = root.querySelector('[data-sort-btn]');
    var sortCurrent = root.querySelector('[data-sort-current]');
    var sortForm = sortEl ? sortEl.closest('form') : null;
    var sortInput = sortForm ? sortForm.querySelector('[data-sort-input]') : null;

    if (sortEl && sortBtn) {
      sortBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = sortEl.classList.toggle('is-open');
        sortBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      document.addEventListener('click', function (e) {
        var opt = e.target.closest('[data-sort-option]');
        if (opt && root.contains(opt)) {
          e.preventDefault();
          var nextSortValue = opt.getAttribute('data-sort-option') || '';
          if (!nextSortValue) {
            sortEl.classList.remove('is-open');
            sortBtn.setAttribute('aria-expanded', 'false');
            return;
          }

          sortEl.querySelectorAll('[data-sort-option]').forEach(function (o) {
            o.classList.remove('is-active');
            o.setAttribute('aria-selected', 'false');
          });

          opt.classList.add('is-active');
          opt.setAttribute('aria-selected', 'true');

          var label = (opt.childNodes[0] && opt.childNodes[0].nodeValue)
            ? opt.childNodes[0].nodeValue.trim()
            : opt.textContent.trim();

          if (sortCurrent) sortCurrent.textContent = label;

          sortEl.classList.remove('is-open');
          sortBtn.setAttribute('aria-expanded', 'false');

          if (sortInput) {
            sortInput.value = nextSortValue;
          }

          if (sortForm && sortInput && sortInput.value) {
            sortForm.submit();
          }
          return;
        }

        if (!e.target.closest('[data-sort]')) {
          sortEl.classList.remove('is-open');
          sortBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    var drawer = document.getElementById('filter-drawer');
    var overlay = document.querySelector('[data-overlay]');

    function openDrawer() {
      if (!drawer || !overlay) return;
      var drawerBody = drawer.querySelector('.pp-drawer__body');
      if (drawerBody) drawerBody.scrollTop = 0;
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.classList.add('is-locked');
    }

    function closeDrawer() {
      if (!drawer || !overlay) return;
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('is-locked');
    }

    document.querySelectorAll('[data-open-drawer]').forEach(function (button) {
      button.addEventListener('click', openDrawer);
    });

    document.querySelectorAll('[data-close-drawer]').forEach(function (button) {
      button.addEventListener('click', closeDrawer);
    });

    if (overlay) overlay.addEventListener('click', closeDrawer);

    var wishlistStorageKey = 'pp-collection-wishlist';

    function readWishlist() {
      try {
        return JSON.parse(window.localStorage.getItem(wishlistStorageKey) || '[]');
      } catch (error) {
        return [];
      }
    }

    function writeWishlist(items) {
      window.localStorage.setItem(wishlistStorageKey, JSON.stringify(items));
    }

    var wishlistItems = new Set(readWishlist());

    document.querySelectorAll('[data-pp-wishlist], [data-wishlist]').forEach(function (button) {
      if (!(button instanceof HTMLButtonElement)) return;

      var productId = button.dataset.productId;
      if (!productId) return;

      button.classList.toggle('is-active', wishlistItems.has(productId));

      button.addEventListener('click', function () {
        if (wishlistItems.has(productId)) {
          wishlistItems.delete(productId);
          button.classList.remove('is-active');
        } else {
          wishlistItems.add(productId);
          button.classList.add('is-active');
          button.classList.add('pulse');
          window.setTimeout(function () {
            button.classList.remove('pulse');
          }, 250);
        }

        writeWishlist(Array.from(wishlistItems));
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;

      if (drawer && drawer.classList.contains('is-open')) closeDrawer();

      if (sortEl && sortEl.classList.contains('is-open')) {
        sortEl.classList.remove('is-open');
        if (sortBtn) sortBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }());
{% endjavascript %}

