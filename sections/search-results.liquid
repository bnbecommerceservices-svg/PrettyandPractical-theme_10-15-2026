{% liquid
  assign products_per_page = section.settings.products_per_page | default: 24
  assign current_sort = search.sort_by | default: search.default_sort_by
  assign search_terms = search.terms | default: ''
  assign search_terms_escaped = search_terms | escape
  assign search_terms_query = search_terms | url_encode
  assign clear_url = routes.search_url | append: '?type=product&q=' | append: search_terms_query
  assign total_active_values = 0
  assign current_sort_label = 'Relevance'
  assign current_sort_key = 'relevance'
  assign sort_relevance_value = blank
  assign sort_best_value = blank
  assign sort_price_asc_value = blank
  assign sort_price_desc_value = blank
  assign sort_newest_value = blank
  assign sort_rating_value = blank
  assign support_url = section.settings.support_page.url | default: pages['contact'].url | default: pages['contact-us'].url | default: '/pages/contact'
  assign browse_menu = section.settings.empty_state_menu
  assign browse_links = blank

  if browse_menu != blank
    assign browse_links = browse_menu.links
  elsif linklists['main-menu'] != blank
    assign browse_links = linklists['main-menu'].links
  elsif linklists['main-menu-2'] != blank
    assign browse_links = linklists['main-menu-2'].links
  endif

  if current_sort != blank and current_sort != search.default_sort_by
    assign clear_url = clear_url | append: '&sort_by=' | append: current_sort
  endif

  for filter in search.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign total_active_values = total_active_values | plus: 1
        endif
      else
        assign total_active_values = total_active_values | plus: filter.active_values.size
    endcase
  endfor

  for option in search.sort_options
    assign option_name_downcase = option.name | strip | downcase

    case option.value
      when search.default_sort_by, 'relevance'
        assign sort_relevance_value = option.value
      when 'best-selling'
        assign sort_best_value = option.value
      when 'price-ascending'
        assign sort_price_asc_value = option.value
      when 'price-descending'
        assign sort_price_desc_value = option.value
      when 'created-descending'
        assign sort_newest_value = option.value
    endcase

    if option_name_downcase contains 'rating'
      assign sort_rating_value = option.value
    endif

    if option.value == current_sort
      case option.value
        when search.default_sort_by, 'relevance'
          assign current_sort_key = 'relevance'
        when 'best-selling'
          assign current_sort_key = 'best'
        when 'price-ascending'
          assign current_sort_key = 'price-asc'
        when 'price-descending'
          assign current_sort_key = 'price-desc'
        when 'created-descending'
          assign current_sort_key = 'newest'
        else
          if option_name_downcase contains 'rating'
            assign current_sort_key = 'rating'
          endif
      endcase
    endif
  endfor

  if sort_relevance_value == blank
    assign sort_relevance_value = search.default_sort_by | default: 'relevance'
  endif

  case current_sort_key
    when 'relevance'
      assign current_sort_label = 'Relevance'
    when 'best'
      assign current_sort_label = 'Best selling'
    when 'price-asc'
      assign current_sort_label = 'Price: Low to high'
    when 'price-desc'
      assign current_sort_label = 'Price: High to low'
    when 'newest'
      assign current_sort_label = 'Newest'
    when 'rating'
      assign current_sort_label = 'Rating'
  endcase

  capture active_filter_inputs
    for filter in search.filters
      if filter.type == 'price_range'
        if filter.min_value.value != null
          echo '<input type="hidden" name="'
          echo filter.min_value.param_name
          echo '" value="'
          echo filter.min_value.value | money_without_currency | escape
          echo '">'
        endif
        if filter.max_value.value != null
          echo '<input type="hidden" name="'
          echo filter.max_value.param_name
          echo '" value="'
          echo filter.max_value.value | money_without_currency | escape
          echo '">'
        endif
      else
        for value in filter.active_values
          echo '<input type="hidden" name="'
          echo value.param_name
          echo '" value="'
          echo value.value | escape
          echo '">'
        endfor
      endif
    endfor
  endcapture
%}

{{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}

{% paginate search.results by products_per_page %}
  {% liquid
    assign product_results = search.results | where: 'object_type', 'product'
    assign total_results = paginate.items
    assign shown_results = paginate.current_offset | plus: product_results.size
    assign show_chips = false
    assign is_empty = false

    if total_active_values > 0
      assign show_chips = true
    endif

    if search.performed and total_results == 0
      assign is_empty = true
    endif
  %}

  <div data-pp-search-page>
    <main id="main">
      <section class="pp-search-head" aria-labelledby="search-title">
        <div class="pp-wrap">
          <nav class="pp-breadcrumb" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span class="pp-breadcrumb__current" aria-current="page">Search</span>
          </nav>

          <h1 id="search-title" class="pp-search-title">Results for &ldquo;{{ search_terms_escaped }}&rdquo;</h1>
          <p class="pp-search-count"><strong>{{ total_results }}</strong> results</p>
        </div>
      </section>

      <section class="pp-toolbar" aria-label="Filters and sort">
        <div class="pp-wrap">
          <div class="pp-toolbar__row">
            <div class="pp-toolbar__left">
              <button type="button" class="pp-filterbtn" data-open-drawer aria-label="Open filters" aria-controls="filter-drawer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="4" y1="6" x2="20" y2="6"></line>
                  <line x1="7" y1="12" x2="17" y2="12"></line>
                  <line x1="10" y1="18" x2="14" y2="18"></line>
                </svg>
                Filters
                <span class="pp-filterbtn__count" data-filterbtn-count{% if total_active_values == 0 %} hidden{% endif %}>{{ total_active_values }}</span>
              </button>
            </div>

            <div class="pp-toolbar__right">
              <form method="get" action="{{ routes.search_url }}">
                <input type="hidden" name="type" value="product">
                <input type="hidden" name="q" value="{{ search_terms_escaped }}">
                {{ active_filter_inputs }}
                <input type="hidden" name="sort_by" value="{{ current_sort }}" data-sort-input>
                <div class="pp-sort" data-sort>
                  <button type="button" class="pp-sort__btn" data-sort-btn aria-haspopup="listbox" aria-expanded="false">
                    <span class="pp-sort__label-key">Sort:</span>
                    <span class="pp-sort__label-val" data-sort-current>{{ current_sort_label }}</span>
                    <svg class="pp-sort__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div class="pp-sort__menu" role="listbox" aria-label="Sort options">
                    <button type="button" class="pp-sort__option{% if current_sort_key == 'relevance' %} is-active{% endif %}" data-sort-option="{{ sort_relevance_value }}" role="option" aria-selected="{% if current_sort_key == 'relevance' %}true{% else %}false{% endif %}">Relevance <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                    <button type="button" class="pp-sort__option{% if current_sort_key == 'best' %} is-active{% endif %}" data-sort-option="{{ sort_best_value }}" role="option" aria-selected="{% if current_sort_key == 'best' %}true{% else %}false{% endif %}">Best selling <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                    <button type="button" class="pp-sort__option{% if current_sort_key == 'price-asc' %} is-active{% endif %}" data-sort-option="{{ sort_price_asc_value }}" role="option" aria-selected="{% if current_sort_key == 'price-asc' %}true{% else %}false{% endif %}">Price: Low to high <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                    <button type="button" class="pp-sort__option{% if current_sort_key == 'price-desc' %} is-active{% endif %}" data-sort-option="{{ sort_price_desc_value }}" role="option" aria-selected="{% if current_sort_key == 'price-desc' %}true{% else %}false{% endif %}">Price: High to low <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                    <button type="button" class="pp-sort__option{% if current_sort_key == 'newest' %} is-active{% endif %}" data-sort-option="{{ sort_newest_value }}" role="option" aria-selected="{% if current_sort_key == 'newest' %}true{% else %}false{% endif %}">Newest <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                    <button type="button" class="pp-sort__option{% if current_sort_key == 'rating' %} is-active{% endif %}" data-sort-option="{{ sort_rating_value }}" role="option" aria-selected="{% if current_sort_key == 'rating' %}true{% else %}false{% endif %}">Rating <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <div class="pp-chips{% if show_chips %} is-visible{% endif %}" data-chips aria-label="Active filters">
            {% for filter in search.filters %}
              {% if filter.type == 'price_range' %}
                {% if filter.min_value.value != null or filter.max_value.value != null %}
                  <a href="{{ filter.url_to_remove }}" class="pp-chip">
                    {% if filter.min_value.value != null and filter.max_value.value != null %}
                      {{ filter.min_value.value | money_without_trailing_zeros }} - {{ filter.max_value.value | money_without_trailing_zeros }}
                    {% elsif filter.min_value.value != null %}
                      From {{ filter.min_value.value | money_without_trailing_zeros }}
                    {% else %}
                      Up to {{ filter.max_value.value | money_without_trailing_zeros }}
                    {% endif %}
                    <span class="pp-chip__x" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </span>
                  </a>
                {% endif %}
              {% else %}
                {% for value in filter.active_values %}
                  <a href="{{ value.url_to_remove }}" class="pp-chip">
                    {{ value.label }}
                    <span class="pp-chip__x" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </span>
                  </a>
                {% endfor %}
              {% endif %}
            {% endfor %}
            {% if show_chips %}
              <a href="{{ clear_url }}" class="pp-chips__clear">Clear all</a>
            {% endif %}
          </div>
        </div>
      </section>

      <section class="pp-search-main">
        <div class="pp-wrap">
          <div class="pp-search-layout{% if is_empty %} is-empty{% endif %}" id="search-layout">
            <form method="get" action="{{ routes.search_url }}">
              <input type="hidden" name="type" value="product">
              <input type="hidden" name="q" value="{{ search_terms_escaped }}">
              {% if current_sort != blank %}
                <input type="hidden" name="sort_by" value="{{ current_sort }}">
              {% endif %}
              <aside class="pp-sidebar" aria-label="Refine results" id="sidebar-filters">
                {% for filter in search.filters %}
                  {% assign normalized_filter_label = filter.label | strip | downcase %}
                  <section class="pp-filtergroup" data-filter-group data-filter-group-section="{{ filter.param_name | default: filter.label | handle }}">
                    <button type="button" class="pp-filtergroup__head" data-group-toggle aria-expanded="true">
                      <span>{{ filter.label }}</span>
                      <svg class="pp-filtergroup__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </button>
                    <div class="pp-filtergroup__body">
                      {% if filter.type == 'price_range' %}
                        <div class="pp-fprice">
                          <div class="pp-fprice__field">
                            <label for="DesktopMin-{{ section.id }}-{{ forloop.index }}">Min</label>
                            <input
                              id="DesktopMin-{{ section.id }}-{{ forloop.index }}"
                              type="number"
                              inputmode="decimal"
                              name="{{ filter.min_value.param_name }}"
                              value="{% if filter.min_value.value != null %}{{ filter.min_value.value | money_without_currency }}{% endif %}"
                              placeholder="0"
                              min="0"
                              max="{{ filter.range_max | money_without_currency }}"
                              autocomplete="off"
                            >
                          </div>
                          <span class="pp-fprice__sep">&ndash;</span>
                          <div class="pp-fprice__field">
                            <label for="DesktopMax-{{ section.id }}-{{ forloop.index }}">Max</label>
                            <input
                              id="DesktopMax-{{ section.id }}-{{ forloop.index }}"
                              type="number"
                              inputmode="decimal"
                              name="{{ filter.max_value.param_name }}"
                              value="{% if filter.max_value.value != null %}{{ filter.max_value.value | money_without_currency }}{% endif %}"
                              placeholder="{{ filter.range_max | money_without_currency }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency }}"
                              autocomplete="off"
                            >
                          </div>
                        </div>
                        <div class="pp-fprice__presets">
                          <button type="submit" class="pp-fprice__preset">Apply</button>
                        </div>
                      {% elsif filter.presentation == 'swatch' or normalized_filter_label == 'color' or normalized_filter_label == 'colour' %}
                        <div class="pp-fcolors">
                          {% for value in filter.values %}
                            {% liquid
                              assign swatch_background = blank
                              if value.swatch.image != blank
                                assign swatch_background = value.swatch.image | image_url: width: 64
                              elsif value.swatch.color != blank
                                assign swatch_background = value.swatch.color
                              endif
                            %}
                            <label
                              class="pp-fcolor{% if value.active %} is-active{% endif %}"
                              {% if swatch_background contains 'http' %}
                                style="background-image:url('{{ swatch_background }}'); background-size:cover; background-position:center;"
                              {% elsif swatch_background != blank %}
                                style="background: {{ swatch_background }};"
                              {% endif %}
                            >
                              <span class="pp-fcolor__tip">{{ value.label }}</span>
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                onchange="this.form.submit()"
                                {% if value.active %}
                                  checked
                                {% endif %}
                                {% if value.count == 0 and value.active == false %}
                                  disabled
                                {% endif %}
                              >
                            </label>
                          {% endfor %}
                        </div>
                      {% else %}
                        <ul class="pp-fopts">
                          {% for value in filter.values %}
                            <li>
                              <label class="pp-fopt">
                                <input
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  onchange="this.form.submit()"
                                  {% if value.active %}
                                    checked
                                  {% endif %}
                                {% if value.count == 0 and value.active == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="pp-fopt__box">
                                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                  </svg>
                                </span>
                                <span class="pp-fopt__label">
                                  {% if normalized_filter_label == 'rating' and value.label != blank %}
                                    {% assign rating_label_value = value.label | plus: 0 %}
                                    <span class="pp-frating-stars" aria-hidden="true">
                                      {% for star_index in (1..5) %}
                                        <svg{% if star_index > rating_label_value %} class="dim"{% endif %} viewBox="0 0 20 20">
                                          <path d="M10.4552 0.846855C10.3119 0.384382 9.68806 0.384382 9.54477 0.846855L7.63027 7.02616C7.56619 7.23298 7.38241 7.37301 7.17504 7.37301H0.979572C0.515888 7.37301 0.323098 7.99527 0.698226 8.28109L5.71047 12.1001C5.87823 12.2279 5.94843 12.4545 5.88435 12.6613L3.96984 18.8406C3.82656 19.3031 4.33129 19.6877 4.70642 19.4019L9.71865 15.5828C9.88642 15.455 10.1136 15.455 10.2813 15.5828L15.2936 19.4019C15.6687 19.6877 16.1734 19.3031 16.0302 18.8406L14.1157 12.6613C14.0516 12.4545 14.1218 12.2279 14.2895 12.1001L19.3018 8.28109C19.6769 7.99527 19.4841 7.37301 19.0204 7.37301H12.825C12.6176 7.37301 12.4338 7.23298 12.3697 7.02616L10.4552 0.846855Z"></path>
                                        </svg>
                                      {% endfor %}
                                    </span>
                                    <span class="pp-frating-amp">&amp; up</span>
                                  {% else %}
                                    {{ value.label }}
                                  {% endif %}
                                </span>
                                <span class="pp-fopt__count">{{ value.count }}</span>
                              </label>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                  </section>
                {% endfor %}
              </aside>
            </form>

            <div>
              <div class="pp-grid" id="product-grid" aria-label="Search results for {{ search_terms_escaped }}">
                {% for product in product_results %}
                  {% liquid
                    assign selected_variant = product.selected_or_first_available_variant
                    assign featured_image = product.featured_media.preview_image | default: product.featured_image
                    assign current_price = selected_variant.price | default: product.price
                    assign compare_at_price = selected_variant.compare_at_price | default: product.compare_at_price
                    assign save_amount = 0
                    if compare_at_price > current_price
                      assign save_amount = compare_at_price | minus: current_price
                    endif
                    assign review_rating_object = product.metafields.reviews.rating.value
                    assign review_rating = review_rating_object.rating
                    assign review_scale = review_rating_object.scale_max | default: 5
                    assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
                    assign show_rating = false
                    if review_rating != blank and review_count != blank and review_count > 0
                      assign show_rating = true
                    endif
                    assign has_sale = false
                    assign has_new_tag = false
                    assign has_bestseller_tag = false
                    capture pp_promo
                      render 'pp-product-promo', product: product, price: current_price, compare_at: compare_at_price
                    endcapture
                    assign pp_promo = pp_promo | strip
                    if pp_promo contains '|sale'
                      assign has_sale = true
                    endif
                    if pp_promo contains '|new'
                      assign has_new_tag = true
                    endif
                    if pp_promo contains '|bestseller'
                      assign has_bestseller_tag = true
                    endif
                    unless has_sale
                      assign save_amount = 0
                    endunless
                    assign can_quick_add = false
                    if product.available and product.variants.size == 1 and selected_variant.available
                      assign can_quick_add = true
                    endif
                    assign quick_add_form_id = 'PPSearchQuickAdd-' | append: section.id | append: '-' | append: product.id
                    assign quick_add_body_form_id = quick_add_form_id | append: '-body'
                  %}

                  <article class="pp-card">
                    <div class="pp-card__image">
                      <div class="pp-card__badges">
                        {% if has_sale %}
                          <span class="pp-pill pp-pill--sale">Sale</span>
                        {% endif %}
                        {% if has_new_tag %}
                          <span class="pp-pill pp-pill--new">New</span>
                        {% endif %}
                        {% if has_bestseller_tag %}
                          <span class="pp-pill pp-pill--bestseller">Bestseller</span>
                        {% endif %}
                      </div>

                      <button type="button" class="pp-wishlist" aria-label="Add {{ product.title | escape }} to wishlist" data-wishlist data-pp-wishlist data-product-id="{{ product.id }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                      </button>

                      <a href="{{ product.url }}" class="pp-card__image-inner" aria-label="{{ product.title | escape }}">
                        {% if featured_image != blank %}
                          {{
                            featured_image
                            | image_url: width: 900
                            | image_tag:
                              widths: '320, 480, 512, 640, 900, 1200',
                              sizes: '(min-width: 1101px) 512px, (min-width: 769px) min(45vw, 512px), 100vw',
                              alt: product.title,
                              loading: 'lazy'
                          }}
                        {% else %}
                          <div class="pp-card__placeholder">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
                              <circle cx="9" cy="10" r="1.25"></circle>
                              <path d="M7 16l4.25-4.25a1 1 0 0 1 1.41 0L17 16"></path>
                            </svg>
                            <span>No image available</span>
                          </div>
                        {% endif %}
                      </a>

                      {% if can_quick_add %}
                        <product-form-component
                          data-section-id="{{ section.id }}"
                          data-product-id="{{ product.id }}"
                          on:submit="/handleSubmit"
                          class="pp-card__quickadd-form"
                        >
                          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                          {%- form 'product', product, id: quick_add_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                            <input
                              type="hidden"
                              name="id"
                              ref="variantId"
                              value="{{ selected_variant.id }}"
                              {% unless selected_variant.available %}
                                disabled
                              {% endunless %}
                            >
                            <input type="hidden" name="quantity" value="1">
                            {% assign pp_search_add_to_cart_text = 'actions.add_to_cart' | t %}
                            {% render 'add-to-cart-button',
                              can_add_to_cart: selected_variant.available,
                              add_to_cart_text: pp_search_add_to_cart_text,
                              product: product,
                              class: 'pp-quickadd'
                            %}
                          {%- endform -%}
                        </product-form-component>
                      {% endif %}
                    </div>

                    <div class="pp-card__body">
                      <a href="{{ product.url }}" class="pp-card__title">{{ product.title }}</a>

                      <div class="pp-card__rating">
                        {% render 'pp-judgeme-badge', product: product %}
                      </div>

                      <div class="pp-card__price">
                        <span class="pp-price{% if has_sale %} pp-price--sale{% endif %}">{{ current_price | money }}</span>
                        {% if has_sale %}
                          <span class="pp-price__was">{{ compare_at_price | money }}</span>
                          <span class="pp-price__save">Save {{ save_amount | money }}</span>
                        {% endif %}
                      </div>
                      <div class="pp-card__cta">
                        {% if product.available == false %}
                          <span class="pp-card-cta pp-card-cta--soldout">Sold out</span>
                        {% elsif can_quick_add %}
                          <product-form-component
                            data-section-id="{{ section.id }}"
                            data-product-id="{{ product.id }}"
                            on:submit="/handleSubmit"
                            class="pp-card__quickadd-form pp-card__quickadd-form--body"
                          >
                            <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                            {%- form 'product', product, id: quick_add_body_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                              <input type="hidden" name="id" ref="variantId" value="{{ selected_variant.id }}">
                              <input type="hidden" name="quantity" value="1">
                              {% render 'add-to-cart-button', can_add_to_cart: selected_variant.available, add_to_cart_text: 'Add to cart', product: product, class: 'pp-card-cta' %}
                            {%- endform -%}
                          </product-form-component>
                        {% else %}
                          <a href="{{ product.url }}" class="pp-card-cta">Choose options</a>
                        {% endif %}
                      </div>
                    </div>
                  </article>
                {% endfor %}
              </div>

              <div class="pp-empty-state" role="region" aria-labelledby="empty-title">
                <svg class="pp-empty-state__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
                  <line x1="8.5" y1="8.5" x2="13.5" y2="13.5"></line>
                  <line x1="13.5" y1="8.5" x2="8.5" y2="13.5"></line>
                </svg>
                <h2 id="empty-title" class="pp-empty-state__title">No results for &ldquo;{{ search_terms_escaped }}&rdquo;</h2>
                <p class="pp-empty-state__text">We couldn't find anything matching your search. Try checking spelling or browse by category below.</p>

                <div class="pp-empty-state__browse-label">Browse categories</div>
                <div class="pp-empty-state__pills">
                  {% if browse_links != blank %}
                    {% for link in browse_links limit: 12 %}
                      <a href="{{ link.url }}" class="pp-empty-state__pill">{{ link.title }}</a>
                    {% endfor %}
                  {% endif %}
                </div>
                <a href="{{ support_url }}" class="pp-empty-state__support">Or contact support &rarr;</a>
              </div>

              {% if total_results > 0 %}
                <nav class="pp-pagination" aria-label="Pagination">
                  <div class="pp-pagination__count">Showing {{ shown_results }} of {{ total_results }}</div>
                  <div class="pp-pagination__pages">
                    {% if paginate.previous %}
                      <a href="{{ paginate.previous.url }}" class="pp-page pp-page--arrow" aria-label="Previous page">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      </a>
                    {% else %}
                      <span class="pp-page pp-page--arrow is-disabled" aria-label="Previous page" aria-disabled="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      </span>
                    {% endif %}

                    {% for part in paginate.parts %}
                      {% if part.is_link %}
                        <a href="{{ part.url }}" class="pp-page">{{ part.title }}</a>
                      {% else %}
                        {% if part.title == '&hellip;' %}
                          <span class="pp-page" aria-hidden="true">&hellip;</span>
                        {% else %}
                          <span class="pp-page is-current" aria-current="page">{{ part.title }}</span>
                        {% endif %}
                      {% endif %}
                    {% endfor %}

                    {% if paginate.parts == blank %}
                      <span class="pp-page is-current" aria-current="page">1</span>
                    {% endif %}

                    {% if paginate.next %}
                      <a href="{{ paginate.next.url }}" class="pp-page pp-page--arrow" aria-label="Next page">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                    {% else %}
                      <span class="pp-page pp-page--arrow is-disabled" aria-label="Next page" aria-disabled="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </span>
                    {% endif %}
                  </div>
                  <div class="pp-pagination__spacer" aria-hidden="true"></div>
                </nav>
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    </main>

    <div class="pp-overlay" data-overlay aria-hidden="true"></div>
    <aside class="pp-drawer" id="filter-drawer" aria-label="Filter drawer" aria-hidden="true">
      <div class="pp-drawer__head">
        <div class="pp-drawer__title">Filters</div>
        <button type="button" class="pp-drawer__close" data-close-drawer aria-label="Close filters">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <form method="get" action="{{ routes.search_url }}">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="q" value="{{ search_terms_escaped }}">
        {% if current_sort != blank %}
          <input type="hidden" name="sort_by" value="{{ current_sort }}">
        {% endif %}
        <div class="pp-drawer__body" id="drawer-filters">
          {% for filter in search.filters %}
            {% assign normalized_filter_label = filter.label | strip | downcase %}
            <section class="pp-filtergroup is-collapsed" data-filter-group-section="{{ filter.param_name | default: filter.label | handle }}">
              <button type="button" class="pp-filtergroup__head" data-group-toggle aria-expanded="false">
                <span>{{ filter.label }}</span>
                <svg class="pp-filtergroup__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="pp-filtergroup__body">
                {% if filter.type == 'price_range' %}
                  <div class="pp-fprice">
                    <div class="pp-fprice__field">
                      <label for="DrawerMin-{{ section.id }}-{{ forloop.index }}">Min</label>
                      <input
                        id="DrawerMin-{{ section.id }}-{{ forloop.index }}"
                        type="number"
                        inputmode="decimal"
                        name="{{ filter.min_value.param_name }}"
                        value="{% if filter.min_value.value != null %}{{ filter.min_value.value | money_without_currency }}{% endif %}"
                        placeholder="0"
                        min="0"
                        max="{{ filter.range_max | money_without_currency }}"
                        autocomplete="off"
                      >
                    </div>
                    <span class="pp-fprice__sep">&ndash;</span>
                    <div class="pp-fprice__field">
                      <label for="DrawerMax-{{ section.id }}-{{ forloop.index }}">Max</label>
                      <input
                        id="DrawerMax-{{ section.id }}-{{ forloop.index }}"
                        type="number"
                        inputmode="decimal"
                        name="{{ filter.max_value.param_name }}"
                        value="{% if filter.max_value.value != null %}{{ filter.max_value.value | money_without_currency }}{% endif %}"
                        placeholder="{{ filter.range_max | money_without_currency }}"
                        min="0"
                        max="{{ filter.range_max | money_without_currency }}"
                        autocomplete="off"
                      >
                    </div>
                  </div>
                  <div class="pp-fprice__presets">
                    <button type="submit" class="pp-fprice__preset">Apply</button>
                  </div>
                {% elsif filter.presentation == 'swatch' or normalized_filter_label == 'color' or normalized_filter_label == 'colour' %}
                  <div class="pp-fcolors">
                    {% for value in filter.values %}
                      {% liquid
                        assign swatch_background = blank
                        if value.swatch.image != blank
                          assign swatch_background = value.swatch.image | image_url: width: 64
                        elsif value.swatch.color != blank
                          assign swatch_background = value.swatch.color
                        endif
                      %}
                      <label
                        class="pp-fcolor{% if value.active %} is-active{% endif %}"
                        {% if swatch_background contains 'http' %}
                          style="background-image:url('{{ swatch_background }}'); background-size:cover; background-position:center;"
                        {% elsif swatch_background != blank %}
                          style="background: {{ swatch_background }};"
                        {% endif %}
                      >
                        <span class="pp-fcolor__tip">{{ value.label }}</span>
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}
                            checked
                          {% endif %}
                          {% if value.count == 0 and value.active == false %}
                            disabled
                          {% endif %}
                        >
                      </label>
                    {% endfor %}
                  </div>
                {% else %}
                  <ul class="pp-fopts">
                    {% for value in filter.values %}
                      <li>
                        <label class="pp-fopt">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}
                              checked
                            {% endif %}
                          {% if value.count == 0 and value.active == false %}
                            disabled
                          {% endif %}
                        >
                          <span class="pp-fopt__box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                          </span>
                          <span class="pp-fopt__label">
                            {% if normalized_filter_label == 'rating' and value.label != blank %}
                              {% assign rating_label_value = value.label | plus: 0 %}
                              <span class="pp-frating-stars" aria-hidden="true">
                                {% for star_index in (1..5) %}
                                  <svg{% if star_index > rating_label_value %} class="dim"{% endif %} viewBox="0 0 20 20">
                                    <path d="M10.4552 0.846855C10.3119 0.384382 9.68806 0.384382 9.54477 0.846855L7.63027 7.02616C7.56619 7.23298 7.38241 7.37301 7.17504 7.37301H0.979572C0.515888 7.37301 0.323098 7.99527 0.698226 8.28109L5.71047 12.1001C5.87823 12.2279 5.94843 12.4545 5.88435 12.6613L3.96984 18.8406C3.82656 19.3031 4.33129 19.6877 4.70642 19.4019L9.71865 15.5828C9.88642 15.455 10.1136 15.455 10.2813 15.5828L15.2936 19.4019C15.6687 19.6877 16.1734 19.3031 16.0302 18.8406L14.1157 12.6613C14.0516 12.4545 14.1218 12.2279 14.2895 12.1001L19.3018 8.28109C19.6769 7.99527 19.4841 7.37301 19.0204 7.37301H12.825C12.6176 7.37301 12.4338 7.23298 12.3697 7.02616L10.4552 0.846855Z"></path>
                                  </svg>
                                {% endfor %}
                              </span>
                              <span class="pp-frating-amp">&amp; up</span>
                            {% else %}
                              {{ value.label }}
                            {% endif %}
                          </span>
                          <span class="pp-fopt__count">{{ value.count }}</span>
                        </label>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </section>
          {% endfor %}
        </div>
        <div class="pp-drawer__foot">
          <a href="{{ clear_url }}" class="pp-drawer__clear">Clear all</a>
          <button type="submit" class="pp-drawer__show" data-close-drawer>Show {{ total_results }} results</button>
        </div>
      </form>
    </aside>
  </div>
{% endpaginate %}

{% stylesheet %}
  :root {
    --pp-primary: #e8532a;
    --pp-primary-dark: #c73e18;
    --pp-primary-light: #fff1ec;
    --pp-primary-mid: #f0784e;
    --pp-navy: #111827;
    --pp-navy-deep: #0f172a;
    --pp-navy-mid: #1e293b;
    --pp-white: #ffffff;
    --pp-bg: #ffffff;
    --pp-bg-subtle: #f7f8fa;
    --pp-border: #e5e7eb;
    --pp-border-light: #f3f4f6;
    --pp-text: #111827;
    --pp-text-secondary: #4b5563;
    --pp-text-muted: #9ca3af;
    --pp-shadow-sm: 0 1px 3px rgb(0 0 0 / 0.07), 0 1px 2px rgb(0 0 0 / 0.04);
    --pp-shadow-md: 0 4px 12px rgb(0 0 0 / 0.08);
    --pp-shadow-lg: 0 14px 26px rgb(0 0 0 / 0.12);
    --pp-shadow-xl: 0 24px 48px rgb(0 0 0 / 0.15);
    --pp-radius-sm: 8px;
    --pp-radius-md: 12px;
    --pp-radius-lg: 16px;
    --pp-radius-xl: 20px;
    --pp-radius-pill: 999px;
    --pp-font-heading: 'Sora', sans-serif;
    --pp-font-body: 'DM Sans', sans-serif;
    --pp-transition: 160ms ease;
    --pp-transition-md: 240ms ease;
    --pp-wrap-max: 1600px;
    --pp-wrap-pad: 24px;
  }

  .shopify-section .pp-wrap,
  .shopify-section .pp-wrap *,
  .shopify-section .pp-wrap *::before,
  .shopify-section .pp-wrap *::after,
  .pp-overlay,
  .pp-overlay::before,
  .pp-overlay::after,
  .pp-drawer,
  .pp-drawer *,
  .pp-drawer *::before,
  .pp-drawer *::after {
    box-sizing: border-box;
  }

  .shopify-section [data-pp-search-page] img,
  .shopify-section [data-pp-search-page] svg {
    max-width: 100%;
    display: block;
  }

  .shopify-section [data-pp-search-page] button,
  .shopify-section [data-pp-search-page] input,
  .shopify-section [data-pp-search-page] select {
    font-family: inherit;
    font-size: inherit;
  }

  .shopify-section [data-pp-search-page] button {
    cursor: pointer;
    border: none;
    background: none;
    padding: 0;
    color: inherit;
  }

  .shopify-section [data-pp-search-page] a {
    color: inherit;
    text-decoration: none;
  }

  .shopify-section [data-pp-search-page] h1,
  .shopify-section [data-pp-search-page] h2,
  .shopify-section [data-pp-search-page] h3,
  .shopify-section [data-pp-search-page] h4 {
    font-family: var(--pp-font-heading);
    margin: 0;
    color: var(--pp-navy-deep);
    line-height: 1.15;
  }

  .shopify-section [data-pp-search-page] p {
    margin: 0;
  }

  .shopify-section [data-pp-search-page] [hidden] {
    display: none !important;
  }

  body.is-locked {
    overflow: hidden;
  }

  .shopify-section [data-pp-search-page] :focus-visible {
    outline: 2px solid var(--pp-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .pp-wrap {
    width: min(100%, var(--pp-wrap-max));
    margin-inline: auto;
    padding-inline: var(--pp-wrap-pad);
  }

  .pp-search-head {
    padding: 28px 0 18px;
    background: var(--pp-white);
  }

  .pp-breadcrumb {
    font-size: 13px;
    color: var(--pp-text-muted);
    font-weight: 500;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pp-breadcrumb a {
    color: var(--pp-text-secondary);
    transition: color 0.15s ease;
  }

  .pp-breadcrumb a:hover {
    color: var(--pp-navy);
  }

  .pp-breadcrumb svg {
    width: 12px;
    height: 12px;
    color: var(--pp-text-muted);
  }

  .pp-breadcrumb__current {
    color: var(--pp-navy);
    font-weight: 600;
  }

  .pp-search-title {
    font-family: var(--pp-font-heading);
    font-size: 36px;
    font-weight: 700;
    color: var(--pp-navy-deep);
    letter-spacing: -0.02em;
    margin-bottom: 2px;
    line-height: 1.1;
  }

  .pp-search-count {
    font-size: 15px;
    color: var(--pp-text-secondary);
    font-weight: 500;
  }

  .pp-search-count strong {
    color: var(--pp-navy-deep);
    font-weight: 700;
  }

  .pp-toolbar {
    border-top: 1px solid var(--pp-border-light);
    border-bottom: 1px solid var(--pp-border-light);
    background: var(--pp-white);
    padding: 10px 0;
  }

  .pp-toolbar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .pp-toolbar__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pp-filterbtn {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    height: 40px;
    border-radius: var(--pp-radius-pill);
    background: var(--pp-white);
    border: 1px solid var(--pp-border);
    font-family: var(--pp-font-heading);
    font-weight: 600;
    font-size: 14px;
    color: var(--pp-navy);
    transition: background 0.15s ease, color 0.15s ease;
    appearance: none;
    -webkit-appearance: none;
    box-shadow: none;
    text-decoration: none;
  }

  .pp-filterbtn:hover {
    background: var(--pp-navy);
    color: var(--pp-white);
  }

  .pp-filterbtn svg {
    width: 15px;
    height: 15px;
  }

  .pp-filterbtn__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    background: var(--pp-primary);
    color: var(--pp-white);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    padding: 0 6px;
    margin-left: 2px;
  }

  .pp-toolbar__results {
    font-size: 13px;
    color: var(--pp-text-secondary);
    font-weight: 500;
  }

  .pp-toolbar__right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pp-toolbar__right form,
  .pp-sidebar form,
  .pp-drawer form {
    margin: 0;
  }

  .pp-sort {
    position: relative;
  }

  .pp-sort__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 40px;
    border: 1px solid var(--pp-border);
    background: var(--pp-white);
    border-radius: var(--pp-radius-pill);
    font-family: var(--pp-font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--pp-navy);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .pp-sort__btn:hover {
    border-color: var(--pp-navy);
  }

  .pp-sort__btn .pp-sort__label-key {
    color: var(--pp-text-muted);
    font-weight: 500;
  }

  .pp-sort__btn .pp-sort__label-val {
    font-weight: 600;
    color: var(--pp-navy);
  }

  .pp-sort__caret {
    width: 14px;
    height: 14px;
    color: var(--pp-primary);
    transition: transform 0.2s ease;
    margin-left: 2px;
  }

  .pp-sort.is-open .pp-sort__caret {
    transform: rotate(180deg);
  }

  .pp-sort__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: min(220px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    background: var(--pp-white);
    border: 1px solid var(--pp-border-light);
    border-radius: var(--pp-radius-md);
    box-shadow: var(--pp-shadow-lg);
    padding: 6px;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .pp-sort.is-open .pp-sort__menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .pp-sort__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 12px;
    border-radius: var(--pp-radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--pp-navy);
    text-align: left;
    transition: background 0.12s ease;
  }

  .pp-sort__option:hover {
    background: var(--pp-bg-subtle);
  }

  .pp-sort__option.is-active {
    color: var(--pp-primary-dark);
    font-weight: 600;
  }

  .pp-sort__option .pp-sort__check {
    width: 14px;
    height: 14px;
    color: var(--pp-primary);
    opacity: 0;
    flex-shrink: 0;
  }

  .pp-sort__option.is-active .pp-sort__check {
    opacity: 1;
  }

  .pp-chips {
    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px 0 4px;
  }

  .pp-chips.is-visible {
    display: flex;
  }

  .pp-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 6px 6px 12px;
    background: var(--pp-primary-light);
    color: var(--pp-primary-dark);
    border-radius: var(--pp-radius-pill);
    font-family: var(--pp-font-body);
    font-size: 13px;
    font-weight: 600;
  }

  .pp-chip__x {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(199 62 24 / 0.12);
    color: var(--pp-primary-dark);
    transition: background 0.15s ease;
  }

  .pp-chip__x:hover {
    background: var(--pp-primary);
    color: var(--pp-white);
  }

  .pp-chip__x svg {
    width: 10px;
    height: 10px;
    stroke-width: 2.5;
  }

  .pp-chips__clear {
    margin-left: auto;
    font-family: var(--pp-font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--pp-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .pp-chips__clear:hover {
    color: var(--pp-primary-dark);
  }

  .pp-search-main {
    padding: 20px 0 56px;
    background: var(--pp-white);
  }

  .pp-search-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: flex-start;
  }

  .pp-sidebar {
    --pp-sticky-sidebar-top: calc(var(--pp-header-group-height, var(--header-group-height, 96px)) + 20px);
    position: sticky;
    top: var(--pp-sticky-sidebar-top);
