{{ 'pp-collection.css' | asset_url | stylesheet_tag }}
{{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pp-collection-page.js' | asset_url }}" defer></script>

{%- comment -%}
  Search results. Uses the collection page's layout, filters, product cards,
  pagination and script (pp-collection-page.js) so both pages look and work
  the same; the filters come from search.filters.

  Shopify's search also returns products that only mention the words in their
  description, or that its semantic search finds related. So the results are
  split: products whose title or product type has every search word (singular
  or plural) are the results, and the others are listed after them under
  "Related products". When nothing matches exactly (a typo, say), every result
  Shopify found is shown as before.
{%- endcomment -%}

{% liquid
  assign products_per_page = section.settings.products_per_page | default: 24
  assign current_sort = search.sort_by | default: search.default_sort_by
  assign search_terms = search.terms | default: ''
  assign search_terms_escaped = search_terms | escape
  assign clear_url = routes.search_url | append: '?type=product&q=' | append: search_terms_escaped
  assign support_url = section.settings.support_page.url | default: pages['contact'].url | default: pages['contact-us'].url | default: '/pages/contact'
  assign browse_links = section.settings.empty_state_menu.links
  if browse_links == blank
    assign browse_links = linklists['main-menu'].links
  endif
  assign current_sort_key = 'relevance'
  assign sort_relevance_value = ''
  assign sort_best_value = ''
  assign sort_price_asc_value = ''
  assign sort_price_desc_value = ''
  assign sort_newest_value = ''
  if current_sort != blank and current_sort != search.default_sort_by
    assign clear_url = clear_url | append: '&sort_by=' | append: current_sort
  endif

  assign total_active_values = 0
  for filter in search.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign total_active_values = total_active_values | plus: 1
        endif
      else
        assign total_active_values = total_active_values | plus: filter.active_values.size
    endcase
  endfor

  for option in search.sort_options
    case option.value
      when search.default_sort_by, 'relevance'
        assign sort_relevance_value = option.value
      when 'best-selling'
        assign sort_best_value = option.value
      when 'price-ascending'
        assign sort_price_asc_value = option.value
      when 'price-descending'
        assign sort_price_desc_value = option.value
      when 'created-descending'
        assign sort_newest_value = option.value
    endcase

    if option.value == current_sort
      case option.value
        when search.default_sort_by, 'relevance'
          assign current_sort_key = 'relevance'
        when 'best-selling'
          assign current_sort_key = 'best'
        when 'price-ascending'
          assign current_sort_key = 'price-asc'
        when 'price-descending'
          assign current_sort_key = 'price-desc'
        when 'created-descending'
          assign current_sort_key = 'newest'
      endcase
    endif
  endfor

  if sort_relevance_value == blank
    assign sort_relevance_value = search.default_sort_by | default: 'relevance'
  endif

  case current_sort_key
    when 'best'
      assign current_sort_label = 'Best selling'
    when 'price-asc'
      assign current_sort_label = 'Price: Low to high'
    when 'price-desc'
      assign current_sort_label = 'Price: High to low'
    when 'newest'
      assign current_sort_label = 'Newest'
    else
      assign current_sort_label = 'Relevance'
  endcase
%}

{% paginate search.results by products_per_page %}
  {% liquid
    assign product_results = search.results | where: 'object_type', 'product'
    assign total_results = paginate.items

    capture query_words_text
      render 'pp-search-words', text: search_terms, drop_stop_words: true
    endcapture
    assign query_words = query_words_text | strip | split: ' '
    assign exact_ids = '|'
    assign exact_types = '|'
    assign exact_count = 0
    if query_words.size > 0
      for product in product_results
        capture product_words
          render 'pp-search-words', text: product.title
          render 'pp-search-words', text: product.type
        endcapture
        assign product_words = product_words | replace: '  ', ' '
        assign is_exact = true
        for word in query_words
          # The last word may still be being typed, so it can match the start of a word.
          assign word_key = ' ' | append: word
          unless forloop.last
            assign word_key = word_key | append: ' '
          endunless
          unless product_words contains word_key
            assign is_exact = false
            break
          endunless
        endfor
        if is_exact
          assign exact_ids = exact_ids | append: product.id | append: '|'
          assign type_key = product.type | strip | downcase
          assign exact_types = exact_types | append: type_key | append: '|'
          assign exact_count = exact_count | plus: 1
        endif
      endfor
    endif
    assign split_results = false
    assign related_count = 0
    if exact_count > 0 and exact_count < product_results.size
      assign split_results = true
      assign related_count = product_results.size | minus: exact_count
    endif
    # Counts reflect the split when every result is on this page.
    assign result_count = total_results
    if split_results and paginate.pages == 1
      assign result_count = exact_count
    endif
    assign shown_from = 0
    assign shown_to = 0
    if total_results > 0
      assign shown_from = paginate.current_offset | plus: 1
      assign shown_to = paginate.current_offset | plus: search.results.size
    endif
    assign show_chips = false
    if total_active_values > 0
      assign show_chips = true
    endif
    assign no_results = false
    if total_results == 0 and total_active_values == 0
      assign no_results = true
    endif
  %}

  <div
    class="pp-collection-template pp-search-template"
    data-pp-collection-page
    data-section-id="{{ section.id }}"
    data-total-results="{{ total_results }}"
    data-clear-url="{{ clear_url }}"
  >
    <main id="main">
      <section class="pp-search-head" aria-labelledby="search-title">
        <div class="pp-wrap">
          <nav class="pp-breadcrumb" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span class="pp-breadcrumb__current" aria-current="page">Search</span>
          </nav>
          {% if search.performed %}
            <h1 id="search-title" class="pp-search-title">Results for &ldquo;{{ search_terms_escaped }}&rdquo;</h1>
            <p class="pp-search-count"><strong>{{ result_count }}</strong> {% if result_count == 1 %}result{% else %}results{% endif %}{% if split_results %} · {{ related_count }} related{% endif %}</p>
          {% else %}
            <h1 id="search-title" class="pp-search-title">Search</h1>
          {% endif %}
        </div>
      </section>

      {% if no_results %}
        <section class="pp-collection-main">
          <div class="pp-wrap">
            <div class="pp-search-empty" role="region" aria-labelledby="empty-title">
              <svg class="pp-search-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
              </svg>
              {% if search.performed %}
                <h2 id="empty-title" class="pp-search-empty__title">No results for &ldquo;{{ search_terms_escaped }}&rdquo;</h2>
                <p class="pp-search-empty__text">We couldn't find anything matching your search. Check the spelling or browse a category below.</p>
              {% else %}
                <h2 id="empty-title" class="pp-search-empty__title">What are you looking for?</h2>
                <p class="pp-search-empty__text">Type a product name, colour or room into the search bar, or browse a category below.</p>
              {% endif %}
              {% if browse_links != blank %}
                <div class="pp-search-empty__label">Browse categories</div>
                <div class="pp-search-empty__pills">
                  {% for link in browse_links limit: 12 %}
                    <a href="{{ link.url }}" class="pp-search-empty__pill">{{ link.title }}</a>
                  {% endfor %}
                </div>
              {% endif %}
              <a href="{{ support_url }}" class="pp-search-empty__support">Or contact support &rarr;</a>
            </div>
          </div>
        </section>
      {% else %}
      <div
        id="SearchFiltersForm-{{ section.id }}"
        class="pp-collection-form"
        data-action="{{ routes.search_url }}"
        data-pp-collection-form
      >
        <input type="hidden" name="q" value="{{ search_terms_escaped }}">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="sort_by" value="{{ current_sort }}" data-pp-sort-input>

        <section class="pp-collection-main">
          <div class="pp-wrap">
            <div class="pp-collection-layout">
              <aside class="pp-sidebar" aria-label="Product filters" id="sidebar-filters" data-filter-source="desktop">
                {% liquid
                  assign filter_types = blank
                  if split_results
                    assign filter_types = exact_types
                  endif
                  render 'pp-collection-filters', source: 'desktop', section_id: section.id, filters: search.filters, product_types: filter_types
                %}
              </aside>

              <div class="pp-collection-results">
                <div class="pp-toolbar" aria-label="Filters and sort">
                  <div class="pp-toolbar__row">
                    <div class="pp-toolbar__left">
                      <button
                        type="button"
                        class="pp-filterbtn"
                        data-open-drawer
                        aria-label="Open filters"
                        aria-controls="filter-drawer"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="4" y1="6" x2="20" y2="6"></line>
                          <line x1="7" y1="12" x2="17" y2="12"></line>
                          <line x1="10" y1="18" x2="14" y2="18"></line>
                        </svg>
                        Filters
                        <span
                          class="pp-filterbtn__count"
                          data-filterbtn-count
                          {% if total_active_values == 0 %}hidden{% endif %}
                        >
                          {{ total_active_values }}
                        </span>
                      </button>
                      <p class="pp-toolbar__count">
                        {% if shown_from == 0 %}
                          Showing 0 of {{ total_results }} results for &ldquo;{{ search_terms_escaped }}&rdquo;
                        {% elsif split_results and paginate.pages == 1 %}
                          {{ exact_count }} {% if exact_count == 1 %}result{% else %}results{% endif %} for &ldquo;{{ search_terms_escaped }}&rdquo;
                        {% else %}
                          Showing {{ shown_from }}–{{ shown_to }} of {{ total_results }} results for &ldquo;{{ search_terms_escaped }}&rdquo;
                        {% endif %}
                      </p>
                    </div>

                    <div class="pp-toolbar__right">
                      <div class="pp-sort" data-sort>
                        <button type="button" class="pp-sort__btn" data-sort-btn aria-haspopup="listbox" aria-expanded="false">
                          <span class="pp-sort__label-key">Sort:</span>
                          <span class="pp-sort__label-val" data-sort-current>{{ current_sort_label }}</span>
                          <svg class="pp-sort__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </button>
                        <div class="pp-sort__menu" role="listbox" aria-label="Sort options">
                          <button type="button" class="pp-sort__option{% if current_sort_key == 'relevance' %} is-active{% endif %}" data-sort-key="relevance" data-sort-option="{{ sort_relevance_value }}" data-sort-label="Relevance" role="option" aria-selected="{% if current_sort_key == 'relevance' %}true{% else %}false{% endif %}">Relevance <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% if sort_best_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'best' %} is-active{% endif %}" data-sort-key="best" data-sort-option="{{ sort_best_value }}" data-sort-label="Best selling" role="option" aria-selected="{% if current_sort_key == 'best' %}true{% else %}false{% endif %}">Best selling <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_price_asc_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'price-asc' %} is-active{% endif %}" data-sort-key="price-asc" data-sort-option="{{ sort_price_asc_value }}" data-sort-label="Price: Low to high" role="option" aria-selected="{% if current_sort_key == 'price-asc' %}true{% else %}false{% endif %}">Price: Low to high <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_price_desc_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'price-desc' %} is-active{% endif %}" data-sort-key="price-desc" data-sort-option="{{ sort_price_desc_value }}" data-sort-label="Price: High to low" role="option" aria-selected="{% if current_sort_key == 'price-desc' %}true{% else %}false{% endif %}">Price: High to low <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_newest_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'newest' %} is-active{% endif %}" data-sort-key="newest" data-sort-option="{{ sort_newest_value }}" data-sort-label="Newest" role="option" aria-selected="{% if current_sort_key == 'newest' %}true{% else %}false{% endif %}">Newest <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                        </div>
                      </div>
                      <div class="pp-viewtoggle" data-view-toggle role="group" aria-label="Product layout">
                        <button type="button" class="pp-viewtoggle__btn is-active" data-view="grid" aria-pressed="true" aria-label="Grid view">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                          </svg>
                        </button>
                        <button type="button" class="pp-viewtoggle__btn" data-view="list" aria-pressed="false" aria-label="List view">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="3" rx="1"></rect>
                            <rect x="3" y="10.5" width="18" height="3" rx="1"></rect>
                            <rect x="3" y="17" width="18" height="3" rx="1"></rect>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>

                  <div class="pp-chips{% if show_chips %} is-visible{% endif %}" data-chips aria-label="Active filters">
                    {% for filter in search.filters %}
                      {% if filter.type == 'price_range' %}
                        {% if filter.min_value.value != null or filter.max_value.value != null %}
                          <a href="{{ filter.url_to_remove }}" class="pp-chip">
                            {% if filter.min_value.value != null and filter.max_value.value != null %}
                              {{ filter.min_value.value | money_without_trailing_zeros }} - {{ filter.max_value.value | money_without_trailing_zeros }}
                            {% elsif filter.min_value.value != null %}
                              From {{ filter.min_value.value | money_without_trailing_zeros }}
                            {% else %}
                              Up to {{ filter.max_value.value | money_without_trailing_zeros }}
                            {% endif %}
                            <span class="pp-chip__x" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                              </svg>
                            </span>
                          </a>
                        {% endif %}
                      {% else %}
                        {% for value in filter.active_values %}
                          <a href="{{ value.url_to_remove }}" class="pp-chip">
                            {{ value.label }}
                            <span class="pp-chip__x" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                              </svg>
                            </span>
                          </a>
                        {% endfor %}
                      {% endif %}
                    {% endfor %}
                    {% if show_chips %}
                      <a href="{{ clear_url }}" class="pp-chips__clear">Clear all</a>
                    {% endif %}
                  </div>
                </div>

                <div class="pp-grid" id="product-grid" aria-label="Search results for {{ search_terms_escaped }}" data-pp-page-size="{{ products_per_page }}">
                  {% assign card_index = 0 %}
                  {% for product in product_results %}
                    {% liquid
                      assign id_key = '|' | append: product.id | append: '|'
                      if split_results and exact_ids contains id_key
                        assign card_index = card_index | plus: 1
                        render 'pp-collection-product-card', product: product, card_index: card_index
                      elsif split_results == false
                        render 'pp-collection-product-card', product: product, card_index: forloop.index
                      endif
                    %}
                  {% else %}
                    <div class="pp-grid__empty">
                      <p class="pp-grid__empty-title">No products match these filters</p>
                      <p>Try removing a filter to see more products.</p>
                      <a href="{{ clear_url }}" class="pp-chips__clear">Clear all filters</a>
                    </div>
                  {% endfor %}
                </div>

                {% if split_results %}
                  <details class="pp-search-related">
                    <summary class="pp-search-related__toggle">
                      <span>Show {{ related_count }} related {% if related_count == 1 %}product{% else %}products{% endif %}</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </summary>
                    <h2 class="pp-search-related__title">Related products</h2>
                    <p class="pp-search-related__note">These don&rsquo;t match &ldquo;{{ search_terms_escaped }}&rdquo; by name, but mention it or are similar.</p>
                    <div class="pp-grid pp-search-related__grid">
                      {% assign card_index = exact_count %}
                      {% for product in product_results %}
                        {% assign id_key = '|' | append: product.id | append: '|' %}
                        {% unless exact_ids contains id_key %}
                          {% assign card_index = card_index | plus: 1 %}
                          {% render 'pp-collection-product-card', product: product, card_index: card_index %}
                        {% endunless %}
                      {% endfor %}
                    </div>
                  </details>
                {% endif %}

                {% if paginate.pages > 1 %}
                  <nav class="pp-pagination" aria-label="Pagination">
                    <div class="pp-pagination__count">Showing {{ shown_from }}–{{ shown_to }} of {{ total_results }}</div>
                    <div class="pp-pagination__pages">
                      {% if paginate.previous %}
                        <a href="{{ paginate.previous.url }}" class="pp-page pp-page--arrow" aria-label="Previous page" data-pp-nav>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}

                      {% for part in paginate.parts %}
                        {% if part.is_link %}
                          <a href="{{ part.url }}" class="pp-page" data-pp-nav>{{ part.title }}</a>
                        {% else %}
                          {% if part.title == '&hellip;' %}
                            <span class="pp-page pp-page--ellipsis" aria-hidden="true">&hellip;</span>
                          {% else %}
                            <span class="pp-page is-current" aria-current="page">{{ part.title }}</span>
                          {% endif %}
                        {% endif %}
                      {% endfor %}

                      {% if paginate.next %}
                        <a href="{{ paginate.next.url }}" class="pp-page pp-page--arrow" aria-label="Next page" data-pp-nav>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}
                    </div>
                    <div class="pp-pagination__spacer" aria-hidden="true"></div>
                  </nav>
                {% endif %}
              </div>
            </div>
          </div>
        </section>


        <div class="pp-overlay" data-overlay aria-hidden="true"></div>
        <aside class="pp-drawer" id="filter-drawer" aria-label="Filter drawer" aria-hidden="true" data-filter-source="drawer">
          <div class="pp-drawer__head">
            <div class="pp-drawer__title">Filters</div>
            <button type="button" class="pp-drawer__close" data-close-drawer aria-label="Close filters">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="pp-drawer__body" id="drawer-filters">
            {% render 'pp-collection-filters', source: 'drawer', section_id: section.id, filters: search.filters, product_types: filter_types %}
          </div>
          <div class="pp-drawer__foot">
            <a href="{{ clear_url }}" class="pp-drawer__clear">Clear all</a>
            <button type="button" class="pp-drawer__show" data-pp-apply>Show results</button>
          </div>
        </aside>
      </div>
      {% endif %}
    </main>
  </div>
{% endpaginate %}

{% stylesheet %}
  .pp-search-head {
    padding: 28px 0 18px;
    background: var(--pp-white, #fff);
  }

  .pp-search-template .pp-search-title {
    font-family: var(--pp-font-heading);
    font-size: 36px;
    font-weight: 700;
    color: var(--pp-navy-deep);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 2px;
  }

  .pp-search-template .pp-search-count {
    font-size: 15px;
    font-weight: 500;
    color: var(--pp-text-secondary);
  }

  .pp-search-template .pp-search-count strong {
    color: var(--pp-navy-deep);
    font-weight: 700;
  }

  .pp-search-empty {
    max-width: 480px;
    margin: 0 auto;
    padding: 64px 0 80px;
    text-align: center;
  }

  .pp-search-empty__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 24px;
    color: var(--pp-text-muted);
    stroke-width: 1.5;
  }

  .pp-search-template .pp-search-empty__title {
    font-family: var(--pp-font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--pp-navy-deep);
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .pp-search-template .pp-search-empty__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--pp-text-secondary);
  }

  .pp-search-empty__label {
    margin: 32px 0 16px;
    font-family: var(--pp-font-heading);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
  }

  .pp-search-empty__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .pp-search-template .pp-search-empty__pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 1px solid var(--pp-border);
    border-radius: var(--pp-radius-pill, 999px);
    background: var(--pp-white, #fff);
    font-family: var(--pp-font-heading);
    font-size: 14px;
    font-weight: 500;
    color: var(--pp-navy);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .pp-search-template .pp-search-empty__pill:hover {
    border-color: var(--pp-navy);
    background: var(--pp-bg-subtle);
  }

  .pp-search-template .pp-search-empty__support {
    font-size: 14px;
    font-weight: 600;
    color: var(--pp-primary);
  }

  @media (max-width: 768px) {
    .pp-search-head {
      padding: 20px 0 14px;
    }

    .pp-search-template .pp-search-title {
      font-size: 24px;
    }

    .pp-search-empty {
      padding: 48px 0 56px;
    }
  }
{% endstylesheet %}

