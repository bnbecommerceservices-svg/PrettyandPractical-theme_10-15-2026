{% liquid
  assign pp_show = false
  assign page_handle = page.handle | default: ''
  assign pp_policy_haystack = request.path | append: '|' | append: policy.url | downcase
  if template.suffix == 'contact'
    assign pp_show = true
  elsif page_handle == 'contact' or page_handle == 'contact-us'
    assign pp_show = true
  elsif pp_policy_haystack contains 'contact'
    assign pp_show = true
  endif
%}
{% if pp_show %}
{{ 'pp-contact-us.css' | asset_url | stylesheet_tag }}

<section class="pp-contact-us">
  <div class="pp-wrap">
    <header class="pp-page-header">
      <nav class="pp-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <span>Contact Us</span>
      </nav>
      <h1>Contact Us</h1>
      <div class="pp-header-intro">
        <p>At Pretty and Practical, customer satisfaction is our top priority. Whether you have questions about your order, shipping times, returns, product details, or general inquiries, our friendly support team is here to help.</p>
        <p>We are committed to providing reliable customer service across Australia and ensuring a smooth and secure online shopping experience.</p>
      </div>
    </header>
    <div class="pp-header-divider"></div>
  </div>

  <div class="pp-wrap">
    <div class="pp-contact-layout">
      <div class="pp-form-card">
        <p class="pp-form-intro">If you have any questions or need assistance, please fill out the form below and our team will get back to you as soon as possible.</p>

        {% form 'contact', class: 'pp-contact-form', id: 'pp-contact-form' %}
          {% if form.errors %}
            <ul class="pp-form-errors" role="alert" aria-live="polite">
              {% for error in form.errors %}
                <li>
                  {% if error == 'form' %}
                    {{ form.errors.messages[error] }}
                  {% else %}
                    {{ form.errors.translated_fields[error] }} - {{ form.errors.messages[error] }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          <div class="pp-field">
            <label for="pp-name">Name</label>
            <input
              type="text"
              id="pp-name"
              name="contact[name]"
              value="{{ form.name | escape }}"
              placeholder="Your full name"
              required
              aria-required="true"
              {% if form.errors contains 'author' or form.errors contains 'name' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="pp-field">
            <label for="pp-email">Email <span style="color:var(--pp-primary)">*</span></label>
            <input
              type="email"
              id="pp-email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              placeholder="you@example.com"
              required
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="pp-field">
            <label for="pp-phone">Phone number</label>
            <input
              type="tel"
              id="pp-phone"
              name="contact[phone]"
              value="{{ form.phone | escape }}"
              placeholder="+61 400 000 000"
            >
          </div>

          <div class="pp-field">
            <label for="pp-comment">Comment</label>
            <textarea
              id="pp-comment"
              name="contact[body]"
              rows="3"
              placeholder="How can we help with your order or product question?"
              required
              aria-required="true"
              {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}
            >{{ form.body | escape }}</textarea>
          </div>

          <div class="pp-form-actions">
            <button
              type="submit"
              class="pp-submit-btn"
              id="pp-submit"
              aria-label="Send"
            >
              Send
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
            <div class="pp-success-msg{% if form.posted_successfully? %} is-visible{% endif %}" id="pp-success-msg" role="alert" aria-live="polite">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Thanks! We will contact you within 24–48 hours.
            </div>
          </div>
        {% endform %}
      </div>

      <aside class="pp-contact-info" aria-label="Contact information">
        <div class="pp-info-section">
          <div class="pp-info-section-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4C2.9 4 2.01 4.9 2.01 6L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            Get in Touch
          </div>

          <div class="pp-info-block">
            <svg class="pp-info-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4C2.9 4 2.01 4.9 2.01 6L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <div class="pp-info-body">
              <span class="pp-info-label">Customer Support Email</span>
              <div class="pp-info-detail">
                <a href="mailto:contact@prettyandpractical.com.au">contact@prettyandpractical.com.au</a>
              </div>
            </div>
          </div>

          <div class="pp-info-block">
            <svg class="pp-info-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.19 2.2z"/></svg>
            <div class="pp-info-body">
              <span class="pp-info-label">Customer Service Phone</span>
              <div class="pp-info-detail">
                <a href="tel:+61411597261">+61 411597261</a>
              </div>
            </div>
          </div>

          <div class="pp-info-block">
            <svg class="pp-info-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <div class="pp-info-body">
              <span class="pp-info-label">Office Address</span>
              <div class="pp-info-detail">
                <a href="https://www.google.com/maps/place/Pretty+and+Practical/@-33.7330975,150.9580407,17z/data=!3m1!4b1!4m6!3m5!1s0x6b12a12a688c6853:0x8b783e3378cd24c0!8m2!3d-33.7330975!4d150.9580407!16s%2Fg%2F11zym6ys_f" target="_blank" rel="noopener">
                  Suite 1.01, Level 1, 4 Burbank Place<br>
                  Norwest NSW 2153, Australia
                </a>
              </div>
            </div>
          </div>

          <div class="pp-info-note">
            For faster assistance, please include your order number (if applicable) in your message.
          </div>
        </div>

        <div class="pp-info-section">
          <div class="pp-info-section-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
            Business Hours (AEST)
          </div>
          <ul class="pp-hours-list">
            <li><span class="pp-day">Monday – Friday</span><span>9:00 AM – 6:00 PM</span></li>
            <li><span class="pp-day">Saturday</span><span>10:00 AM – 4:00 PM</span></li>
            <li><span class="pp-day">Sunday</span><span>Closed</span></li>
          </ul>
          <p class="pp-hours-compact">Mon to Fri 9:00 AM to 6:00 PM · Sat 10:00 AM to 4:00 PM · Sun Closed</p>
          <div class="pp-info-note">
            Please note that we are closed on major public holidays. For urgent matters, our support team monitors inquiries outside regular business hours where possible.
          </div>
        </div>
      </aside>
    </div>
  </div>

  <div class="pp-wrap">
    <div class="pp-office-map">
      <iframe
        title="Pretty and Practical office on Google Maps"
        src="https://maps.google.com/maps?q=Pretty+and+Practical,+Suite+1.01,+Level+1,+4+Burbank+Place,+Norwest+NSW+2153&ll=-33.7330975,150.9580407&z=17&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        tabindex="-1"
        aria-hidden="true"
      ></iframe>
      <a
        class="pp-office-map__link"
        href="https://www.google.com/maps/place/Pretty+and+Practical/@-33.7330975,150.9580407,17z/data=!3m1!4b1!4m6!3m5!1s0x6b12a12a688c6853:0x8b783e3378cd24c0!8m2!3d-33.7330975!4d150.9580407!16s%2Fg%2F11zym6ys_f"
        target="_blank"
        rel="noopener"
      >
        Open Pretty and Practical in Google Maps
      </a>
    </div>
  </div>

  <div class="pp-wrap">
    <div class="pp-bottom-info">
      <div class="pp-bottom-info-card">
        <div class="pp-info-section-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61 1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42A8.96 8.96 0 0 0 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/></svg>
          Response Time Expectations
        </div>
        <p class="pp-info-text">We typically respond to inquiries within 24-48 hours. For urgent matters, please call our customer service hotline.</p>
      </div>

      <div class="pp-bottom-info-card">
        <div class="pp-info-section-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
          Privacy Assurance
        </div>
        <p class="pp-info-text">Your contact information is kept confidential and used solely for your inquiry or order. We respect your privacy and do not share your personal information.</p>
      </div>

      <div class="pp-bottom-info-card">
        <div class="pp-info-section-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm4.24 16L12 15.45 7.77 18l1.12-4.81-3.73-3.23 4.92-.42L12 5l1.92 4.53 4.92.42-3.73 3.23L16.23 18z"/></svg>
          Feedback and Reviews
        </div>
        <p class="pp-info-text">We value your feedback and actively strive to improve our products and services. If you have suggestions or like to share your experience, we would love to hear from you.</p>
      </div>
    </div>
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FurnitureStore",
      "name": "Pretty and Practical",
      "url": {{ shop.url | json }},
      "telephone": "+61411597261",
      "email": "contact@prettyandpractical.com.au",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Suite 1.01, Level 1, 4 Burbank Place",
        "addressLocality": "Norwest",
        "addressRegion": "NSW",
        "postalCode": "2153",
        "addressCountry": "AU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -33.7330975,
        "longitude": 150.9580407
      }
    }
  </script>
</section>
{% endif %}

