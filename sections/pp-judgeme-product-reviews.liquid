{{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Judge.me Review Widget, using Judge.me's own Liquid code
  (judge.me/help: "Liquid code for Judge.me widgets"). Judge.me's script fills it
  in, so the "Judge.me" app embed must be on in Theme settings > App embeds.
  Only real Judge.me reviews show here.
{%- endcomment -%}
{%- comment -%} The widget prints its own "Customer Reviews" heading. {%- endcomment -%}
<section class="pp-creviews" id="reviews" aria-label="Customer reviews">
  <div class="pp-wrap">
    <!-- Start of Judge.me code -->
    {% assign has_legacy = false %}
    {% if product.metafields.judgeme.widget.size > 20 %}
      {% assign has_legacy = true %}
    {% endif %}
    <div style="clear:both"></div>
    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget"
      data-product-title="{{ product.title | escape }}"
      data-id="{{ product.id }}"
      data-product-id="{{ product.id }}"
      data-widget="review"
      data-auto-install="false"
      data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
      data-entry-point="review_widget.js"
      data-entry-key="review-widget/main.js"
    >
      {% if has_legacy %}
        <div class="jdgm-legacy-widget-content" style="display: none;">{{ product.metafields.judgeme.widget }}</div>
      {% endif %}
    </div>
    {% if product.metafields.judgeme.review_widget_data %}
      {%- comment -%} The theme sets up window.jdgm at the end of the page, after this section. {%- endcomment -%}
      <script>window.jdgm = window.jdgm || {}; jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>
    {% endif %}
    <!-- End of Judge.me code -->
  </div>
</section>
{%- comment -%}
  Only one review widget per page. If Judge.me's own Review Widget app block is
  also on this product page (added by Judge.me's "Install" button or by hand in
  the theme editor, inside the product section or as its own section, above or
  below this one), keep Judge.me's block and remove this section, so reviews
  don't show twice and the two widgets don't share the id
  "judgeme_product_reviews". An empty "#reviews" marker is put just before
  Judge.me's block so the star link under the product title still scrolls to
  the reviews. Runs now for blocks above this section, and again once the page
  is parsed for blocks below it, before Judge.me's scripts fill the widgets.
  See docs/judgeme-reviews.md.
{%- endcomment -%}
<script>
  (function () {
    function keepOneReviewWidget() {
      var own = document.getElementById('reviews');
      if (!own || !own.classList.contains('pp-creviews')) return true;
      var widgets = document.querySelectorAll('.shopify-app-block .jdgm-review-widget');
      var appWidget = null;
      for (var i = 0; i < widgets.length; i++) {
        if (!own.contains(widgets[i])) { appWidget = widgets[i]; break; }
      }
      if (!appWidget) return false;
      own.remove();
      var block = appWidget.closest('.shopify-app-block') || appWidget;
      var marker = document.createElement('div');
      marker.id = 'reviews';
      marker.setAttribute('aria-hidden', 'true');
      block.parentNode.insertBefore(marker, block);
      return true;
    }
    if (!keepOneReviewWidget()) {
      document.addEventListener('DOMContentLoaded', keepOneReviewWidget, { once: true });
    }
  })();
</script>

{% schema %}
{
  "name": "Judge.me reviews",
  "settings": []
}
{% endschema %}
