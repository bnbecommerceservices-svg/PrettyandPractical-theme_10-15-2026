{% javascript %}
  (() => {
    const roots = document.querySelectorAll('.pp-collection-template');

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ppCollectionReady === 'true') return;
      root.dataset.ppCollectionReady = 'true';

      const form = root.querySelector('[data-pp-collection-form]');
      const sort = root.querySelector('[data-sort]');
      const sortButton = root.querySelector('[data-sort-btn]');
      const sortInput = root.querySelector('[data-pp-sort-input]');
      const sortCurrent = root.querySelector('[data-sort-current]');
      const overlay = root.querySelector('[data-overlay]');
      const drawer = root.querySelector('.pp-drawer');
      const drawerOpenButton = root.querySelector('[data-open-drawer]');
      const drawerCloseButtons = root.querySelectorAll('[data-close-drawer]');
      const countBadge = root.querySelector('[data-filterbtn-count]');
      const drawerShowButton = root.querySelector('.pp-drawer__show');
      const mediaQuery = window.matchMedia('(max-width: 880px)');

      if (!(form instanceof HTMLFormElement)) return;

      const productGrid = root.querySelector('#product-grid');
      const countLabel = root.querySelector('.pp-toolbar__count');
      const chipsRow = root.querySelector('[data-chips]');
      const pageSize = Number(productGrid instanceof HTMLElement && productGrid.dataset.ppPageSize || 16);

      const sortValueToKey = (value) => {
        const raw = String(value || '').trim().toLowerCase();
        if (raw === 'best' || raw === 'best-selling') return 'best';
        if (raw === 'price-asc' || raw === 'price-ascending') return 'price-asc';
        if (raw === 'price-desc' || raw === 'price-descending') return 'price-desc';
        if (raw === 'newest' || raw === 'created-descending') return 'newest';
        if (raw === 'oldest' || raw === 'created-ascending') return 'oldest';
        return 'featured';
      };

      const resolveSortKey = (params) => {
        const fromPp = params instanceof URLSearchParams ? params.get('pp_sort') : '';
        if (fromPp) return sortValueToKey(fromPp);
        const fromBy = params instanceof URLSearchParams ? params.get('sort_by') : '';
        if (fromBy) return sortValueToKey(fromBy);
        if (sortInput instanceof HTMLInputElement && sortInput.value) return sortValueToKey(sortInput.value);
        return 'featured';
      };

      const cardNumber = (card, key) => {
        if (!(card instanceof HTMLElement)) return 0;
        const value = Number(card.dataset[key] || 0);
        return Number.isFinite(value) ? value : 0;
      };

      const compareProductCards = (a, b, sortKey) => {
        const featured = () => cardNumber(a, 'ppIndex') - cardNumber(b, 'ppIndex');
        const created = (card) => cardNumber(card, 'ppCreated') || cardNumber(card, 'ppPublished');
        if (sortKey === 'price-asc') return cardNumber(a, 'ppPrice') - cardNumber(b, 'ppPrice') || featured();
        if (sortKey === 'price-desc') return cardNumber(b, 'ppPrice') - cardNumber(a, 'ppPrice') || featured();
        if (sortKey === 'newest') return created(b) - created(a) || featured();
        if (sortKey === 'oldest') return created(a) - created(b) || featured();
        if (sortKey === 'best') {
          return cardNumber(b, 'ppBestseller') - cardNumber(a, 'ppBestseller')
            || cardNumber(b, 'ppReviews') - cardNumber(a, 'ppReviews')
            || featured();
        }
        return featured();
      };

      const syncSortUi = (sortKey) => {
        if (sortInput instanceof HTMLInputElement) sortInput.value = sortKey;
        if (!(sort instanceof HTMLElement)) return;
        sort.querySelectorAll('[data-sort-option]').forEach((item) => {
          const key = sortValueToKey(item.getAttribute('data-sort-key') || item.getAttribute('data-sort-option') || '');
          const active = key === sortKey;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', active ? 'true' : 'false');
          if (active && sortCurrent instanceof HTMLElement) {
            sortCurrent.textContent = item.getAttribute('data-sort-label') || item.textContent?.trim() || '';
          }
        });
      };

      const dollarsToCents = (value) => {
        if (value == null) return null;
        const trimmed = String(value).trim().replace(/,/g, '');
        if (!trimmed) return null;
        const amount = Number(trimmed);
        if (!Number.isFinite(amount)) return null;
        return Math.round(amount * 100);
      };

      const activeFilterSource = () => {
        const name = mediaQuery.matches ? 'drawer' : 'desktop';
        return root.querySelector(`[data-filter-source="${name}"]`) || root;
      };

      const arrowSvg = (dir) => (
        dir === 'prev'
          ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>'
          : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>'
      );

      const hrefForPage = (n, filterParams) => {
        const next = new URLSearchParams(filterParams);
        next.delete('page');
        if (n <= 1) next.delete('pp_page');
        else next.set('pp_page', String(n));
        const qs = next.toString();
        return qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      };

      const renderPagination = (currentPage, totalPages, filterParams) => {
        root.querySelectorAll('.pp-pagination').forEach((nav) => {
          const pagesEl = nav.querySelector('.pp-pagination__pages');
          if (!(pagesEl instanceof HTMLElement)) return;
          if (totalPages <= 1) {
            nav.hidden = true;
            return;
          }
          nav.hidden = false;

          const windowSize = 5;
          let start = Math.max(1, currentPage - 2);
          let end = start + windowSize - 1;
          if (end > totalPages) {
            end = totalPages;
            start = Math.max(1, end - windowSize + 1);
          }

          let html = '';
          if (currentPage > 1) {
            html += `<a href="${hrefForPage(currentPage - 1, filterParams)}" class="pp-page pp-page--arrow" data-pp-page="${currentPage - 1}" aria-label="Previous page">${arrowSvg('prev')}</a>`;
          } else {
            html += `<span class="pp-page pp-page--arrow" aria-disabled="true">${arrowSvg('prev')}</span>`;
          }

          if (start > 1) {
            html += `<a href="${hrefForPage(1, filterParams)}" class="pp-page" data-pp-page="1">1</a>`;
          }
          if (start > 2) html += '<span class="pp-page pp-page--ellipsis" aria-hidden="true">&hellip;</span>';

          for (let n = start; n <= end; n += 1) {
            const current = n === currentPage;
            html += `<a href="${hrefForPage(n, filterParams)}" class="pp-page${current ? ' is-current' : ''}" data-pp-page="${n}"${current ? ' aria-current="page"' : ''}>${n}</a>`;
          }

          if (end < totalPages - 1) html += '<span class="pp-page pp-page--ellipsis" aria-hidden="true">&hellip;</span>';
          if (end < totalPages) {
            html += `<a href="${hrefForPage(totalPages, filterParams)}" class="pp-page${currentPage === totalPages ? ' is-current' : ''}" data-pp-page="${totalPages}">${totalPages}</a>`;
          }

          if (currentPage < totalPages) {
            html += `<a href="${hrefForPage(currentPage + 1, filterParams)}" class="pp-page pp-page--arrow" data-pp-page="${currentPage + 1}" aria-label="Next page">${arrowSvg('next')}</a>`;
          } else {
            html += `<span class="pp-page pp-page--arrow" aria-disabled="true">${arrowSvg('next')}</span>`;
          }

          pagesEl.innerHTML = html;
        });
      };

      const applyClientFilters = (nextParams, pushUrl = true) => {
        const params = nextParams || new URLSearchParams(window.location.search);
        params.delete('page');
        params.delete('v');
        params.delete('pp_max_exclusive');

        const types = params.getAll('pp_type').filter(Boolean);
        const min = params.get('pp_min');
        const max = params.get('pp_max');
        const minCents = dollarsToCents(min);
        const maxCents = dollarsToCents(max);
        const exclusiveMax = !min && !!max;
        const avail = params.get('pp_avail');
        const preorder = params.get('pp_preorder');
        let page = Number(params.get('pp_page') || '1');
        if (!Number.isFinite(page) || page < 1) page = 1;

        const cards = [...root.querySelectorAll('#product-grid > .pp-card')];
        const matched = cards.filter((card) => {
          if (!(card instanceof HTMLElement)) return false;
          if (types.length && !types.includes(card.dataset.ppType || '')) return false;
          const price = Number(card.dataset.ppPrice || 0);
          if (minCents != null && price < minCents) return false;
          if (maxCents != null && (exclusiveMax ? price >= maxCents : price > maxCents)) return false;
          const wantAvail = avail === '1';
          const wantPreorder = preorder === '1';
          if (wantAvail && wantPreorder) {
            if (card.dataset.ppAvailable !== '1' && card.dataset.ppPreorder !== '1') return false;
          } else if (wantAvail && card.dataset.ppAvailable !== '1') {
            return false;
          } else if (wantPreorder && card.dataset.ppPreorder !== '1') {
            return false;
          }
          return true;
        });

        const sortKey = resolveSortKey(params);
        syncSortUi(sortKey);
        matched.sort((a, b) => compareProductCards(a, b, sortKey));

        if (productGrid instanceof HTMLElement) {
          const unmatched = cards.filter((card) => !matched.includes(card));
          const emptyNode = productGrid.querySelector('[data-pp-empty-filters]');
          matched.forEach((card) => productGrid.append(card));
          unmatched.forEach((card) => productGrid.append(card));
          if (emptyNode) productGrid.append(emptyNode);
        }

        const totalPages = Math.max(1, Math.ceil(matched.length / pageSize));
        if (page > totalPages) page = totalPages;
        const start = (page - 1) * pageSize;
        const visible = matched.slice(start, start + pageSize);

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const show = visible.includes(card);
          card.hidden = !show;
          card.style.display = show ? '' : 'none';
        });

        let empty = root.querySelector('[data-pp-empty-filters]');
        if (matched.length === 0) {
          if (!empty && productGrid instanceof HTMLElement) {
            empty = document.createElement('div');
            empty.className = 'pp-grid__empty';
            empty.setAttribute('data-pp-empty-filters', 'true');
            empty.innerHTML = '<p class="pp-grid__empty-title">No products match these filters</p><p>Try clearing a filter or browse a related collection.</p>';
            productGrid.append(empty);
          }
        } else if (empty) {
          empty.remove();
        }

        const shownFrom = matched.length ? start + 1 : 0;
        const shownTo = matched.length ? start + visible.length : 0;
        if (countLabel instanceof HTMLElement) {
          countLabel.textContent = shownFrom === 0
            ? `Showing 0 of ${matched.length} results in ${root.querySelector('#collection-title')?.textContent || 'this collection'}`
            : `Showing ${shownFrom}–${shownTo} of ${matched.length} results in ${root.querySelector('#collection-title')?.textContent || 'this collection'}`;
        }
        root.querySelectorAll('.pp-pagination').forEach((nav) => {
          const countEl = nav.querySelector('.pp-pagination__count');
          if (countEl instanceof HTMLElement) {
            countEl.textContent = shownFrom === 0
              ? `Showing 0 of ${matched.length}`
              : `Showing ${shownFrom}–${shownTo} of ${matched.length}`;
          }
        });
        renderPagination(page, totalPages, params);
        root.dataset.totalResults = String(matched.length);

        if (chipsRow instanceof HTMLElement) {
          const chipLabels = [];
          if (min || max) chipLabels.push(min && max ? `$${min} – $${max}` : min ? `From $${min}` : `Up to $${max}`);
          if (avail === '1') chipLabels.push('In stock');
          if (preorder === '1') chipLabels.push('Pre-order');
          types.forEach((type) => chipLabels.push(type));
          chipsRow.querySelectorAll('[data-pp-js-chip]').forEach((node) => node.remove());
          chipLabels.forEach((label) => {
            const chip = document.createElement('span');
            chip.className = 'pp-chip';
            chip.dataset.ppJsChip = 'true';
            chip.textContent = label;
            const clear = chipsRow.querySelector('.pp-chips__clear');
            chipsRow.insertBefore(chip, clear);
          });
          chipsRow.classList.toggle('is-visible', chipLabels.length > 0);
        }

        const migrateSortParam = params.has('sort_by');
        if (pushUrl || migrateSortParam) {
          params.delete('sort_by');
          if (sortKey && sortKey !== 'featured') params.set('pp_sort', sortKey);
          else params.delete('pp_sort');
          params.set('pp_page', String(page));
          if (page === 1) params.delete('pp_page');
          const next = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
          window.history.replaceState({}, '', next);
        }
      };

      const paramsFromForm = () => {
        const source = activeFilterSource();
        const params = new URLSearchParams();
        const sortInputEl = root.querySelector('[data-pp-sort-input]');
        if (sortInputEl instanceof HTMLInputElement && sortInputEl.value) {
          const sortKey = sortValueToKey(sortInputEl.value);
          if (sortKey !== 'featured') params.set('pp_sort', sortKey);
        }
        source.querySelectorAll('[data-pp-filter-input], [data-price-min], [data-price-max]').forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          if (!input.name || input.name.startsWith('pp-price-band')) return;
          if ((input.type === 'checkbox' || input.type === 'radio') && !input.checked) return;
          if (input.value.trim() === '') return;
          params.append(input.name, input.value);
        });
        return params;
      };

      const applyFiltersFromForm = (closeDrawer = false) => {
        const params = paramsFromForm();
        params.delete('pp_page');
        applyClientFilters(params, true);
        updateFilterCount();
        if (closeDrawer) setDrawerState(false);
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        applyFiltersFromForm(true);
      });

      applyClientFilters(new URLSearchParams(window.location.search), false);

      const setDrawerState = (isOpen) => {
        if (!(overlay instanceof HTMLElement) || !(drawer instanceof HTMLElement)) return;
        overlay.classList.toggle('is-open', isOpen);
        drawer.classList.toggle('is-open', isOpen);
        drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        overlay.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        document.body.classList.toggle('is-locked', isOpen);
      };

      const syncMirroredInputs = (changedInput) => {
        const inputs = root.querySelectorAll('[data-pp-filter-input]');

        inputs.forEach((input) => {
          if (!(input instanceof HTMLInputElement) || input === changedInput) return;
          if (input.type !== changedInput.type) return;
          if (input.name !== changedInput.name) return;
          if (input.value !== changedInput.value) return;

          if (changedInput.type === 'checkbox' || changedInput.type === 'radio') {
            input.checked = changedInput.checked;
          } else {
            input.value = changedInput.value;
          }

          const colorLabel = input.closest('.pp-fcolor');
          if (colorLabel) {
            colorLabel.classList.toggle('is-active', input.checked);
          }
        });

        const currentColorLabel = changedInput.closest('.pp-fcolor');
        if (currentColorLabel) {
          currentColorLabel.classList.toggle('is-active', changedInput.checked);
        }
      };

      const applyPriceBand = (band) => {
        if (!(band instanceof HTMLInputElement)) return;
        const minInputs = root.querySelectorAll('[data-price-min]');
        const maxInputs = root.querySelectorAll('[data-price-max]');
        const minVal = band.dataset.bandMin || '';
        const maxVal = band.dataset.bandMax || '';

        minInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = minVal;
        });
        maxInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = maxVal;
        });

        root.querySelectorAll('[data-price-band]').forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          input.checked = input.dataset.priceBand === band.dataset.priceBand;
        });
      };

      const setCollectionView = (view) => {
        const grid = root.querySelector('#product-grid');
        const buttons = root.querySelectorAll('[data-view]');
        const nextView = view === 'list' ? 'list' : 'grid';
        if (grid instanceof HTMLElement) {
          grid.classList.toggle('is-list', nextView === 'list');
        }
        buttons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const isActive = button.dataset.view === nextView;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        try {
          window.localStorage.setItem('pp-collection-view', nextView);
        } catch {
          /* ignore */
        }
      };

      const syncPriceBandFromInputs = () => {
        const source = activeFilterSource();
        const minInput = source.querySelector('[data-price-min]');
        const maxInput = source.querySelector('[data-price-max]');
        const minVal = minInput instanceof HTMLInputElement ? minInput.value.trim() : '';
        const maxVal = maxInput instanceof HTMLInputElement ? maxInput.value.trim() : '';
        let match = '';

        root.querySelectorAll('[data-price-band]').forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          const bandMin = input.dataset.bandMin || '';
          const bandMax = input.dataset.bandMax || '';
          if (bandMin === minVal && bandMax === maxVal) {
            match = input.dataset.priceBand || '';
          }
        });

        root.querySelectorAll('[data-price-band]').forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          input.checked = Boolean(match) && input.dataset.priceBand === match;
        });
      };

      const updateFilterCount = () => {
        let count = 0;
        const activeSource = mediaQuery.matches ? 'drawer' : 'desktop';
        const activeContainer = root.querySelector(`[data-filter-source="${activeSource}"]`);
        const activeInputs = activeContainer?.querySelectorAll('[data-pp-filter-input]') ?? [];

        activeInputs.forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          if (input.hasAttribute('data-price-band')) return;

          if (input.type === 'checkbox' || input.type === 'radio') {
            if (input.checked) count += 1;
            return;
          }

          if (input.value.trim() !== '') {
            count += 1;
          }
        });

        if (countBadge instanceof HTMLElement) {
          countBadge.textContent = String(count);
          countBadge.hidden = count === 0;
        }

        if (drawerShowButton instanceof HTMLButtonElement) {
          const totalResults = root.dataset.totalResults || '0';
          drawerShowButton.textContent = `Show ${totalResults} results`;
        }
      };

      const setResponsiveFilterSource = () => {
        const desktopInputs = root.querySelectorAll('[data-filter-source="desktop"] input');
        const drawerInputs = root.querySelectorAll('[data-filter-source="drawer"] input');
        const useDrawer = mediaQuery.matches;

        desktopInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) {
            input.disabled = useDrawer;
          }
        });

        drawerInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) {
            input.disabled = !useDrawer;
          }
        });

        if (!useDrawer) setDrawerState(false);
        updateFilterCount();
      };

      root.querySelectorAll('[data-group-toggle], [data-filter-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const group = button.closest('[data-filter-group]');
          if (!(group instanceof HTMLElement)) return;
          group.classList.toggle('is-collapsed');
          button.setAttribute('aria-expanded', group.classList.contains('is-collapsed') ? 'false' : 'true');
        });
      });

      root.querySelectorAll('[data-pp-filter-input]').forEach((input) => {
        if (!(input instanceof HTMLInputElement)) return;

        input.addEventListener('change', () => {
          syncMirroredInputs(input);
          updateFilterCount();

          if (input.hasAttribute('data-price-input')) {
            syncPriceBandFromInputs();
            return;
          }

          applyFiltersFromForm(false);
        });

        if (input.hasAttribute('data-price-input')) {
          input.addEventListener('input', () => {
            syncMirroredInputs(input);
            syncPriceBandFromInputs();
            updateFilterCount();
          });

          input.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter') return;
            event.preventDefault();
            syncMirroredInputs(input);
            syncPriceBandFromInputs();
            applyFiltersFromForm(false);
          });
        }
      });

      const activatePriceBand = (input) => {
        if (!(input instanceof HTMLInputElement) || !input.checked) return;
        applyPriceBand(input);
        applyFiltersFromForm(false);
      };

      root.querySelectorAll('[data-price-band]').forEach((input) => {
        if (!(input instanceof HTMLInputElement)) return;
        input.addEventListener('change', () => activatePriceBand(input));
        input.addEventListener('click', () => activatePriceBand(input));
      });

      root.querySelectorAll('[data-view]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return;
          setCollectionView(button.dataset.view || 'grid');
        });
      });

      try {
        setCollectionView(window.localStorage.getItem('pp-collection-view') || 'grid');
      } catch {
        setCollectionView('grid');
      }

      if (sort instanceof HTMLElement && sortButton instanceof HTMLButtonElement && sortInput instanceof HTMLInputElement) {
        const closeSort = () => {
          sort.classList.remove('is-open');
          sortButton.setAttribute('aria-expanded', 'false');
        };

        sortButton.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const isOpen = sort.classList.toggle('is-open');
          sortButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });

        sort.querySelectorAll('[data-sort-option]').forEach((option) => {
          option.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            const sortKey = sortValueToKey(option.getAttribute('data-sort-key') || option.getAttribute('data-sort-option') || '');
            syncSortUi(sortKey);
            closeSort();
            applyFiltersFromForm(false);
          });
        });

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !sort.contains(event.target)) {
            closeSort();
          }
        });
      }

      root.querySelectorAll('.pp-pagination').forEach((nav) => {
        nav.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a.pp-page') : null;
          if (!(link instanceof HTMLAnchorElement) || !link.href) return;
          event.preventDefault();
          const params = paramsFromForm();
          const page = link.getAttribute('data-pp-page') || new URL(link.href, window.location.origin).searchParams.get('pp_page') || '1';
          if (page === '1') params.delete('pp_page');
          else params.set('pp_page', page);
          applyClientFilters(params, true);
          updateFilterCount();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });

      drawerOpenButton?.addEventListener('click', () => setDrawerState(true));
      overlay?.addEventListener('click', () => setDrawerState(false));
      drawerCloseButtons.forEach((button) => {
        button.addEventListener('click', () => setDrawerState(false));
      });

      const wishlistStorageKey = 'pp-wishlist';

      // Prefer shared wishlist module when available.
      if (window.PPWishlist) {
        window.PPWishlist.bindButtons(root);
      } else {
        const readWishlist = () => {
          try {
            return JSON.parse(window.localStorage.getItem(wishlistStorageKey) || window.localStorage.getItem('pp-collection-wishlist') || '[]');
          } catch {
            return [];
          }
        };

        const writeWishlist = (items) => {
          window.localStorage.setItem(wishlistStorageKey, JSON.stringify(items));
        };

        const wishlistItems = new Set(
          readWishlist().map((item) => (item && typeof item === 'object' ? String(item.id) : String(item))).filter(Boolean)
        );

        root.querySelectorAll('[data-pp-wishlist], [data-wishlist]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;

          const productId = button.dataset.productId;
          if (!productId) return;

          button.classList.toggle('is-active', wishlistItems.has(productId));

          button.addEventListener('click', () => {
            if (wishlistItems.has(productId)) {
              wishlistItems.delete(productId);
              button.classList.remove('is-active');
            } else {
              wishlistItems.add(productId);
              button.classList.add('is-active');
              button.classList.add('pulse');
              window.setTimeout(() => button.classList.remove('pulse'), 250);
            }

            writeWishlist(Array.from(wishlistItems));
          });
        });
      }

      mediaQuery.addEventListener('change', setResponsiveFilterSource);
      setResponsiveFilterSource();
    });
  })();
{% endjavascript %}

