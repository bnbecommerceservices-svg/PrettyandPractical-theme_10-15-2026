{{ 'pp-collection.css' | asset_url | stylesheet_tag }}
{{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}

{% liquid
  assign products_per_page = section.settings.products_per_page | default: 16
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url
  assign current_sort_key = 'featured'
  assign sort_featured_value = blank
  assign sort_best_value = blank
  assign sort_price_asc_value = blank
  assign sort_price_desc_value = blank
  assign sort_newest_value = blank
  if current_sort != blank and current_sort != collection.default_sort_by
    assign clear_url = clear_url | append: '?sort_by=' | append: current_sort
  endif

  assign total_active_values = 0
  assign current_sort_label = 'Featured'

  for filter in collection.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign total_active_values = total_active_values | plus: 1
        endif
      else
        assign total_active_values = total_active_values | plus: filter.active_values.size
    endcase
  endfor

  for option in collection.sort_options
    case option.value
      when collection.default_sort_by, 'manual'
        assign sort_featured_value = option.value
      when 'best-selling'
        assign sort_best_value = option.value
      when 'price-ascending'
        assign sort_price_asc_value = option.value
      when 'price-descending'
        assign sort_price_desc_value = option.value
      when 'created-descending'
        assign sort_newest_value = option.value
    endcase

    if option.value == current_sort
      case option.value
        when collection.default_sort_by, 'manual'
          assign current_sort_key = 'featured'
        when 'best-selling'
          assign current_sort_key = 'best'
        when 'price-ascending'
          assign current_sort_key = 'price-asc'
        when 'price-descending'
          assign current_sort_key = 'price-desc'
        when 'created-descending'
          assign current_sort_key = 'newest'
      endcase
    endif
  endfor

  if sort_featured_value == blank
    assign sort_featured_value = collection.default_sort_by | default: 'manual'
  endif

  case current_sort_key
    when 'featured'
      assign current_sort_label = 'Featured'
    when 'best'
      assign current_sort_label = 'Best selling'
    when 'price-asc'
      assign current_sort_label = 'Price: Low to high'
    when 'price-desc'
      assign current_sort_label = 'Price: High to low'
    when 'newest'
      assign current_sort_label = 'Newest'
  endcase
%}

{% liquid
  assign pp_use_manual = true
  assign pp_types = '|'
  assign pp_in_stock = false
  assign pp_preorder = false
  assign pp_price_min = blank
  assign pp_price_max = blank
  assign pp_rating = 0
  assign pp_page = 1
  assign pp_active = 0
  assign pp_query_base = ''
  assign qs_parts = request.query_string | default: '' | url_decode | split: '&'

  for part in qs_parts
    if part == blank
      continue
    endif

    assign pair = part | split: '='
    assign key = pair | first
    assign val = pair | last
    if pair.size < 2
      assign val = ''
    endif

    if key == 'pp_type' or key == 'filter.p.product_type'
      if val != blank
        assign pp_types = pp_types | append: val | append: '|'
        assign pp_active = pp_active | plus: 1
      endif
    elsif key == 'pp_avail' or key == 'filter.v.availability'
      if val == '1'
        assign pp_in_stock = true
        assign pp_active = pp_active | plus: 1
      endif
    elsif key == 'pp_preorder' or key == 'filter.p.tag'
      assign tag_val = val | downcase | replace: '+', '-'
      if tag_val == '1' or tag_val == 'pre-order' or tag_val == 'preorder'
        assign pp_preorder = true
        assign pp_active = pp_active | plus: 1
      endif
    elsif key == 'pp_min' or key == 'filter.v.price.gte'
      if val != blank
        assign pp_price_min = val
        assign pp_active = pp_active | plus: 1
      endif
    elsif key == 'pp_max' or key == 'filter.v.price.lte'
      if val != blank
        assign pp_price_max = val
        assign pp_active = pp_active | plus: 1
      endif
    elsif key == 'filter.p.m.reviews.rating' and val != blank
      assign pp_rating = val | plus: 0
      assign pp_active = pp_active | plus: 1
    elsif key == 'pp_page' and val != blank
      assign pp_page = val | plus: 0
    endif

    unless key == 'page' or key == 'pp_page'
      if pp_query_base != blank
        assign pp_query_base = pp_query_base | append: '&'
      endif
      assign pp_query_base = pp_query_base | append: part
    endunless
  endfor

  if pp_types == '|'
    assign pp_types = ''
  endif
  if pp_page < 1
    assign pp_page = 1
  endif

  assign pp_price_min_cents = 0
  assign pp_price_max_cents = 0
  if pp_price_min != blank
    assign pp_price_min_cents = pp_price_min | times: 100
  endif
  if pp_price_max != blank
    assign pp_price_max_cents = pp_price_max | times: 100
  endif

  assign pp_page_url_base = collection.url
  if pp_query_base != blank
    assign pp_page_url_base = collection.url | append: '?' | append: pp_query_base
  endif

  assign pp_paginate_size = 250
  assign total_active_values = pp_active
  assign pp_grid_source = collection
  assign pp_empty_map = false
  assign pp_empty_kind = ''
  assign pp_live_count = collection.products_count | default: 0 | plus: 0
  if collection.all_products_count > pp_live_count
    assign pp_live_count = collection.all_products_count
  endif
  if pp_live_count == 0
    case collection.handle
      when 'tv-trolley-stand'
        if collections['tv-stands'] != blank
          assign pp_grid_source = collections['tv-stands']
        elsif collections['furniture'] != blank
          assign pp_grid_source = collections['furniture']
          assign pp_empty_map = true
          assign pp_empty_kind = 'tv'
        endif
      when 'outdoor'
        if collections['home-garden'] != blank
          assign pp_grid_source = collections['home-garden']
          assign pp_empty_map = true
          assign pp_empty_kind = 'outdoor'
        endif
    endcase
  endif
  assign pp_tv_url = '/collections/tv-stands'
  if collections['tv-stands'].url != blank
    assign pp_tv_url = collections['tv-stands'].url
  endif
  assign pp_outdoor_url = collections['home-garden'].url | default: '/collections/home-garden'
  assign pp_garden_try = 'garden-outdoor,garden-and-outdoor,outdoor-garden,garden,home-garden,home-and-garden' | split: ','
  for h in pp_garden_try
    if collections[h].url != blank
      assign pp_outdoor_url = collections[h].url
      break
    endif
  endfor
  if collections['outdoor'].products_count > 0
    assign pp_outdoor_url = collections['outdoor'].url
  endif
%}

{% paginate pp_grid_source.products by pp_paginate_size %}
  {% liquid
    assign total_results = paginate.items
    assign shown_results = paginate.current_offset | plus: pp_grid_source.products.size
    assign shown_from = paginate.current_offset | plus: 1
    if pp_grid_source.products.size == 0
      assign shown_from = 0
    endif
    assign shown_to = shown_results
    assign show_chips = false
    if total_active_values > 0
      assign show_chips = true
    endif
    assign fallback_handles = ''
    assign fallback_count = 0
    assign pp_matched_count = 0
    assign pp_rendered_count = 0
    assign pp_total_pages = 1
    assign pp_skip = 0
  %}
  {% if pp_use_manual %}
    {% for product in pp_grid_source.products %}
      {% liquid
        assign pp_match = true
      %}
      {% include 'pp-collection-kind-match' %}
      {% liquid
        if pp_types != blank
          assign pp_type_token = '|' | append: product.type | append: '|'
          unless pp_types contains pp_type_token
            assign pp_match = false
          endunless
        endif
        if pp_in_stock and product.available == false
          assign pp_match = false
        endif
        if pp_preorder
          assign pp_has_preorder = false
          for tag in product.tags
            assign pp_tag = tag | strip | downcase
            if pp_tag == 'pre-order' or pp_tag == 'preorder' or pp_tag == 'pre order'
              assign pp_has_preorder = true
            endif
          endfor
          unless pp_has_preorder
            assign pp_match = false
          endunless
        endif
        if pp_price_min != blank and product.price < pp_price_min_cents
          assign pp_match = false
        endif
        if pp_price_max != blank and product.price > pp_price_max_cents
          assign pp_match = false
        endif
        if pp_rating > 0
          assign pp_product_rating = product.metafields.reviews.rating.value.rating | default: 0 | plus: 0
          if pp_product_rating < pp_rating
            assign pp_match = false
          endif
        endif
      %}
      {% if pp_match %}
        {% assign pp_matched_count = pp_matched_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% liquid
      assign total_results = pp_matched_count
      assign pp_skip = pp_page | minus: 1 | times: products_per_page
      if pp_matched_count == 0
        assign shown_from = 0
        assign shown_to = 0
        assign shown_results = 0
      else
        assign shown_from = pp_skip | plus: 1
        assign shown_to = pp_skip | plus: products_per_page
        if shown_to > pp_matched_count
          assign shown_to = pp_matched_count
        endif
        assign shown_results = shown_to
      endif
      assign pp_total_pages = pp_matched_count | plus: products_per_page | minus: 1 | divided_by: products_per_page
      if pp_total_pages < 1
        assign pp_total_pages = 1
      endif
    %}
  {% endif %}
  {% if pp_empty_map and pp_matched_count == 0 and total_active_values == 0 %}
    {% include 'pp-collection-fallback-handles' %}
    {% if fallback_count > 0 %}
      {% assign total_results = fallback_count %}
      {% assign shown_results = fallback_count %}
    {% endif %}
  {% endif %}
  {% liquid
    assign show_chips = false
    if total_active_values > 0
      assign show_chips = true
    endif
  %}
  {% if pp_grid_source.products.size == 0 and total_active_values == 0 %}
    {% include 'pp-collection-fallback-handles' %}
    {% if fallback_count > 0 %}
      {% assign total_results = fallback_count %}
      {% assign shown_results = fallback_count %}
    {% endif %}
  {% endif %}

  <div
    class="pp-collection-template"
    data-pp-collection-page
    data-pp-manual-filters="true"
    data-pp-types="{{ pp_types | escape }}"
    data-pp-active="{{ pp_active }}"
    data-pp-qs="{{ request.query_string | escape }}"
    data-section-id="{{ section.id }}"
    data-total-results="{{ total_results }}"
    data-clear-url="{{ clear_url }}"
  >
    <main id="main">
      {% render 'pp-collection-banner',
        collection: collection,
        fallback_banner: section.settings.fallback_banner,
        banner_height: section.settings.banner_height,
        overlay_color: section.settings.banner_overlay_color
      %}

      <form
        id="CollectionFiltersForm-{{ section.id }}"
        class="pp-collection-form"
        method="get"
        action="{{ collection.url }}"
        data-pp-collection-form
      >
        <input type="hidden" name="pp_sort" value="{{ current_sort_key }}" data-pp-sort-input>

        <section class="pp-collection-main">
          <div class="pp-wrap">
            <div class="pp-collection-layout">
              <aside class="pp-sidebar" aria-label="Product filters" id="sidebar-filters" data-filter-source="desktop">
                {% render 'pp-collection-filters', source: 'desktop', section_id: section.id, price_min: pp_price_min, price_max: pp_price_max %}
              </aside>

              <div class="pp-collection-results">
                <div class="pp-toolbar" aria-label="Filters and sort">
                  <div class="pp-toolbar__row">
                    <div class="pp-toolbar__left">
                      <button
                        type="button"
                        class="pp-filterbtn"
                        data-open-drawer
                        aria-label="Open filters"
                        aria-controls="filter-drawer"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="4" y1="6" x2="20" y2="6"></line>
                          <line x1="7" y1="12" x2="17" y2="12"></line>
                          <line x1="10" y1="18" x2="14" y2="18"></line>
                        </svg>
                        Filters
                        <span
                          class="pp-filterbtn__count"
                          data-filterbtn-count
                          {% if total_active_values == 0 %}hidden{% endif %}
                        >
                          {{ total_active_values }}
                        </span>
                      </button>
                      <p class="pp-toolbar__count">
                        {% if shown_from == 0 %}
                          Showing 0 of {{ total_results }} results in {{ collection.title }}
                        {% else %}
                          Showing {{ shown_from }}–{{ shown_to }} of {{ total_results }} results in {{ collection.title }}
                        {% endif %}
                      </p>
                    </div>

                    <div class="pp-toolbar__right">
                      <div class="pp-sort" data-sort>
                        <button type="button" class="pp-sort__btn" data-sort-btn aria-haspopup="listbox" aria-expanded="false">
                          <span class="pp-sort__label-key">Sort:</span>
                          <span class="pp-sort__label-val" data-sort-current>{{ current_sort_label }}</span>
                          <svg class="pp-sort__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </button>
                        <div class="pp-sort__menu" role="listbox" aria-label="Sort options">
                          <button type="button" class="pp-sort__option{% if current_sort_key == 'featured' %} is-active{% endif %}" data-sort-key="featured" data-sort-option="{{ sort_featured_value }}" data-sort-label="Featured" role="option" aria-selected="{% if current_sort_key == 'featured' %}true{% else %}false{% endif %}">Featured <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% if sort_best_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'best' %} is-active{% endif %}" data-sort-key="best" data-sort-option="{{ sort_best_value }}" data-sort-label="Best selling" role="option" aria-selected="{% if current_sort_key == 'best' %}true{% else %}false{% endif %}">Best selling <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_price_asc_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'price-asc' %} is-active{% endif %}" data-sort-key="price-asc" data-sort-option="{{ sort_price_asc_value }}" data-sort-label="Price: Low to high" role="option" aria-selected="{% if current_sort_key == 'price-asc' %}true{% else %}false{% endif %}">Price: Low to high <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_price_desc_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'price-desc' %} is-active{% endif %}" data-sort-key="price-desc" data-sort-option="{{ sort_price_desc_value }}" data-sort-label="Price: High to low" role="option" aria-selected="{% if current_sort_key == 'price-desc' %}true{% else %}false{% endif %}">Price: High to low <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_newest_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'newest' %} is-active{% endif %}" data-sort-key="newest" data-sort-option="{{ sort_newest_value }}" data-sort-label="Newest" role="option" aria-selected="{% if current_sort_key == 'newest' %}true{% else %}false{% endif %}">Newest <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                        </div>
                      </div>
                      <div class="pp-viewtoggle" data-view-toggle role="group" aria-label="Product layout">
                        <button type="button" class="pp-viewtoggle__btn is-active" data-view="grid" aria-pressed="true" aria-label="Grid view">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                          </svg>
                        </button>
                        <button type="button" class="pp-viewtoggle__btn" data-view="list" aria-pressed="false" aria-label="List view">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="3" rx="1"></rect>
                            <rect x="3" y="10.5" width="18" height="3" rx="1"></rect>
                            <rect x="3" y="17" width="18" height="3" rx="1"></rect>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>

                  <div class="pp-chips{% if show_chips %} is-visible{% endif %}" data-chips aria-label="Active filters">
                    {% for filter in collection.filters %}
                      {% if filter.type == 'price_range' %}
                        {% if filter.min_value.value != null or filter.max_value.value != null %}
                          <a href="{{ filter.url_to_remove }}" class="pp-chip">
                            {% if filter.min_value.value != null and filter.max_value.value != null %}
                              {{ filter.min_value.value | money_without_trailing_zeros }} - {{ filter.max_value.value | money_without_trailing_zeros }}
                            {% elsif filter.min_value.value != null %}
                              From {{ filter.min_value.value | money_without_trailing_zeros }}
                            {% else %}
                              Up to {{ filter.max_value.value | money_without_trailing_zeros }}
                            {% endif %}
                            <span class="pp-chip__x" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                              </svg>
                            </span>
                          </a>
                        {% endif %}
                      {% else %}
                        {% for value in filter.active_values %}
                          <a href="{{ value.url_to_remove }}" class="pp-chip">
                            {{ value.label }}
                            <span class="pp-chip__x" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                              </svg>
                            </span>
                          </a>
                        {% endfor %}
                      {% endif %}
                    {% endfor %}
                    {% if pp_use_manual and pp_active > 0 %}
                      {% if pp_price_min != blank or pp_price_max != blank %}
                        <span class="pp-chip">
                          {% if pp_price_min != blank and pp_price_max != blank %}
                            ${{ pp_price_min }} – ${{ pp_price_max }}
                          {% elsif pp_price_min != blank %}
                            From ${{ pp_price_min }}
                          {% else %}
                            Up to ${{ pp_price_max }}
                          {% endif %}
                        </span>
                      {% endif %}
                      {% if pp_in_stock %}
                        <span class="pp-chip">In stock</span>
                      {% endif %}
                      {% if pp_preorder %}
                        <span class="pp-chip">Pre-order</span>
                      {% endif %}
                      {% assign pp_type_chips = pp_types | split: '|' %}
                      {% for type_chip in pp_type_chips %}
                        {% if type_chip != blank %}
                          <span class="pp-chip">{{ type_chip }}</span>
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                    {% if show_chips %}
                      <a href="{{ clear_url }}" class="pp-chips__clear">Clear all</a>
                    {% endif %}
                  </div>
                </div>

                <div class="pp-grid" id="product-grid" aria-label="{{ collection.title }} products" data-pp-page-size="{{ products_per_page }}">
                  {% assign pp_kind_rendered = 0 %}
                  {% if pp_grid_source.products.size > 0 %}
                    {% for product in pp_grid_source.products %}
                      {% assign pp_match = true %}
                      {% include 'pp-collection-kind-match' %}
                      {% if pp_match %}
                        {% assign pp_kind_rendered = pp_kind_rendered | plus: 1 %}
                        {% render 'pp-collection-product-card', product: product, collection: collection, card_index: forloop.index %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% if pp_kind_rendered == 0 %}
                    {% if fallback_handles != blank %}
                      {% assign fallback_list = fallback_handles | split: ',' %}
                      {% for handle in fallback_list %}
                        {% assign fallback_product = all_products[handle] %}
                        {% if fallback_product != blank %}
                          {% render 'pp-collection-product-card', product: fallback_product, collection: collection, card_index: forloop.index %}
                        {% endif %}
                      {% endfor %}
                    {% else %}
                      <div class="pp-grid__empty">
                        <p class="pp-grid__empty-title">No products in this collection yet</p>
                        <p>Browse a related shop while we keep adding pieces here.</p>
                        <div class="pp-grid__empty-links">
                          <a href="/collections/furniture">Furniture</a>
                        <a href="{{ pp_tv_url | default: '/collections/tv-stands' }}">TV Trolley / Stand</a>
                        <a href="{{ pp_outdoor_url | default: '/collections/home-garden' }}">Garden &amp; Outdoor</a>
                          <a href="/collections/home-garden">Home &amp; Garden</a>
                          <a href="/collections/pets">Pets</a>
                        </div>
                        {% if show_chips %}
                          <a href="{{ clear_url }}" class="pp-chips__clear">Clear all</a>
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endif %}
                </div>

                {% if pp_use_manual and pp_total_pages > 1 %}
                  <nav class="pp-pagination" aria-label="Pagination">
                    <div class="pp-pagination__count">Showing {{ shown_from }}–{{ shown_to }} of {{ total_results }}</div>
                    <div class="pp-pagination__pages">
                      {% if pp_page > 1 %}
                        <a href="{% if pp_query_base != blank %}{{ pp_page_url_base }}&{% else %}{{ collection.url }}?{% endif %}pp_page={{ pp_page | minus: 1 }}" class="pp-page pp-page--arrow" data-pp-page="{{ pp_page | minus: 1 }}" aria-label="Previous page">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}

                      {% liquid
                        assign win_size = 5
                        assign win_start = pp_page | minus: 2
                        if win_start < 1
                          assign win_start = 1
                        endif
                        assign win_end = win_start | plus: win_size | minus: 1
                        if win_end > pp_total_pages
                          assign win_end = pp_total_pages
                          assign win_start = win_end | minus: win_size | plus: 1
                          if win_start < 1
                            assign win_start = 1
                          endif
                        endif
                      %}
                      {% if win_start > 1 %}
                        <a href="{% if pp_query_base != blank %}{{ pp_page_url_base }}{% else %}{{ collection.url }}{% endif %}" class="pp-page" data-pp-page="1">1</a>
                      {% endif %}
                      {% if win_start > 2 %}
                        <span class="pp-page pp-page--ellipsis" aria-hidden="true">&hellip;</span>
                      {% endif %}
                      {% for page_n in (win_start..win_end) %}
                        {% if page_n == 1 %}
                          {% if pp_query_base != blank %}
                            {% assign pp_page_href = pp_page_url_base %}
                          {% else %}
                            {% assign pp_page_href = collection.url %}
                          {% endif %}
                        {% else %}
                          {% if pp_query_base != blank %}
                            {% assign pp_page_href = pp_page_url_base | append: '&pp_page=' | append: page_n %}
                          {% else %}
                            {% assign pp_page_href = collection.url | append: '?pp_page=' | append: page_n %}
                          {% endif %}
                        {% endif %}
                        <a
                          href="{{ pp_page_href }}"
                          class="pp-page{% if page_n == pp_page %} is-current{% endif %}"
                          data-pp-page="{{ page_n }}"
                          {% if page_n == pp_page %}aria-current="page"{% endif %}
                        >{{ page_n }}</a>
                      {% endfor %}
                      {% assign win_last_gap = pp_total_pages | minus: 1 %}
                      {% if win_end < win_last_gap %}
                        <span class="pp-page pp-page--ellipsis" aria-hidden="true">&hellip;</span>
                      {% endif %}
                      {% if win_end < pp_total_pages %}
                        <a
                          href="{% if pp_query_base != blank %}{{ pp_page_url_base }}&pp_page={{ pp_total_pages }}{% else %}{{ collection.url }}?pp_page={{ pp_total_pages }}{% endif %}"
                          class="pp-page{% if pp_page == pp_total_pages %} is-current{% endif %}"
                          data-pp-page="{{ pp_total_pages }}"
                        >{{ pp_total_pages }}</a>
                      {% endif %}

                      {% if pp_page < pp_total_pages %}
                        <a href="{% if pp_query_base != blank %}{{ pp_page_url_base }}&{% else %}{{ collection.url }}?{% endif %}pp_page={{ pp_page | plus: 1 }}" class="pp-page pp-page--arrow" data-pp-page="{{ pp_page | plus: 1 }}" aria-label="Next page">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}
                    </div>
                    <div class="pp-pagination__spacer" aria-hidden="true"></div>
                  </nav>
                {% elsif paginate.pages > 1 %}
                  <nav class="pp-pagination" aria-label="Pagination">
                    <div class="pp-pagination__count">Showing {{ shown_from }}–{{ shown_to }} of {{ total_results }}</div>
                    <div class="pp-pagination__pages">
                      {% if paginate.previous %}
                        <a href="{{ paginate.previous.url }}" class="pp-page pp-page--arrow" aria-label="Previous page">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}

                      {% for part in paginate.parts %}
                        {% if part.is_link %}
                          <a href="{{ part.url }}" class="pp-page">{{ part.title }}</a>
                        {% else %}
                          {% if part.title == '&hellip;' %}
                            <span class="pp-page pp-page--ellipsis" aria-hidden="true">&hellip;</span>
                          {% else %}
                            <span class="pp-page is-current" aria-current="page">{{ part.title }}</span>
                          {% endif %}
                        {% endif %}
                      {% endfor %}

                      {% if paginate.next %}
                        <a href="{{ paginate.next.url }}" class="pp-page pp-page--arrow" aria-label="Next page">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}
                    </div>
                    <div class="pp-pagination__spacer" aria-hidden="true"></div>
                  </nav>
                {% endif %}
              </div>
            </div>
          </div>
        </section>

        <section class="pp-collection-trust" aria-label="Shopping benefits">
          <div class="pp-wrap">
            <div class="pp-collection-trust__grid">
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>Australia wide shipping</h3>
                  <p>Fast, tracked delivery to your door.</p>
                </div>
              </div>
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>30 day returns</h3>
                  <p>Easy returns on unused items.</p>
                </div>
              </div>
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>Secure checkout</h3>
                  <p>Encrypted payments you can trust.</p>
                </div>
              </div>
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>Pretty &amp; Practical</h3>
                  <p>Designed for beautiful, everyday living.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="pp-overlay" data-overlay aria-hidden="true"></div>
        <aside class="pp-drawer" id="filter-drawer" aria-label="Filter drawer" aria-hidden="true" data-filter-source="drawer">
          <div class="pp-drawer__head">
            <div class="pp-drawer__title">Filters</div>
            <button type="button" class="pp-drawer__close" data-close-drawer aria-label="Close filters">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="pp-drawer__body" id="drawer-filters">
            {% render 'pp-collection-filters', source: 'drawer', section_id: section.id, price_min: pp_price_min, price_max: pp_price_max %}
          </div>
          <div class="pp-drawer__foot">
            <a href="{{ clear_url }}" class="pp-drawer__clear">Clear all</a>
            <button type="submit" class="pp-drawer__show" data-close-drawer>Show {{ total_results }} results</button>
          </div>
        </aside>
      </form>
    </main>
  </div>
{% endpaginate %}

