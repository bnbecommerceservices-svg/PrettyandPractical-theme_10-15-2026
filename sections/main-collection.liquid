{{ 'pp-collection.css' | asset_url | stylesheet_tag }}
{{ 'pp-judgeme.css' | asset_url | stylesheet_tag }}

{% liquid
  assign products_per_page = section.settings.products_per_page | default: 16
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url
  assign current_sort_key = 'featured'
  assign sort_featured_value = blank
  assign sort_best_value = blank
  assign sort_price_asc_value = blank
  assign sort_price_desc_value = blank
  assign sort_newest_value = blank
  if current_sort != blank and current_sort != collection.default_sort_by
    assign clear_url = clear_url | append: '?sort_by=' | append: current_sort
  endif

  assign total_active_values = 0
  assign current_sort_label = 'Featured'

  for filter in collection.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign total_active_values = total_active_values | plus: 1
        endif
      else
        assign total_active_values = total_active_values | plus: filter.active_values.size
    endcase
  endfor

  for option in collection.sort_options
    case option.value
      when collection.default_sort_by, 'manual'
        assign sort_featured_value = option.value
      when 'best-selling'
        assign sort_best_value = option.value
      when 'price-ascending'
        assign sort_price_asc_value = option.value
      when 'price-descending'
        assign sort_price_desc_value = option.value
      when 'created-descending'
        assign sort_newest_value = option.value
    endcase

    if option.value == current_sort
      case option.value
        when collection.default_sort_by, 'manual'
          assign current_sort_key = 'featured'
        when 'best-selling'
          assign current_sort_key = 'best'
        when 'price-ascending'
          assign current_sort_key = 'price-asc'
        when 'price-descending'
          assign current_sort_key = 'price-desc'
        when 'created-descending'
          assign current_sort_key = 'newest'
      endcase
    endif
  endfor

  if sort_featured_value == blank
    assign sort_featured_value = collection.default_sort_by | default: 'manual'
  endif

  case current_sort_key
    when 'featured'
      assign current_sort_label = 'Featured'
    when 'best'
      assign current_sort_label = 'Best selling'
    when 'price-asc'
      assign current_sort_label = 'Price: Low to high'
    when 'price-desc'
      assign current_sort_label = 'Price: High to low'
    when 'newest'
      assign current_sort_label = 'Newest'
  endcase
%}

{% paginate collection.products by products_per_page %}
  {% liquid
    assign total_results = paginate.items
    assign shown_from = 0
    assign shown_to = 0
    if total_results > 0
      assign shown_from = paginate.current_offset | plus: 1
      assign shown_to = paginate.current_offset | plus: collection.products.size
    endif
    assign show_chips = false
    if total_active_values > 0
      assign show_chips = true
    endif
  %}

  <div
    class="pp-collection-template"
    data-pp-collection-page
    data-section-id="{{ section.id }}"
    data-total-results="{{ total_results }}"
    data-clear-url="{{ clear_url }}"
  >
    <main id="main">
      {% render 'pp-collection-banner',
        collection: collection,
        fallback_banner: section.settings.fallback_banner,
        banner_height: section.settings.banner_height,
        overlay_color: section.settings.banner_overlay_color
      %}

      <form
        id="CollectionFiltersForm-{{ section.id }}"
        class="pp-collection-form"
        method="get"
        action="{{ collection.url }}"
        data-pp-collection-form
      >
        <input type="hidden" name="sort_by" value="{{ current_sort }}" data-pp-sort-input>

        <section class="pp-collection-main">
          <div class="pp-wrap">
            <div class="pp-collection-layout">
              <aside class="pp-sidebar" aria-label="Product filters" id="sidebar-filters" data-filter-source="desktop">
                {% render 'pp-collection-filters', source: 'desktop', section_id: section.id %}
              </aside>

              <div class="pp-collection-results">
                <div class="pp-toolbar" aria-label="Filters and sort">
                  <div class="pp-toolbar__row">
                    <div class="pp-toolbar__left">
                      <button
                        type="button"
                        class="pp-filterbtn"
                        data-open-drawer
                        aria-label="Open filters"
                        aria-controls="filter-drawer"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="4" y1="6" x2="20" y2="6"></line>
                          <line x1="7" y1="12" x2="17" y2="12"></line>
                          <line x1="10" y1="18" x2="14" y2="18"></line>
                        </svg>
                        Filters
                        <span
                          class="pp-filterbtn__count"
                          data-filterbtn-count
                          {% if total_active_values == 0 %}hidden{% endif %}
                        >
                          {{ total_active_values }}
                        </span>
                      </button>
                      <p class="pp-toolbar__count">
                        {% if shown_from == 0 %}
                          Showing 0 of {{ total_results }} results in {{ collection.title }}
                        {% else %}
                          Showing {{ shown_from }}–{{ shown_to }} of {{ total_results }} results in {{ collection.title }}
                        {% endif %}
                      </p>
                    </div>

                    <div class="pp-toolbar__right">
                      <div class="pp-sort" data-sort>
                        <button type="button" class="pp-sort__btn" data-sort-btn aria-haspopup="listbox" aria-expanded="false">
                          <span class="pp-sort__label-key">Sort:</span>
                          <span class="pp-sort__label-val" data-sort-current>{{ current_sort_label }}</span>
                          <svg class="pp-sort__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </button>
                        <div class="pp-sort__menu" role="listbox" aria-label="Sort options">
                          <button type="button" class="pp-sort__option{% if current_sort_key == 'featured' %} is-active{% endif %}" data-sort-key="featured" data-sort-option="{{ sort_featured_value }}" data-sort-label="Featured" role="option" aria-selected="{% if current_sort_key == 'featured' %}true{% else %}false{% endif %}">Featured <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% if sort_best_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'best' %} is-active{% endif %}" data-sort-key="best" data-sort-option="{{ sort_best_value }}" data-sort-label="Best selling" role="option" aria-selected="{% if current_sort_key == 'best' %}true{% else %}false{% endif %}">Best selling <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_price_asc_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'price-asc' %} is-active{% endif %}" data-sort-key="price-asc" data-sort-option="{{ sort_price_asc_value }}" data-sort-label="Price: Low to high" role="option" aria-selected="{% if current_sort_key == 'price-asc' %}true{% else %}false{% endif %}">Price: Low to high <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_price_desc_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'price-desc' %} is-active{% endif %}" data-sort-key="price-desc" data-sort-option="{{ sort_price_desc_value }}" data-sort-label="Price: High to low" role="option" aria-selected="{% if current_sort_key == 'price-desc' %}true{% else %}false{% endif %}">Price: High to low <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                          {% if sort_newest_value != blank %}
                            <button type="button" class="pp-sort__option{% if current_sort_key == 'newest' %} is-active{% endif %}" data-sort-key="newest" data-sort-option="{{ sort_newest_value }}" data-sort-label="Newest" role="option" aria-selected="{% if current_sort_key == 'newest' %}true{% else %}false{% endif %}">Newest <svg class="pp-sort__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                          {% endif %}
                        </div>
                      </div>
                      <div class="pp-viewtoggle" data-view-toggle role="group" aria-label="Product layout">
                        <button type="button" class="pp-viewtoggle__btn is-active" data-view="grid" aria-pressed="true" aria-label="Grid view">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                          </svg>
                        </button>
                        <button type="button" class="pp-viewtoggle__btn" data-view="list" aria-pressed="false" aria-label="List view">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="3" rx="1"></rect>
                            <rect x="3" y="10.5" width="18" height="3" rx="1"></rect>
                            <rect x="3" y="17" width="18" height="3" rx="1"></rect>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>

                  <div class="pp-chips{% if show_chips %} is-visible{% endif %}" data-chips aria-label="Active filters">
                    {% for filter in collection.filters %}
                      {% if filter.type == 'price_range' %}
                        {% if filter.min_value.value != null or filter.max_value.value != null %}
                          <a href="{{ filter.url_to_remove }}" class="pp-chip">
                            {% if filter.min_value.value != null and filter.max_value.value != null %}
                              {{ filter.min_value.value | money_without_trailing_zeros }} - {{ filter.max_value.value | money_without_trailing_zeros }}
                            {% elsif filter.min_value.value != null %}
                              From {{ filter.min_value.value | money_without_trailing_zeros }}
                            {% else %}
                              Up to {{ filter.max_value.value | money_without_trailing_zeros }}
                            {% endif %}
                            <span class="pp-chip__x" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                              </svg>
                            </span>
                          </a>
                        {% endif %}
                      {% else %}
                        {% for value in filter.active_values %}
                          <a href="{{ value.url_to_remove }}" class="pp-chip">
                            {{ value.label }}
                            <span class="pp-chip__x" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                              </svg>
                            </span>
                          </a>
                        {% endfor %}
                      {% endif %}
                    {% endfor %}
                    {% if show_chips %}
                      <a href="{{ clear_url }}" class="pp-chips__clear">Clear all</a>
                    {% endif %}
                  </div>
                </div>

                <div class="pp-grid" id="product-grid" aria-label="{{ collection.title }} products" data-pp-page-size="{{ products_per_page }}">
                  {% for product in collection.products %}
                    {% render 'pp-collection-product-card', product: product, collection: collection, card_index: forloop.index %}
                  {% else %}
                    <div class="pp-grid__empty">
                      {% if total_active_values > 0 %}
                        <p class="pp-grid__empty-title">No products match these filters</p>
                        <p>Try removing a filter to see more products.</p>
                        <a href="{{ clear_url }}" class="pp-chips__clear">Clear all filters</a>
                      {% else %}
                        <p class="pp-grid__empty-title">No products in this collection yet</p>
                        <p>Browse our other collections while we add pieces here.</p>
                        <div class="pp-grid__empty-links">
                          <a href="{{ routes.all_products_collection_url }}">Shop all</a>
                          <a href="{{ routes.collections_url }}">All collections</a>
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>

                {% if paginate.pages > 1 %}
                  <nav class="pp-pagination" aria-label="Pagination">
                    <div class="pp-pagination__count">Showing {{ shown_from }}–{{ shown_to }} of {{ total_results }}</div>
                    <div class="pp-pagination__pages">
                      {% if paginate.previous %}
                        <a href="{{ paginate.previous.url }}" class="pp-page pp-page--arrow" aria-label="Previous page" data-pp-nav>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}

                      {% for part in paginate.parts %}
                        {% if part.is_link %}
                          <a href="{{ part.url }}" class="pp-page" data-pp-nav>{{ part.title }}</a>
                        {% else %}
                          {% if part.title == '&hellip;' %}
                            <span class="pp-page pp-page--ellipsis" aria-hidden="true">&hellip;</span>
                          {% else %}
                            <span class="pp-page is-current" aria-current="page">{{ part.title }}</span>
                          {% endif %}
                        {% endif %}
                      {% endfor %}

                      {% if paginate.next %}
                        <a href="{{ paginate.next.url }}" class="pp-page pp-page--arrow" aria-label="Next page" data-pp-nav>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </a>
                      {% else %}
                        <span class="pp-page pp-page--arrow" aria-disabled="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                      {% endif %}
                    </div>
                    <div class="pp-pagination__spacer" aria-hidden="true"></div>
                  </nav>
                {% endif %}
              </div>
            </div>
          </div>
        </section>

        <section class="pp-collection-trust" aria-label="Shopping benefits">
          <div class="pp-wrap">
            <div class="pp-collection-trust__grid">
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>Australia wide shipping</h3>
                  <p>Fast, tracked delivery to your door.</p>
                </div>
              </div>
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>30 day returns</h3>
                  <p>Easy returns on unused items.</p>
                </div>
              </div>
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>Secure checkout</h3>
                  <p>Encrypted payments you can trust.</p>
                </div>
              </div>
              <div class="pp-collection-trust__item">
                <span class="pp-collection-trust__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </span>
                <div class="pp-collection-trust__copy">
                  <h3>Pretty &amp; Practical</h3>
                  <p>Designed for beautiful, everyday living.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="pp-overlay" data-overlay aria-hidden="true"></div>
        <aside class="pp-drawer" id="filter-drawer" aria-label="Filter drawer" aria-hidden="true" data-filter-source="drawer">
          <div class="pp-drawer__head">
            <div class="pp-drawer__title">Filters</div>
            <button type="button" class="pp-drawer__close" data-close-drawer aria-label="Close filters">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="pp-drawer__body" id="drawer-filters">
            {% render 'pp-collection-filters', source: 'drawer', section_id: section.id %}
          </div>
          <div class="pp-drawer__foot">
            <a href="{{ clear_url }}" class="pp-drawer__clear">Clear all</a>
            <button type="submit" class="pp-drawer__show">Show results</button>
          </div>
        </aside>
      </form>
    </main>
  </div>
{% endpaginate %}

<style>
  .shopify-section [data-pp-collection-page] button,
  .shopify-section [data-pp-collection-page] input,
  .shopify-section [data-pp-collection-page] select {
    font-family: inherit;
    font-size: inherit;
  }

  .shopify-section [data-pp-collection-page] button {
    cursor: pointer;
    border: none;
    background: none;
    padding: 0;
    color: inherit;
  }

  .shopify-section [data-pp-collection-page] a {
    color: inherit;
    text-decoration: none;
  }

  .shopify-section [data-pp-collection-page] p {
    margin: 0;
  }

  .shopify-section [data-pp-collection-page] .pp-breadcrumb {
    font-size: 13px !important;
    color: var(--pp-text-muted) !important;
    font-weight: 500 !important;
    margin-bottom: 16px !important;
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
  }

  .shopify-section [data-pp-collection-page] .pp-breadcrumb a,
  .shopify-section [data-pp-collection-page] .pp-breadcrumb a:link,
  .shopify-section [data-pp-collection-page] .pp-breadcrumb a:visited,
  .shopify-section [data-pp-collection-page] .pp-breadcrumb a:active {
    color: var(--pp-text-muted) !important;
    font-weight: 500 !important;
    transition: color 0.15s ease !important;
  }

  .shopify-section [data-pp-collection-page] .pp-breadcrumb a:hover {
    color: var(--pp-navy) !important;
  }

  .shopify-section [data-pp-collection-page] .pp-breadcrumb svg {
    width: 12px !important;
    height: 12px !important;
    color: var(--pp-text-muted) !important;
  }

  .shopify-section [data-pp-collection-page] .pp-breadcrumb__current {
    color: var(--pp-navy) !important;
    font-weight: 600 !important;
  }

  .shopify-section [data-pp-collection-page] .pp-drawer__title {
    font-family: var(--pp-font-heading) !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    color: var(--pp-navy-deep) !important;
  }

  .shopify-section [data-pp-collection-page] .pp-drawer__close {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: var(--pp-navy) !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    box-shadow: none !important;
    transition: background 0.15s ease !important;
  }

  .shopify-section [data-pp-collection-page] .pp-drawer__close:hover {
    background: var(--pp-bg-subtle) !important;
  }

  .shopify-section [data-pp-collection-page] .pp-drawer__close svg {
    width: 18px !important;
    height: 18px !important;
    stroke-width: 2 !important;
  }
</style>

{% javascript %}
  (() => {
    // Collection filters, sorting and pagination all use Shopify's native
    // filtering. Changes fetch the section from Shopify (Section Rendering
    // API) and swap it in; if that fails the browser just loads the URL.
    const ROOT_SELECTOR = '.pp-collection-template';
    const mediaQuery = window.matchMedia('(max-width: 880px)');
    let activeRequest = null;

    const urlFromForm = (root) => {
      const form = root.querySelector('[data-pp-collection-form]');
      const url = new URL(form instanceof HTMLFormElement ? form.action : window.location.pathname, window.location.origin);
      if (!(form instanceof HTMLFormElement)) return url;
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (key.startsWith('pp-price-band')) return;
        if (String(value).trim() === '') return;
        params.append(key, String(value));
      });
      url.search = params.toString();
      return url;
    };

    const setDrawerState = (root, isOpen) => {
      const overlay = root.querySelector('[data-overlay]');
      const drawer = root.querySelector('.pp-drawer');
      if (!(overlay instanceof HTMLElement) || !(drawer instanceof HTMLElement)) return;
      overlay.classList.toggle('is-open', isOpen);
      drawer.classList.toggle('is-open', isOpen);
      drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      overlay.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      document.body.classList.toggle('is-locked', isOpen);
    };

    const setResponsiveFilterSource = (root) => {
      const useDrawer = mediaQuery.matches;
      root.querySelectorAll('[data-filter-source="desktop"] input').forEach((input) => {
        if (input instanceof HTMLInputElement) input.disabled = useDrawer;
      });
      root.querySelectorAll('[data-filter-source="drawer"] input').forEach((input) => {
        if (input instanceof HTMLInputElement) input.disabled = !useDrawer;
      });
      if (!useDrawer) setDrawerState(root, false);
    };

    const setCollectionView = (root, view) => {
      const nextView = view === 'list' ? 'list' : 'grid';
      const grid = root.querySelector('#product-grid');
      if (grid instanceof HTMLElement) grid.classList.toggle('is-list', nextView === 'list');
      root.querySelectorAll('[data-view]').forEach((button) => {
        const isActive = button instanceof HTMLElement && button.dataset.view === nextView;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
      try {
        window.localStorage.setItem('pp-collection-view', nextView);
      } catch {
        /* ignore */
      }
    };

    const wholeDollars = (input) => {
      if (!(input instanceof HTMLInputElement) || input.value.trim() === '') return '';
      const amount = Math.floor(Number(input.value));
      return Number.isFinite(amount) ? String(amount) : '';
    };

    const syncPriceBands = (scope) => {
      const minVal = wholeDollars(scope.querySelector('[data-price-min]'));
      const maxVal = wholeDollars(scope.querySelector('[data-price-max]'));
      scope.querySelectorAll('[data-price-band]').forEach((band) => {
        if (!(band instanceof HTMLInputElement)) return;
        band.checked = (band.dataset.bandMin || '') === minVal && (band.dataset.bandMax || '') === maxVal;
      });
    };

    const bindWishlist = (root) => {
      if (window.PPWishlist) {
        window.PPWishlist.bindButtons(root);
        return;
      }
      const key = 'pp-wishlist';
      const read = () => {
        try {
          return JSON.parse(window.localStorage.getItem(key) || window.localStorage.getItem('pp-collection-wishlist') || '[]');
        } catch {
          return [];
        }
      };
      const items = new Set(read().map((item) => (item && typeof item === 'object' ? String(item.id) : String(item))).filter(Boolean));
      root.querySelectorAll('[data-pp-wishlist], [data-wishlist]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement) || !button.dataset.productId) return;
        const id = button.dataset.productId;
        button.classList.toggle('is-active', items.has(id));
        button.addEventListener('click', () => {
          if (items.has(id)) {
            items.delete(id);
            button.classList.remove('is-active');
          } else {
            items.add(id);
            button.classList.add('is-active', 'pulse');
            window.setTimeout(() => button.classList.remove('pulse'), 250);
          }
          try {
            window.localStorage.setItem(key, JSON.stringify(Array.from(items)));
          } catch {
            /* ignore */
          }
        });
      });
    };

    let init = () => {};

    const load = async (root, href, { push = true, scroll = false } = {}) => {
      const target = new URL(href, window.location.origin);
      target.searchParams.delete('section_id');
      const sectionId = root.dataset.sectionId;
      if (!sectionId) {
        window.location.assign(target.toString());
        return;
      }

      const fetchUrl = new URL(target.toString());
      fetchUrl.searchParams.set('section_id', sectionId);

      if (activeRequest) activeRequest.abort();
      activeRequest = new AbortController();
      root.classList.add('is-loading');
      root.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(fetchUrl.toString(), { signal: activeRequest.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const next = doc.querySelector(ROOT_SELECTOR);
        if (!(next instanceof HTMLElement)) throw new Error('Missing collection markup');

        document.body.classList.remove('is-locked');
        root.replaceWith(next);
        if (push) window.history.pushState({ ppCollection: true }, '', `${target.pathname}${target.search}`);
        init(next);
        if (scroll) {
          const top = next.querySelector('.pp-collection-main') || next;
          top.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        window.location.assign(target.toString());
      }
    };

    init = (root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ppCollectionReady === 'true') return;
      root.dataset.ppCollectionReady = 'true';

      const form = root.querySelector('[data-pp-collection-form]');
      if (!(form instanceof HTMLFormElement)) return;

      const apply = (options = {}) => load(root, urlFromForm(root).toString(), options);

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        setDrawerState(root, false);
        apply({ scroll: mediaQuery.matches });
      });

      // Desktop sidebar applies each change straight away; the mobile drawer
      // applies when "Show results" is pressed.
      root.querySelectorAll('[data-filter-source="desktop"] [data-pp-filter-input]').forEach((input) => {
        if (!(input instanceof HTMLInputElement) || input.hasAttribute('data-price-input')) return;
        input.addEventListener('change', () => apply());
      });

      root.querySelectorAll('[data-price-input]').forEach((input) => {
        if (!(input instanceof HTMLInputElement)) return;
        const scope = input.closest('[data-filter-group]') || root;
        input.addEventListener('input', () => syncPriceBands(scope));
        input.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter') return;
          event.preventDefault();
          form.requestSubmit();
        });
      });

      root.querySelectorAll('[data-price-band]').forEach((band) => {
        if (!(band instanceof HTMLInputElement)) return;
        band.addEventListener('change', () => {
          if (!band.checked) return;
          const scope = band.closest('[data-filter-group]') || root;
          const minInput = scope.querySelector('[data-price-min]');
          const maxInput = scope.querySelector('[data-price-max]');
          if (minInput instanceof HTMLInputElement) minInput.value = band.dataset.bandMin || '';
          if (maxInput instanceof HTMLInputElement) maxInput.value = band.dataset.bandMax || '';
          if (band.closest('[data-filter-source="desktop"]')) apply();
        });
      });

      root.querySelectorAll('[data-group-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const group = button.closest('[data-filter-group]');
          if (!(group instanceof HTMLElement)) return;
          const collapsed = group.classList.toggle('is-collapsed');
          button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        });
      });

      // Chips, "Clear all" and page links load without a full page reload.
      root.addEventListener('click', (event) => {
        const link = event.target instanceof Element
          ? event.target.closest('a[data-pp-nav], a.pp-chip, a.pp-chips__clear, a.pp-drawer__clear')
          : null;
        if (!(link instanceof HTMLAnchorElement) || !link.href) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        setDrawerState(root, false);
        load(root, link.href, { scroll: link.hasAttribute('data-pp-nav') });
      });

      const sort = root.querySelector('[data-sort]');
      const sortButton = root.querySelector('[data-sort-btn]');
      const sortInput = root.querySelector('[data-pp-sort-input]');
      if (sort instanceof HTMLElement && sortButton instanceof HTMLButtonElement && sortInput instanceof HTMLInputElement) {
        const closeSort = () => {
          sort.classList.remove('is-open');
          sortButton.setAttribute('aria-expanded', 'false');
        };
        sortButton.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const isOpen = sort.classList.toggle('is-open');
          sortButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        sort.querySelectorAll('[data-sort-option]').forEach((option) => {
          option.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            sortInput.value = option.getAttribute('data-sort-option') || '';
            closeSort();
            apply();
          });
        });
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !sort.contains(event.target)) closeSort();
        });
      }

      root.querySelectorAll('[data-view]').forEach((button) => {
        button.addEventListener('click', () => setCollectionView(root, button instanceof HTMLElement ? button.dataset.view : 'grid'));
      });
      try {
        setCollectionView(root, window.localStorage.getItem('pp-collection-view') || 'grid');
      } catch {
        setCollectionView(root, 'grid');
      }

      root.querySelector('[data-open-drawer]')?.addEventListener('click', () => setDrawerState(root, true));
      root.querySelector('[data-overlay]')?.addEventListener('click', () => setDrawerState(root, false));
      root.querySelectorAll('[data-close-drawer]').forEach((button) => {
        button.addEventListener('click', () => setDrawerState(root, false));
      });

      bindWishlist(root);
      setResponsiveFilterSource(root);
    };

    document.querySelectorAll(ROOT_SELECTOR).forEach((root) => init(root));

    mediaQuery.addEventListener('change', () => {
      document.querySelectorAll(ROOT_SELECTOR).forEach((root) => setResponsiveFilterSource(root));
    });

    window.addEventListener('popstate', () => {
      const root = document.querySelector(ROOT_SELECTOR);
      if (root instanceof HTMLElement) load(root, window.location.href, { push: false });
    });
  })();
{% endjavascript %}

