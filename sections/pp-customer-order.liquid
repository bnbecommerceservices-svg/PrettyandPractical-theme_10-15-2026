{{ 'pp-account.css' | asset_url | stylesheet_tag }}

<section class="pp-account pp-account-body" {{ section.shopify_attributes }}>
  <div class="pp-wrap">
    <div class="pp-account-layout">
      {% render 'pp-account-nav', current: 'orders' %}

      <div class="pp-account-panel pp-account-order-detail">
        <div class="pp-account-panel__head">
          <div>
            <h2>Order {{ order.name }}</h2>
            <p class="pp-account-panel__sub">Placed on {{ order.created_at | date: '%d %B %Y' }}</p>
          </div>
          <span class="pp-account-status">{{ order.financial_status_label }}</span>
        </div>

        <dl>
          <dt>Payment</dt>
          <dd>{{ order.financial_status_label }}</dd>
          <dt>Fulfillment</dt>
          <dd>{{ order.fulfillment_status_label | default: 'Unfulfilled' }}</dd>
          <dt>Total</dt>
          <dd>{{ order.total_net_amount | money }}</dd>
          {% if order.shipping_address %}
            <dt>Ship to</dt>
            <dd>{{ order.shipping_address | format_address }}</dd>
          {% endif %}
        </dl>

        <div class="pp-account-table-wrap">
          <table class="pp-account-orders">
            <thead>
              <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Price</th>
              </tr>
            </thead>
            <tbody>
              {% for line_item in order.line_items %}
                <tr>
                  <td>{{ line_item.title | escape }}</td>
                  <td>{{ line_item.quantity }}</td>
                  <td>{{ line_item.final_line_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="pp-account-actions">
          <a class="pp-account-btn pp-account-btn--primary" href="{{ routes.account_url }}">Back to orders</a>
          <a class="pp-account-btn pp-account-btn--outline" href="{{ pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' }}">Contact support</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PP Customer Order",
  "settings": [],
  "presets": [{ "name": "PP Customer Order" }]
}
{% endschema %}
