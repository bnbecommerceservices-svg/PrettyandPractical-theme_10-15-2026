{%- doc -%}
  Quick-add styles consolidated into a single snippet.

  @example
  {% render 'quick-add-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Quick Add */
  .quick-add {
    display: none !important;
    --quick-add-offset: 14px;
    --quick-add-bottom: 14px;

    position: absolute;
    inset: 0;
    z-index: var(--layer-raised);
    pointer-events: none;

    @media screen and (min-width: 750px) {
      --quick-add-offset: 16px;
      --quick-add-bottom: 16px;
    }
  }

  .quick-add .variant-option__button-label input[data-option-available='false'] {
    cursor: not-allowed;
  }

  .quick-add[class*='color-scheme-'] {
    background-color: #0000;
  }

  product-card:is(:hover, :focus-within) .quick-add__button {
    opacity: 0;
  }

  .quick-add__button {
    display: none !important;
    align-items: center;
    justify-content: center;
    background: var(--product-card-theme-accent);
    padding: 0;
    border-radius: 9px;
    border: 0;
    width: auto;
    height: 40px;
    cursor: pointer;
    opacity: 0 !important;
    overflow: hidden;
    color: #fff;
    pointer-events: all;
    position: absolute;
    inset-inline: var(--quick-add-offset);
    bottom: var(--quick-add-bottom);
    box-shadow: 0 10px 22px rgb(17 24 39 / 16%);

    &:hover {
      background: var(--product-card-theme-accent-dark);
      scale: 1.01;

      /* Hover stabilizer: extends hit area to maintain hover state */
      &::before {
        content: '';
        position: absolute;
        inset: -10px;
        z-index: -1;
      }
    }

    &:active {
      scale: 0.99;
    }

    .quick-add[stay-visible] & {
      display: none !important;
    }

    @media screen and (min-width: 750px) {
      display: none !important;
      opacity: 0 !important;
    }
  }

  .quick-add__button.add-to-cart-button {
    height: 40px;
  }

  .quick-add__button .add-to-cart-text {
    width: 100%;
    background: transparent;
    overflow: hidden;
    border-radius: inherit;
    height: 100%;
    gap: 8px;
    color: inherit;
  }

  .quick-add__button .svg-wrapper .checkmark-burst {
    width: 22px;
    height: 22px;
  }

  .quick-add__button .add-to-cart-icon {
    /* account for border width */
    height: 100%;
    width: 20px;
  }

  .quick-add__button .add-to-cart-text__content {
    display: grid;
    grid-template-columns: 1fr;

    & > span {
      min-width: 0;

      span {
        padding-right: 0;
        opacity: 1;
        display: inline-block;
        filter: none;
        translate: none;
      }
    }
  }

  .quick-add__button[data-added='true'] .add-to-cart-text {
    animation-name: atc-fade-out;
  }

  .quick-add__button[data-added='true'] .add-to-cart-text--added {
    translate: 0 0;
    animation-name: atc-fade-in;
  }

  .quick-add__product-form-component {
    height: 100%;
  }

  .quick-add__product-form-component .shopify-product-form {
    display: flex;
    justify-content: stretch;
    align-items: flex-end;
    container-type: inline-size;
    height: 100%;
  }

  .quick-add-modal .product-media {
    width: 100%;
    height: 100%;
  }

  .quick-add-modal deferred-media {
    display: none;
  }

  .quick-add-modal .media-gallery--carousel slideshow-component {
    --cursor: default;
  }

  .quick-add__button:is(:hover, :focus-visible) {
    background: var(--product-card-theme-accent-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-add__button .add-to-cart-text__content {
      grid-template-columns: 1fr;

      span span {
        opacity: 1;
        translate: 0 0;
        filter: blur(0);
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .quick-add__button {
      transition-property: scale, translate, opacity, background-color, box-shadow;
      transition-duration: var(--animation-speed);
      transition-timing-function: var(--ease-out-cubic);
    }

    .quick-add__button .add-to-cart-text__content {
      transition-property: grid-template-columns;
      transition-duration: var(--animation-speed);
      transition-timing-function: var(--ease-out-cubic);

      span span {
        transition-property: opacity, filter, translate;
        transition-duration: var(--animation-speed-slow);
        transition-timing-function: var(--ease-out-quad);
      }
    }
  }

  .quick-add__button[disabled],
  .quick-add__button:disabled {
    background: #b4aea5;
    box-shadow: none;
    cursor: not-allowed;
  }
{% endstylesheet %}
