{% liquid
  assign banner_handle = collection.handle | default: ''
  assign banner_title = collection.title | default: 'Collection'
  assign banner_img = blank
  assign use_curated = false

  assign banner_photo = 'https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=2000&q=80'
  assign banner_count = collection.all_products_count | default: collection.products_count | default: 0

  case banner_handle
    when 'new-arrival'
      assign use_curated = true
      assign banner_photo = 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=2000&q=80'
    when 'home-garden'
      assign banner_photo = 'https://images.unsplash.com/photo-1463320726281-696a485928c7?auto=format&fit=crop&w=2000&q=80'
    when 'garden-outdoor'
      assign banner_photo = 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=80'
    when 'furniture'
      assign banner_photo = 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=2000&q=80'
    when 'pets', 'animals-pets'
      assign use_curated = true
      assign banner_photo = 'https://images.unsplash.com/photo-1758685680310-5670e87e11e3?auto=format&fit=crop&w=2000&q=80'
    when 'under-50'
      assign banner_photo = 'https://images.unsplash.com/photo-1519710164239-da123dc03ef4?auto=format&fit=crop&w=2000&q=80'
    when 'bedroom-furniture'
      assign banner_photo = 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&fit=crop&w=2000&q=80'
    when 'living-room-furniture'
      assign banner_photo = 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=2000&q=80'
    when 'dining-furniture'
      assign banner_photo = 'https://images.unsplash.com/photo-1617806118233-18e1de247200?auto=format&fit=crop&w=2000&q=80'
    when 'office-furniture'
      assign banner_photo = 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2000&q=80'
    when 'home-decor'
      assign banner_photo = 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=2000&q=80'
    when 'kitchenware'
      assign banner_photo = 'https://images.unsplash.com/photo-1556912173-46c336c7fd55?auto=format&fit=crop&w=2000&q=80'
    when 'plant-stands'
      assign use_curated = true
      assign banner_photo = 'https://images.unsplash.com/photo-1545241047-6083a3684587?auto=format&fit=crop&w=2000&q=80'
    when 'metal-plant-stand'
      assign use_curated = true
      assign banner_photo = 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?auto=format&fit=crop&w=2000&q=80'
    when 'lighting'
      assign banner_photo = 'https://images.unsplash.com/photo-1513506003901-1e6a229e2d15?auto=format&fit=crop&w=2000&q=80'
    when 'tv-trolley-stand', 'tv-stands'
      assign banner_photo = 'https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?auto=format&fit=crop&w=2000&q=80'
    when 'outdoor'
      assign banner_photo = 'https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=2000&q=80'
    when 'all'
      assign banner_photo = 'https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=2000&q=80'
    else
      assign key = banner_title | downcase | append: ' ' | append: banner_handle
      if key contains 'pet' or key contains 'animal'
        assign use_curated = true
        assign banner_photo = 'https://images.unsplash.com/photo-1758685680310-5670e87e11e3?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'tv' or key contains 'trolley'
        assign banner_photo = 'https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'outdoor' or key contains 'garden'
        assign banner_photo = 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'metal' and key contains 'plant'
        assign use_curated = true
        assign banner_photo = 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'plant'
        assign use_curated = true
        assign banner_photo = 'https://images.unsplash.com/photo-1545241047-6083a3684587?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'kitchen'
        assign banner_photo = 'https://images.unsplash.com/photo-1556912173-46c336c7fd55?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'light'
        assign banner_photo = 'https://images.unsplash.com/photo-1513506003901-1e6a229e2d15?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'bedroom'
        assign banner_photo = 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'living'
        assign banner_photo = 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'dining'
        assign banner_photo = 'https://images.unsplash.com/photo-1617806118233-18e1de247200?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'office'
        assign banner_photo = 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'decor' or key contains 'mirror'
        assign banner_photo = 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'furniture'
        assign banner_photo = 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=2000&q=80'
      elsif key contains 'under' or key contains '50'
        assign banner_photo = 'https://images.unsplash.com/photo-1519710164239-da123dc03ef4?auto=format&fit=crop&w=2000&q=80'
      endif
  endcase

  if use_curated == false
    assign banner_img = collection.image | default: collection.featured_image
  endif

  # Department this collection sits under in the "Shop by category" menu, for the breadcrumb.
  assign crumb_parent = blank
  if category_menu != blank and category_menu.links.size > 0
    for link in category_menu.links
      for child in link.links
        if child.type == 'collection_link' and child.object.handle == collection.handle
          assign crumb_parent = link
          break
        endif
      endfor
      if crumb_parent != blank
        break
      endif
    endfor
  endif

  # Label and intro come from the store: the department name for a sub-category, and the
  # collection description from the admin. No made-up copy when the description is empty.
  if crumb_parent != blank
    assign banner_label = crumb_parent.title
  else
    assign banner_label = 'Shop the collection'
  endif
  assign banner_blurb = collection.description | strip_html | strip | truncatewords: 32

  assign banner_h = banner_height | default: 200
  assign overlay_color = overlay_color | default: '#111827'
  assign banner_extra_class = ''
  assign banner_key = banner_handle | append: ' ' | append: banner_title | downcase
  if banner_handle == 'pets' or banner_handle == 'animals-pets' or banner_key contains 'pet' or banner_key contains 'animal'
    unless banner_key contains 'plant'
      assign banner_extra_class = ' pp-collection-hero--pets'
      assign banner_h = 320
    endunless
  elsif banner_handle == 'plant-stands' or banner_handle == 'metal-plant-stand' or banner_key contains 'plant'
    assign banner_extra_class = ' pp-collection-hero--plants'
    assign banner_h = 280
  endif
%}

<section class="pp-collection-hero{{ banner_extra_class }}" aria-labelledby="collection-title" data-collection-banner="{{ banner_handle | escape }}" style="--pp-banner-height: {{ banner_h }}px;">
  <div class="pp-collection-hero__media" aria-hidden="true">
    {% if banner_img != blank %}
      {{
        banner_img
        | image_url: width: 2400
        | image_tag:
          class: 'pp-collection-hero__img',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          alt: banner_title
      }}
    {% else %}
      <img class="pp-collection-hero__img" src="{{ banner_photo }}" alt="{{ banner_title | escape }}" width="2000" height="700" loading="eager">
    {% endif %}
  </div>
  <div class="pp-collection-hero__overlay">
    <div class="pp-wrap">
      <nav class="pp-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        {%- if crumb_parent != blank %}
        <a href="{{ crumb_parent.url }}">{{ crumb_parent.title | escape }}</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        {%- endif %}
        <span class="pp-breadcrumb__current" aria-current="page">{{ banner_title | escape }}</span>
      </nav>
      <div class="pp-collection-hero__content">
        <p class="pp-collection-hero__label">{{ banner_label | escape }}</p>
        <h1 id="collection-title" class="pp-collection-title">{{ banner_title | escape }}</h1>
        {% if banner_blurb != blank %}
          <p class="pp-collection-desc">{{ banner_blurb | escape }}</p>
        {% endif %}
        {% if banner_count > 0 %}
          <p class="pp-collection-hero__count">{{ banner_count }} products</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }}},
      {%- if crumb_parent != blank %}
      {"@type": "ListItem", "position": 2, "name": {{ crumb_parent.title | json }}, "item": {{ request.origin | append: crumb_parent.url | json }}},
      {"@type": "ListItem", "position": 3, "name": {{ banner_title | json }}, "item": {{ request.origin | append: collection.url | json }}}
      {%- else %}
      {"@type": "ListItem", "position": 2, "name": {{ banner_title | json }}, "item": {{ request.origin | append: collection.url | json }}}
      {%- endif %}
    ]
  }
</script>
