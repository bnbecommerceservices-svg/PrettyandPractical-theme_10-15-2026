{% doc %}
  "Shop by category" dropdown, built only from the store's own data.

  Categories come from the menu picked in the header's "Shop by category menu"
  setting. When none is set, every collection that has products is listed
  alphabetically (from the global `collections` object).

  The dropdown has two views (snippets/pp-category-mega-panel.liquid):
  - "all" (the Shop by category button): every category side by side, each
    with its image, sub-categories and a "Shop all" link
  - one panel per category (its top nav link): all its sub-categories and
    its popular products

  @param {linklist} [menu] - Menu whose links are the categories.
{% enddoc %}

{%- liquid
  assign use_menu = false
  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif
  assign max_categories = 12
  assign category_count = 0
-%}

{%- capture mega_columns -%}
  {%- if use_menu -%}
    {%- for link in menu.links -%}
      {%- if category_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and link.links.size == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign category_count = category_count | plus: 1 -%}
      {%- assign link_collection = blank -%}
      {%- if link.type == 'collection_link' -%}{%- assign link_collection = link.object -%}{%- endif -%}
      {%- render 'pp-category-mega-panel', layout: 'column', label: link.title, url: link.url, panel_collection: link_collection, child_links: link.links -%}
    {%- endfor -%}
  {%- else -%}
    {%- for collection in collections -%}
      {%- if category_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if collection.handle == 'frontpage' or collection.handle == 'all' or collection.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign category_count = category_count | plus: 1 -%}
      {%- render 'pp-category-mega-panel', layout: 'column', label: collection.title, url: collection.url, panel_collection: collection -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture mega_panels -%}
  {%- assign panel_count = 0 -%}
  {%- if use_menu -%}
    {%- for link in menu.links -%}
      {%- if panel_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and link.links.size == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign panel_count = panel_count | plus: 1 -%}
      {%- assign panel_key = link.handle | default: link.title | handleize -%}
      {%- assign link_collection = blank -%}
      {%- if link.type == 'collection_link' -%}{%- assign link_collection = link.object -%}{%- endif -%}
      {%- render 'pp-category-mega-panel', layout: 'panel', key: panel_key, label: link.title, url: link.url, panel_collection: link_collection, child_links: link.links -%}
    {%- endfor -%}
  {%- else -%}
    {%- for collection in collections -%}
      {%- if panel_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if collection.handle == 'frontpage' or collection.handle == 'all' or collection.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign panel_count = panel_count | plus: 1 -%}
      {%- render 'pp-category-mega-panel', layout: 'panel', key: collection.handle, label: collection.title, url: collection.url, panel_collection: collection -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div class="pp-catmega" id="ppCategoryMega" data-pp-catmega hidden>
  <div class="pp-catmega__surface">
    {%- if category_count > 0 -%}
      <div class="pp-catmega__panel pp-catmega__panel--all" data-catmega-panel="all" hidden>
        <div class="pp-catmega__cols" style="--pp-catmega-cols: {{ category_count | at_most: 6 }};">
          {{ mega_columns }}
        </div>
      </div>
      {{ mega_panels }}
    {%- else -%}
      <p class="pp-catmega__empty">No categories to show yet.</p>
    {%- endif -%}

    <div class="pp-catmega__foot">
      <p>{% if settings.free_delivery_message != blank %}{{ settings.free_delivery_message | escape }} · {% endif %}30-day returns</p>
      <div class="pp-catmega__foot-links">
        <a href="{{ routes.collections_url }}">All categories <span aria-hidden="true">→</span></a>
        <a href="{{ routes.all_products_collection_url }}">Shop all products <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</div>
