{% liquid
  assign furniture_url = collections['furniture'].url | default: '/collections/furniture'
  assign home_garden_url = collections['home-garden'].url | default: '/collections/home-garden'
  assign outdoor_garden_url = collections['home-garden'].url | default: '/collections/home-garden'
  assign pets_url = collections['pets'].url | default: '/collections/pets'
  assign new_url = collections['new-arrival'].url | default: '/collections/new-arrival'
  assign under_url = collections['under-50'].url | default: '/collections/under-50'
  assign all_url = collections['all'].url | default: routes.all_products_collection_url
  assign pp_garden_try = 'garden-outdoor,garden-and-outdoor,outdoor-garden,garden,home-garden,home-and-garden' | split: ','
  for h in pp_garden_try
    if collections[h].url != blank
      assign outdoor_garden_url = collections[h].url
      break
    endif
  endfor
  assign tv_url = '/collections/tv-stands'
  if collections['tv-stands'].url != blank
    assign tv_url = collections['tv-stands'].url
  elsif collections['tv-trolley-stand'].url != blank
    assign tv_url = collections['tv-trolley-stand'].url
  endif
%}

<div class="pp-catmega" id="ppCategoryMega" data-pp-catmega hidden>
  <div class="pp-catmega__surface">
    <div class="pp-catmega__body">
      <aside class="pp-catmega__rail" aria-label="Categories">
        <a href="{{ new_url }}" class="pp-catmega__tab is-active" data-catmega-tab="new-arrival">New Arrival <span aria-hidden="true">›</span></a>
        <a href="{{ home_garden_url }}" class="pp-catmega__tab" data-catmega-tab="home-garden">Home &amp; Garden <span aria-hidden="true">›</span></a>
        <a href="{{ outdoor_garden_url }}" class="pp-catmega__tab" data-catmega-tab="garden-outdoor">Garden &amp; Outdoor <span aria-hidden="true">›</span></a>
        <a href="{{ furniture_url }}" class="pp-catmega__tab" data-catmega-tab="furniture">Furniture <span aria-hidden="true">›</span></a>
        <a href="{{ tv_url }}" class="pp-catmega__tab" data-catmega-tab="tv-trolley-stand">TV Trolley / Stand <span aria-hidden="true">›</span></a>
        <a href="{{ pets_url }}" class="pp-catmega__tab" data-catmega-tab="pets">Pets <span aria-hidden="true">›</span></a>
        <a href="{{ under_url }}" class="pp-catmega__tab" data-catmega-tab="under-50">Under $50 <span aria-hidden="true">›</span></a>
      </aside>

      <div class="pp-catmega__panels">
        <div class="pp-catmega__panel is-active" data-catmega-panel="new-arrival">
          <section class="pp-catmega__col">
            <h3>Shop new</h3>
            <ul>
              <li><a href="{{ new_url }}">Latest arrivals</a></li>
              <li><a href="{{ all_url }}?sort_by=best-selling">Best sellers</a></li>
              <li><a href="{{ under_url }}">Under $50</a></li>
            </ul>
          </section>
          <section class="pp-catmega__col">
            <h3>Categories</h3>
            <ul>
              <li><a href="{{ furniture_url }}">Furniture</a></li>
              <li><a href="{{ tv_url }}">TV Trolley / Stand</a></li>
              <li><a href="{{ home_garden_url }}">Home &amp; Garden</a></li>
              <li><a href="{{ outdoor_garden_url }}">Garden &amp; Outdoor</a></li>
              <li><a href="{{ pets_url }}">Pets</a></li>
            </ul>
          </section>
          <section class="pp-catmega__col">
            <h3>Shop by</h3>
            <ul>
              <li><a href="{{ all_url }}?filter.p.product_type={{ 'Shelves' | url_encode }}">Shelves</a></li>
              <li><a href="{{ all_url }}?filter.p.product_type={{ 'Tables' | url_encode }}">Tables</a></li>
              <li><a href="{{ all_url }}?filter.p.product_type={{ 'Plant stands' | url_encode }}">Plant stands</a></li>
              <li><a href="{{ new_url }}">View all new</a></li>
