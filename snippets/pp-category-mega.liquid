{% doc %}
  "Shop by category" dropdown, built only from the store's own data.

  Categories come from the menu picked in the header's "Shop by category menu"
  setting. When none is set, every collection that has products is listed
  alphabetically (from the global `collections` object). Each panel shows:
  - the category name, its product count and a "Shop all" link
  - the menu item's own sub-links (with product counts) when the menu has them,
    otherwise the collection's real product types (`collection.all_types`) as
    filter links

  @param {linklist} [menu] - Menu whose links are the categories.
{% enddoc %}

{%- liquid
  assign use_menu = false
  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif
  assign max_categories = 12
-%}

{%- capture mega_tabs -%}
  {%- assign tab_count = 0 -%}
  {%- if use_menu -%}
    {%- for link in menu.links -%}
      {%- if tab_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and link.links.size == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign tab_count = tab_count | plus: 1 -%}
      {%- assign tab_key = link.handle | default: link.title | handleize -%}
      <a href="{{ link.url }}" class="pp-catmega__tab{% if tab_count == 1 %} is-active{% endif %}" data-catmega-tab="{{ tab_key | escape }}">{{ link.title | escape }} <span aria-hidden="true">›</span></a>
    {%- endfor -%}
  {%- else -%}
    {%- for collection in collections -%}
      {%- if tab_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if collection.handle == 'frontpage' or collection.handle == 'all' or collection.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign tab_count = tab_count | plus: 1 -%}
      <a href="{{ collection.url }}" class="pp-catmega__tab{% if tab_count == 1 %} is-active{% endif %}" data-catmega-tab="{{ collection.handle | escape }}">{{ collection.title | escape }} <span aria-hidden="true">›</span></a>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture mega_panels -%}
  {%- assign panel_count = 0 -%}
  {%- if use_menu -%}
    {%- for link in menu.links -%}
      {%- if panel_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and link.links.size == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign panel_count = panel_count | plus: 1 -%}
      {%- assign panel_first = false -%}{%- if panel_count == 1 -%}{%- assign panel_first = true -%}{%- endif -%}
      {%- assign panel_key = link.handle | default: link.title | handleize -%}
      {%- assign panel_collection = blank -%}
      {%- if link.type == 'collection_link' -%}{%- assign panel_collection = link.object -%}{%- endif -%}
      {%- render 'pp-category-mega-panel',
        key: panel_key,
        label: link.title,
        url: link.url,
        panel_collection: panel_collection,
        child_links: link.links,
        is_first: panel_first
      -%}
    {%- endfor -%}
  {%- else -%}
    {%- for collection in collections -%}
      {%- if panel_count >= max_categories -%}{%- break -%}{%- endif -%}
      {%- if collection.handle == 'frontpage' or collection.handle == 'all' or collection.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign panel_count = panel_count | plus: 1 -%}
      {%- assign panel_first = false -%}{%- if panel_count == 1 -%}{%- assign panel_first = true -%}{%- endif -%}
      {%- render 'pp-category-mega-panel',
        key: collection.handle,
        label: collection.title,
        url: collection.url,
        panel_collection: collection,
        is_first: panel_first
      -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div class="pp-catmega" id="ppCategoryMega" data-pp-catmega hidden>
  <div class="pp-catmega__surface">
    {%- if tab_count > 0 -%}
      <div class="pp-catmega__body">
        <nav class="pp-catmega__rail" aria-label="Categories">
          {{ mega_tabs }}
        </nav>
        <div class="pp-catmega__panels">
          {{ mega_panels }}
        </div>
      </div>
    {%- else -%}
      <p class="pp-catmega__empty">No categories to show yet.</p>
    {%- endif -%}

    <div class="pp-catmega__foot">
      <p>{% if settings.free_delivery_message != blank %}{{ settings.free_delivery_message | escape }} · {% endif %}30-day returns</p>
      <div class="pp-catmega__foot-links">
        <a href="{{ routes.collections_url }}">All categories <span aria-hidden="true">→</span></a>
        <a href="{{ routes.all_products_collection_url }}">Shop all products <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</div>
