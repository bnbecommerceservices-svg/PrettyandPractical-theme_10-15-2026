{% liquid
  assign variant = product.selected_or_first_available_variant
  assign product_image = product.featured_media.preview_image | default: product.featured_image
  assign has_sale = false
  assign special_badge = blank
  assign special_badge_class = blank
  capture pp_promo
    render 'pp-product-promo', product: product, price: product.price, compare_at: product.compare_at_price_max
  endcapture
  assign pp_promo = pp_promo | strip
  if pp_promo contains '|sale'
    assign has_sale = true
  endif
  if has_sale == false
    if pp_promo contains '|bestseller'
      assign special_badge = section.settings.bestseller_badge_label | default: 'Bestseller'
      assign special_badge_class = ' pp-card__badge--new'
    endif
  endif
  assign can_quick_add = false
  if product.available and product.variants_count == 1 and variant != blank
    assign can_quick_add = true
  endif
  assign product_form_id = 'pp-home-form-' | append: section.id | append: '-' | append: product.id
  assign body_form_id = product_form_id | append: '-body'
%}
<article class="pp-card pp-product-card">
  <div class="pp-card__image">
    {% if has_sale %}
      <span class="pp-card__badge">{{ section.settings.sale_badge_label }}</span>
    {% elsif special_badge != blank %}
      <span class="pp-card__badge{{ special_badge_class }}">{{ special_badge }}</span>
    {% endif %}
    <button type="button" class="pp-card__wishlist" aria-label="Save {{ product.title | escape }} for later" data-pp-wishlist>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
    </button>
    <a href="{{ product.url }}" class="pp-card__image-inner" aria-label="{{ product.title | escape }}">
      {% if product_image != blank %}
        {{ product_image | image_url: width: 720 | image_tag: class: 'pp-card__product-image', widths: '220,320,420,560,720', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 66vw', loading: 'lazy', alt: product.title }}
      {% else %}
        <span class="pp-card__placeholder">Product image</span>
      {% endif %}
    </a>
    {% if can_quick_add %}
      <product-form-component id="pp-home-product-form-{{ section.id }}-{{ product.id }}" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" on:submit="/handleSubmit">
        <div class="sr-only" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {% form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
          <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <add-to-cart-component ref="addToCartButtonContainer" data-product-variant-media="{% if product_image != blank %}{{ product_image | image_url: width: 100 }}{% endif %}" data-add-to-cart-animation="{{ settings.add_to_cart_animation }}">
            <button type="submit" name="add" ref="addToCartButton" on:click="/handleClick" class="pp-card__quickadd">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
              <span class="pp-card__quickadd-label">{{ section.settings.quick_add_label }}</span>
            </button>
          </add-to-cart-component>
        {% endform %}
      </product-form-component>
    {% else %}
      <a href="{{ product.url }}" class="pp-card__quickadd">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        <span class="pp-card__quickadd-label">{{ section.settings.view_product_label }}</span>
      </a>
    {% endif %}
  </div>
  <div class="pp-card__body">
    <h3 class="pp-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% liquid
      assign seller_name = product.vendor | strip
      assign shop_name_l = shop.name | downcase
      assign seller_name_l = seller_name | downcase
    %}
    {% if settings.nexus_show_sold_by and seller_name != blank and seller_name_l != shop_name_l %}
      <p class="pp-card__seller">Sold by {{ seller_name | escape }}</p>
    {% endif %}
    <div class="pp-card__rating">
      {% render 'pp-home-rating', product: product %}
    </div>
    <div class="pp-card__price">
      <span class="pp-card__price-current">{{ product.price | money }}</span>
      {% if has_sale %}
        <span class="pp-card__price-compare">{{ product.compare_at_price_max | money }}</span>
      {% endif %}
    </div>
    <div class="pp-card__cta">
      {% if product.available == false %}
        <span class="pp-card-cta pp-card-cta--soldout">Sold out</span>
      {% elsif can_quick_add %}
        <product-form-component id="pp-home-product-form-body-{{ section.id }}-{{ product.id }}" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" on:submit="/handleSubmit" class="pp-card__quickadd-form pp-card__quickadd-form--body">
          <div class="sr-only" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {% form 'product', product, id: body_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
            <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            {% render 'add-to-cart-button', can_add_to_cart: variant.available, add_to_cart_text: 'Add to cart', product: product, class: 'pp-card-cta' %}
          {% endform %}
        </product-form-component>
      {% else %}
        <a href="{{ product.url }}" class="pp-card-cta">Choose options</a>
      {% endif %}
    </div>
  </div>
</article>
