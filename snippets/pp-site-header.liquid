      {% endunless %}
    {% endfor %}
  {% else %}
    {% for entry in real_categories %}
      {% assign entry_parts = entry | split: '¦' %}
      <div class="pp-drawer__nav-item" role="listitem">
        <a href="{{ entry_parts[1] }}" class="pp-drawer__nav-link pp-drawer-link">
          <span class="pp-drawer-link-content">
            <span class="pp-drawer-link-name">{{ entry_parts[0] | escape }}</span>
          </span>
          <svg class="pp-drawer-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </div>
    {% endfor %}
  {% endif %}
{% endcapture %}
{% assign rendered_drawer_category_links = rendered_drawer_category_links | strip %}

<div class="pp-overlay" id="ppOverlay" aria-hidden="true" role="presentation"></div>
<div class="pp-sheet-overlay" id="ppSheetOverlay" aria-hidden="true" role="presentation"></div>

<header
  class="pp-site-header{% if header_is_sticky %} pp-site-header--sticky{% endif %}"
  id="ppSiteHeader"
  role="banner"
  data-sticky-mode="{{ sticky_mode | escape }}"
>
  <div class="pp-announcement" id="ppAnnouncementTicker" role="complementary" aria-label="Store highlights">
    <div class="pp-announcement__ticker">
      <div class="pp-ticker__track">
        {% for i in (1..6) %}
          <span class="pp-ticker__group"{% if i > 1 %} aria-hidden="true"{% endif %}>
            <span class="pp-ticker__item"><strong>Free delivery</strong> Australia-wide (excl. some remote postcodes)</span>
            <span class="pp-ticker__dot" aria-hidden="true"></span>
            <span class="pp-ticker__item">Get $10 off on your first order</span>
            <span class="pp-ticker__dot" aria-hidden="true"></span>
            <span class="pp-ticker__item">30 day hassle free returns</span>
            <span class="pp-ticker__dot" aria-hidden="true"></span>
          </span>
        {% endfor %}
      </div>
    </div>
    <button type="button" class="pp-announcement__close" id="ppTickerClose" aria-label="Hide announcements">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="pp-header">
    <div class="{{ header_container_class }}">
      <div class="pp-header__inner">
        <button class="pp-mobile-menu-btn" id="ppMobileMenuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="ppMobileDrawer" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <a href="{{ routes.root_url }}" class="pp-logo" aria-label="Pretty & Practical home">
          {% if settings.logo != blank %}
            {{
              settings.logo
              | image_url: width: 420
              | image_tag:
                class: 'pp-logo__image',
                alt: 'Pretty & Practical',
                widths: '160,220,320,420',
                loading: 'lazy'
            }}
          {% else %}
            <span class="pp-logo__mark pp-logo-text">pretty<span class="pp-amp">&amp;</span>practical</span>
          {% endif %}
          <span class="pp-logo__sub pp-logo-subtitle">{{ logo_tagline | default: header_section.settings.logo_tagline | default: "AUSTRALIA'S HOME STORE" | escape }}</span>
        </a>

        {% if rendered_show_search %}
          <predictive-search-component
            class="predictive-search predictive-search--pp-inline"
            data-inline-search
            data-section-id="pp-predictive-search"
            data-results-id="pp-predictive-search-results-{{ header_section.id }}"
            role="search"
            aria-label="{{ 'content.search_input_label' | t }}"
          >
            <form class="predictive-search-form pp-search-wrap" role="search" action="{{ routes.search_url }}" method="get" ref="form" on:keydown="/onSearchKeyDown">
              <label for="ppSearchInput-{{ header_section.id }}" class="sr-only">Search products</label>
              <div class="pp-search-bar">
                <span class="pp-search-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </span>
                <input
                  class="pp-search-input search-input"
                  id="ppSearchInput-{{ header_section.id }}"
                  type="search"
                  name="q"
                  value="{% if request.page_type == 'search' %}{{ search.terms | escape }}{% endif %}"
                  placeholder="{{ fallback_search_placeholder | escape }}"
                  autocomplete="off"
                  autocorrect="off"
                  spellcheck="false"
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="pp-predictive-search-results-{{ header_section.id }}"
                  aria-controls="pp-predictive-search-results-{{ header_section.id }}"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  ref="searchInput"
                  on:input="/search"
                  on:focus="/openInlinePanel"
                  on:click="/openInlinePanel"
                >
                <input
                  name="options[prefix]"
                  type="hidden"
                  value="last"
                >
                <button
                  type="button"
                  class="pp-search-clear"
                  ref="resetButton"
                  hidden
                  on:click="/resetSearch"
                  aria-label="{{ 'actions.clear' | t }}"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
                <button class="pp-search-submit" type="submit" aria-label="{{ search_button_label | default: 'Search' | escape }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <span>{{ search_button_label | default: 'Search' | escape }}</span>
                </button>
              </div>
              <div class="pp-search-dropdown" role="listbox" aria-hidden="true" hidden>
                <div data-predictive-default-panel hidden>
                  <div class="pp-dropdown-section">
                    <p class="pp-dropdown-label">Suggested searches</p>
                    <div class="pp-pill-grid">
                      <button type="button" class="pp-pill" data-term="Linen sofa">Linen sofa</button>
                      <button type="button" class="pp-pill" data-term="Coffee table">Coffee table</button>
                      <button type="button" class="pp-pill" data-term="Outdoor furniture">Outdoor furniture</button>
                      <button type="button" class="pp-pill" data-term="Bedside table">Bedside table</button>
                      <button type="button" class="pp-pill" data-term="Pendant lamp">Pendant lamp</button>
                      <button type="button" class="pp-pill" data-term="Cushions">Cushions</button>
                    </div>
                  </div>
                  {% if rendered_search_dropdown_categories != blank %}
                    <div class="pp-dropdown-divider"></div>
                    <div class="pp-dropdown-section">
                      <p class="pp-dropdown-label">Browse categories</p>
                      <div class="pp-pill-grid">
                        {{ rendered_search_dropdown_categories }}
                      </div>
                    </div>
                  {% endif %}
                </div>
                <div
                  class="predictive-search-form__content"
                  ref="predictiveSearchResults"
                  hidden
                ></div>
                <div class="predictive-search-form__footer" hidden>
                  <button
                    class="pp-view-all"
                    ref="viewAllButton"
                    type="submit"
                    data-default-label="View all results"
                  >
                    <span>
                      <span data-view-all-label>View all results</span>
                      <strong data-view-all-query hidden></strong>
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </button>
                </div>
              </div>
            </form>
          </predictive-search-component>
        {% else %}
          <div class="pp-header__search--empty"></div>
        {% endif %}

        <div class="pp-header__actions" role="navigation" aria-label="Account and cart">
          <button class="pp-mobile-search-btn" id="ppMobileSearchToggle" aria-label="Search" aria-expanded="false" aria-controls="ppMobileSearchPanel" type="button">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
            </svg>
          </button>

          {% if alerts_link != blank %}
            <a href="{{ alerts_link }}" class="pp-action-btn pp-action-btn--desktop" aria-label="{{ alerts_label | escape }}">
              <span aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                  <path d="M13.73 21a2 2 0 01-3.46 0"/>
                </svg>
              </span>
              {% if alerts_badge_text != blank %}
                <span class="pp-badge-dot" aria-hidden="true">{{ alerts_badge_text }}</span>
              {% endif %}
              <span>{{ alerts_label | escape }}</span>
            </a>
          {% endif %}

          <div class="pp-header__account-wrap pp-trigger-wrap" data-account-dropdown>
            <button
              type="button"
              class="pp-action-btn pp-action-btn--desktop pp-header__account pp-account-trigger"
              aria-label="Account menu"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="ppAccountDropdown"
              data-account-dropdown-trigger
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <span class="pp-account-label">Account</span>
            </button>

            <div
              id="ppAccountDropdown"
              class="pp-account-dropdown"
              role="menu"
              aria-label="Account options"
              aria-hidden="true"
              hidden
              data-account-dropdown-panel
            >
              {% if customer %}
                <div class="pp-dropdown-user">
                  <div class="pp-user-avatar" aria-hidden="true">{{ customer_avatar_initials | escape }}</div>
                  <div class="pp-user-info">
                    <span class="pp-user-name">{{ customer_display_name | escape }}</span>
                    <span class="pp-user-email">{{ customer.email | escape }}</span>
                  </div>
                </div>

                <div class="pp-dropdown-divider"></div>

                <nav class="pp-dropdown-links" role="none" aria-label="Account">
                  <a href="{{ routes.account_url }}" class="pp-dropdown-link" role="menuitem">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M16.5 9.4 7.55 4.24"/>
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                      <line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                    My orders
                  </a>
                  <a href="{{ routes.account_addresses_url }}" class="pp-dropdown-link" role="menuitem">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    Addresses
                  </a>
                  <a href="{{ account_help_url }}" class="pp-dropdown-link" role="menuitem">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                    </svg>
                    Help &amp; contact
                  </a>
                </nav>

                <div class="pp-dropdown-divider"></div>

                <a href="{{ routes.account_logout_url }}" class="pp-dropdown-link pp-dropdown-link--danger" role="menuitem">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                  </svg>
                  Sign out
                </a>
              {% else %}
                <div class="pp-dropdown-head">
                  <h3 class="pp-dropdown-title">Welcome</h3>
                  <p class="pp-dropdown-subtext">Sign in for faster checkout and to track your orders.</p>
                </div>

                <div class="pp-dropdown-cta">
                  <a href="{{ routes.account_login_url }}" class="pp-btn-primary" role="menuitem">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                      <polyline points="10 17 15 12 10 7"/>
                      <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Sign in
                  </a>
                  <p class="pp-cta-helper">Sign in with a 6-digit code sent to your email.</p>
                </div>

                <div class="pp-dropdown-divider"></div>

                <nav class="pp-dropdown-links" role="none" aria-label="Quick links">
                  <a href="{{ account_track_order_url }}" class="pp-dropdown-link" role="menuitem">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="1" y="3" width="15" height="13"/>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                    Track an order
                  </a>
                  <a href="{{ account_help_url }}" class="pp-dropdown-link" role="menuitem">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                    </svg>
                    Help &amp; contact
                  </a>
                </nav>
              {% endif %}
            </div>
          </div>

          <a href="{{ wishlist_link }}" class="pp-action-btn pp-action-btn--desktop pp-header__wishlist" data-pp-wishlist-link data-count="0" aria-label="{{ wishlist_label | escape }}">
            {{ 'icon-wishlist.svg' | inline_asset_content }}
            <span class="pp-header__wishlist-label">{{ wishlist_label | escape }}</span>
            <span class="pp-wishlist-count" data-pp-wishlist-count hidden>0</span>
          </a>

          <a
            href="{{ routes.cart_url }}"
            class="pp-cart-btn pp-header__cart pp-header-cart"
            data-count="{{ cart_count }}"
            aria-label="Cart - {{ cart_count }} items"
            {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
              aria-haspopup="dialog"
              aria-controls="cart-drawer-dialog"
              data-cart-drawer-trigger
            {% endif %}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/>
            </svg>
            <span class="pp-header-cart-text">Cart</span>
            <span class="pp-cart-count pp-header-cart-count" aria-label="{{ cart_count }} items in cart">{{ cart_count }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

{% if settings.cart_type == 'drawer' and template.name != 'cart' %}
  {{ 'pp-cart-drawer.css' | asset_url | stylesheet_tag }}
  <script
    src="{{ 'cart-drawer.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {% liquid
    assign cart_discount_threshold_cents = cart_discount_threshold | times: 100
    assign cart_subtotal = cart.items_subtotal_price
    assign cart_discount_remaining = 0
    assign cart_discount_progress = 0
    assign show_cart_discount_progress = false
    assign cart_discount_progress_copy = blank
    assign cart_discount_display_percentage = cart_discount_percentage
    assign cart_discount_remaining_money = blank
    assign cart_discount_remaining_markup = blank

    if cart_discount_display_percentage <= 0 and cart.total_discount > 0 and cart_subtotal > 0
      assign cart_discount_display_percentage = cart.total_discount | times: 100.0 | divided_by: cart_subtotal | round
    endif

    if cart_discount_progress_enabled and cart.total_discount > 0 and cart_subtotal > 0 and cart_discount_display_percentage > 0
      assign show_cart_discount_progress = true
      assign cart_discount_progress = 100
      assign cart_discount_progress_copy = cart_discount_applied_message | replace: '{{ percentage }}', cart_discount_display_percentage
    elsif cart_discount_progress_enabled and cart_discount_threshold_cents > 0 and cart_discount_percentage > 0
      assign show_cart_discount_progress = true
      assign cart_discount_remaining = cart_discount_threshold_cents | minus: cart_subtotal
      if cart_discount_remaining < 0
        assign cart_discount_remaining = 0
      endif
      assign cart_discount_progress = cart_subtotal | times: 100 | divided_by: cart_discount_threshold_cents
      if cart_discount_progress > 100
        assign cart_discount_progress = 100
      endif
      assign cart_discount_remaining_money = cart_discount_remaining | money
      assign cart_discount_remaining_markup = '<span class="pp-cart-drawer__progress-amount">' | append: cart_discount_remaining_money | append: '</span>'
      if cart_subtotal >= cart_discount_threshold_cents
        assign cart_discount_progress_copy = cart_discount_unlocked_message | replace: '{{ percentage }}', cart_discount_percentage
      else
        assign cart_discount_progress_copy = cart_discount_progress_message | replace: '{{ amount }}', cart_discount_remaining_markup | replace: '{{ percentage }}', cart_discount_percentage
      endif
    endif

    capture cart_ship_icon_truck
      echo '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 7h13v10H1zM14 11h5l3 3v3h-8z"/><circle cx="6" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>'
    endcapture

    capture cart_ship_icon_spark
      echo '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>'
    endcapture

    assign cart_ship_label_markup = blank
    if cart_discount_progress_enabled and cart.total_discount > 0 and cart_subtotal > 0 and cart_discount_display_percentage > 0
      assign cart_ship_label_markup = cart_ship_icon_spark | append: '<span>' | append: cart_discount_progress_copy | append: '</span>'
    elsif cart_subtotal >= cart_discount_threshold_cents and cart_discount_threshold_cents > 0
      assign cart_ship_label_markup = cart_ship_icon_spark | append: '<span>You&#39;ve unlocked <strong>FREE delivery</strong>!</span>'
    elsif cart_discount_threshold_cents > 0
      assign cart_ship_label_markup = cart_ship_icon_truck | append: '<span>You&#39;re <strong>' | append: cart_discount_remaining_money | append: '</strong> away from <strong>FREE delivery</strong></span>'
    endif
  %}

  {% capture empty_cart_drawer_content %}
    <header class="pp-cart-header">
      <h2 class="pp-cart-title" id="cart-drawer-heading-empty">Your Cart</h2>
      <span class="pp-cart-count">{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</span>
      <button
        ref="closeButton"
        on:click="cart-drawer-component/close"
        class="pp-cart-close button close-button button-unstyled"
        aria-label="{{ 'actions.close_dialog' | t }}"
        type="button"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    {% if show_cart_discount_progress %}
      <div class="pp-ship-strip">
        <div class="pp-ship-label">{{ cart_ship_label_markup }}</div>
        <div class="pp-ship-track" aria-hidden="true">
          <div
            class="pp-ship-fill"
            style="width: {{ cart_discount_progress }}%;"
          ></div>
        </div>
      </div>
    {% endif %}

    <div class="pp-cart-body" aria-label="{{ 'accessibility.cart' | t }}">
      {% render 'cart-products', force_empty: true, is_drawer: true %}
    </div>
  {% endcapture %}

  <cart-drawer-component
    class="cart-drawer pp-cart-drawer"
    auto-open
  >
    <template id="empty-cart-template">
      {{ empty_cart_drawer_content }}
    </template>

    <div class="pp-cart-overlay" on:click="cart-drawer-component/close" aria-hidden="true"></div>

    <dialog
      ref="dialog"
      id="cart-drawer-dialog"
      class="dialog-modal dialog-drawer pp-cart-drawer__dialog"
      data-testid="cart-drawer-dialog"
      data-scroll-lock-strategy="overlay"
      data-scroll-lock-body-class="pp-cart-drawer-open"
      data-scroll-lock-header-selector="#header-group"
      aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
      scroll-lock
      cart-summary-sticky="false"
    >
      <span ref="liveRegion" class="visually-hidden" role="status"></span>
      <div class="pp-cart-shell" data-hydration-key="cart-drawer-inner">
        {% capture cart_items_children %}
          {% if cart.empty? %}
            {{ empty_cart_drawer_content }}
          {% else %}
            <header class="pp-cart-header">
              <h2 class="pp-cart-title" id="cart-drawer-heading">Your Cart</h2>
              <span class="pp-cart-count">{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</span>
              <button
                ref="closeButton"
                on:click="cart-drawer-component/close"
                class="pp-cart-close button close-button button-unstyled"
                aria-label="{{ 'actions.close_dialog' | t }}"
                type="button"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
              </button>
            </header>

            {% if show_cart_discount_progress %}
              <div class="pp-ship-strip">
                <div class="pp-ship-label">{{ cart_ship_label_markup }}</div>
                <div class="pp-ship-track" aria-hidden="true">
                  <div
                    class="pp-ship-fill"
                    style="width: {{ cart_discount_progress }}%;"
                  ></div>
                </div>
              </div>
            {% endif %}

            <div class="pp-cart-body" aria-label="{{ 'accessibility.cart' | t }}">
              {% render 'cart-products', is_drawer: true %}
            </div>

            <div class="pp-cart-footer">
              {% render 'cart-summary', section_id: header_section.id, is_drawer: true %}
            </div>
          {% endif %}
        {% endcapture %}

        {% render 'cart-items-component', children: cart_items_children, is_drawer: true, section_id: header_section.id %}
      </div>
    </dialog>
  </cart-drawer-component>
{% endif %}

  <div class="pp-mobile-search-panel" id="ppMobileSearchPanel" aria-hidden="true">
    <div class="{{ header_container_class }}">
      <form class="pp-search-form" role="search" action="{{ routes.search_url }}" method="get">
        <label for="ppMobileSearchInput-{{ header_section.id }}" class="sr-only">Search products</label>
        <input
          class="pp-search-form__input"
          id="ppMobileSearchInput-{{ header_section.id }}"
          type="search"
          name="q"
          value="{% if request.page_type == 'search' %}{{ search.terms | escape }}{% endif %}"
          placeholder="{{ fallback_search_placeholder | escape }}"
          autocomplete="off"
        >
        <button class="pp-search-form__btn" type="submit" aria-label="{{ search_button_label | default: 'Search' | escape }}">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
          </svg>
          <span>{{ search_button_label | default: 'Search' | escape }}</span>
        </button>
      </form>
    </div>
