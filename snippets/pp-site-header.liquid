{{ 'pp-header-footer.css' | asset_url | stylesheet_tag }}
{{ 'pp-buttons.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pp-wishlist.js' | asset_url }}" defer></script>
{% render 'predictive-search-styles' %}

{% # theme-check-disable RemoteAsset %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

{% liquid
  assign header_section = header_section | default: section
  assign header_container_class = container_class | default: 'pp-wrap'
  assign cart_discount_progress_enabled = settings.cart_discount_progress_enabled | default: true, allow_false: true
  assign cart_discount_threshold = settings.cart_discount_threshold | plus: 0
  assign cart_discount_percentage = settings.cart_discount_percentage | plus: 0
  assign cart_discount_progress_message = settings.cart_discount_progress_message | default: "You're {{ amount }} away from {{ percentage }}% off"
  assign cart_discount_unlocked_message = settings.cart_discount_unlocked_message | default: '{{ percentage }}% off unlocked'
  assign cart_discount_applied_message = settings.cart_discount_applied_message | default: '{{ percentage }}% off applied'

  assign utility_menu_handle = utility_menu | default: header_section.settings.utility_menu
  assign category_block_items = category_blocks
  assign category_menu_links = blank
  assign sticky_mode = header_section.settings.enable_sticky_header | default: 'always'
  assign header_is_sticky = true
  if sticky_mode == 'none'
    assign header_is_sticky = false
  endif
  # "Shop by category" menu picked in the header settings (a menu object or its handle).
  assign dropdown_menu = category_dropdown_menu
  if dropdown_menu != blank and dropdown_menu.links == blank
    assign dropdown_menu = linklists[dropdown_menu]
  endif
  assign fallback_search_placeholder = search_placeholder | default: header_section.settings.search_placeholder | default: 'Search furniture, home decor, plant stands, pets & more...'
  assign fallback_category_nav_label = category_nav_label | default: header_section.settings.category_nav_label | default: 'Category navigation'
  assign fallback_announcement_label = announcement_label | default: header_section.settings.announcements_label | default: header_section.settings.announcement_label | default: 'Store announcements'
  assign default_announcement_text = 'Get $10 off on your first order'
  assign fallback_announcement_text = announcement_fallback | default: header_section.settings.announcement_fallback | default: default_announcement_text
  if fallback_announcement_text == blank or fallback_announcement_text contains 'translation missing' or fallback_announcement_text == 'content.shipping_policy'
    assign fallback_announcement_text = default_announcement_text
  endif
  if template.name != 'index'
    assign fallback_announcement_label = 'Store announcements'
  endif
  assign rendered_show_search = show_search
  if rendered_show_search == blank
    assign rendered_show_search = header_section.settings.show_search
  endif

  assign alerts_link = header_section.settings.alerts_link
  assign alerts_label = header_section.settings.alerts_label | default: 'Alerts'
  assign alerts_badge_text = header_section.settings.alerts_badge_text

  assign wishlist_link = wishlist_link | default: header_section.settings.wishlist_link
  if wishlist_link == blank
    assign wishlist_link = '/pages/wishlist'
  endif
  assign wishlist_label = wishlist_label | default: header_section.settings.wishlist_label | default: 'Wishlist'

  assign account_url = routes.account_url
  if customer == blank
    assign account_url = routes.account_login_url
  endif
  if account_url == blank
    assign account_url = '/account'
  endif

  assign account_help_url = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us'
  assign account_track_order_url = pages['track-order'].url | default: routes.account_login_url
  assign customer_display_name = blank
  assign customer_avatar_initials = blank
  if customer
    assign customer_display_name = customer.name
    if customer_display_name == blank
      assign customer_display_name = customer.first_name
      if customer.last_name != blank
        if customer_display_name != blank
          assign customer_display_name = customer_display_name | append: ' '
        endif
        assign customer_display_name = customer_display_name | append: customer.last_name
      endif
    endif
    if customer_display_name == blank
      assign customer_display_name = customer.email
    endif

    if customer.first_name != blank
      assign customer_avatar_initials = customer.first_name | slice: 0, 1 | upcase
    endif
    if customer.last_name != blank
      assign customer_avatar_initials_last = customer.last_name | slice: 0, 1 | upcase
      assign customer_avatar_initials = customer_avatar_initials | append: customer_avatar_initials_last
    endif
    if customer_avatar_initials == blank and customer.email != blank
      assign customer_avatar_initials = customer.email | slice: 0, 1 | upcase
    endif
  endif

  assign cart_count = cart.item_count | default: 0

  assign pp_use_menu_mega = false
  # With a "Shop by category" menu, its departments fill the category row and the mobile menu.
  assign use_department_row = false
  if category_blocks == blank or category_blocks.size == 0
    if dropdown_menu != blank and dropdown_menu.links.size > 0
      assign use_department_row = true
      assign category_menu_links = dropdown_menu.links
    elsif category_menu != blank and category_menu.links != blank and category_menu.links.size > 0
      assign category_menu_links = category_menu.links
    elsif category_menu_handle != blank and linklists[category_menu_handle].links != blank and linklists[category_menu_handle].links.size > 0
      assign category_menu_links = linklists[category_menu_handle].links
    endif
  endif

  if use_department_row == false and category_menu_links != blank and category_menu_links.size > 0
    for link in category_menu_links
      if link.links != blank and link.links.size > 0
        assign pp_use_menu_mega = true
      endif
    endfor
  endif
%}

{%- capture real_category_text -%}{%- render 'pp-category-entries', menu: dropdown_menu, limit: 12 -%}{%- endcapture -%}
{%- assign real_categories = real_category_text | strip | split: '§' -%}

{% capture rendered_utility_links %}
  {% if utility_menu_handle != blank and linklists[utility_menu_handle].links.size > 0 %}
    {% for link in linklists[utility_menu_handle].links %}
      <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
    {% endfor %}
  {% elsif utility_links_markup != blank %}
    {{ utility_links_markup }}
  {% endif %}
{% endcapture %}
{% assign rendered_utility_links = rendered_utility_links | strip %}

{% capture rendered_category_links %}
  {% if category_block_items != blank and category_block_items.size > 0 %}
    {% for block in category_block_items %}
      {% liquid
        assign category_url = block.settings.link
        if block.settings.collection != blank
          assign category_url = block.settings.collection.url
        endif
        assign nav_path = category_url | split: '?' | first
        assign nav_is_active = false
        if nav_path != blank and request.path == nav_path
          assign nav_is_active = true
        endif
        assign item_title = block.settings.label | downcase
        assign item_icon = block.settings.icon
        if item_title contains 'furniture'
          assign item_icon = '&#x1FA91;'
        elsif item_title contains 'tv'
          assign item_icon = '&#x1F4FA;'
        elsif item_title contains 'garden'
          assign item_icon = '&#x1F333;'
        elsif item_title contains 'outdoor'
          assign item_icon = '&#x26F0;&#xFE0F;'
        elsif item_title contains 'decor'
          assign item_icon = '&#x1F3E0;'
        elsif item_title contains 'hobby' or item_title contains 'hobbies'
          assign item_icon = '&#x1F9F5;'
        endif
        if item_icon == blank
          if item_title contains 'furniture'
            assign item_icon = '&#x1FA91;'
          elsif item_title contains 'tv'
            assign item_icon = '&#x1F4FA;'
          elsif item_title contains 'garden'
            assign item_icon = '&#x1F333;'
          elsif item_title contains 'outdoor'
            assign item_icon = '&#x26F0;&#xFE0F;'
          elsif item_title contains 'kitchen' or item_title contains 'dining'
            assign item_icon = '&#x1F373;'
          elsif item_title contains 'decor'
            assign item_icon = '&#x1F3E0;'
          elsif item_title contains 'storage' or item_title contains 'organ'
            assign item_icon = '&#x1F5C3;&#xFE0F;'
          elsif item_title contains 'bath'
            assign item_icon = '&#x1F6C1;'
          elsif item_title contains 'baby' or item_title contains 'kids'
            assign item_icon = '&#x1F37C;'
          elsif item_title contains 'toy' or item_title contains 'game'
            assign item_icon = '&#x1F3AE;'
          elsif item_title contains 'hobby' or item_title contains 'hobbies'
            assign item_icon = '&#x1F9F5;'
          elsif item_title contains 'sport'
            assign item_icon = '&#x26BD;'
          elsif item_title contains 'pet'
            assign item_icon = '&#x1F43E;'
          elsif item_title contains 'lighting' or item_title contains 'light'
            assign item_icon = '&#x1F4A1;'
          elsif item_title contains 'bedding' or item_title contains 'bed'
            assign item_icon = '&#x1F6CF;&#xFE0F;'
          elsif item_title contains 'sale' or item_title contains 'clearance'
            assign item_icon = '&#x1F3F7;&#xFE0F;'
          else
            assign item_icon = '&#x2726;'
          endif
        endif
      %}
      {% liquid
        assign block_is_sale = false
        if item_title contains 'sale' or item_title contains 'clearance'
          assign block_is_sale = true
        endif
        assign block_handle = block.settings.label | handleize
        assign block_mega_id = 'ppMegaMenu-' | append: header_section.id | append: '-' | append: block.id
        assign block_attrs = block.shopify_attributes
      %}
      {% unless block_handle == 'outdoor' %}
      {% if category_url != blank %}
        {% render 'pp-nav-mega-item',
          category_label: block.settings.label,
          category_url: category_url,
          item_icon: item_icon,
          item_handle: block_handle,
          menu_id: block_mega_id,
          is_active: nav_is_active,
          is_sale: block_is_sale,
          shopify_attributes: block_attrs
        %}
      {% else %}
        <span
          class="pp-nav-link{% if nav_is_active %} is-active{% endif %}{% if block_is_sale %} pp-nav-link--sale{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </span>
      {% endif %}
      {% endunless %}
    {% endfor %}
  {% elsif use_department_row == false and category_menu_links != blank and category_menu_links.size > 0 %}
    {% for link in category_menu_links %}
      {% liquid
        assign loop_handle = link.title | handleize
      %}
      {% unless loop_handle == 'outdoor' %}
        {% if link.url != blank or link.links != blank %}
          {% render 'pp-nav-shop-item', link: link %}
        {% endif %}
      {% endunless %}
    {% endfor %}
  {% else %}
    {% for entry in real_categories limit: 8 %}
      {% liquid
        assign entry_parts = entry | split: '¦'
        assign entry_url = entry_parts[1]
        assign entry_active = false
        if request.path == entry_url or entry_parts[3] == 'active'
          assign entry_active = true
        endif
        assign mega_menu_id = 'ppMegaMenu-' | append: header_section.id | append: '-' | append: entry_parts[2]
      %}
      {% render 'pp-nav-mega-item',
        category_label: entry_parts[0],
        category_url: entry_url,
        item_handle: entry_parts[2],
        menu_id: mega_menu_id,
        is_active: entry_active
      %}
    {% endfor %}
  {% endif %}
{% endcapture %}
{% assign rendered_category_links = rendered_category_links | strip %}

{% capture rendered_search_dropdown_categories %}
  {% for entry in real_categories limit: 4 %}
    {% assign entry_parts = entry | split: '¦' %}
    <a href="{{ entry_parts[1] }}" class="pp-pill pp-pill--cat">{{ entry_parts[0] | escape }}</a>
  {% endfor %}
{% endcapture %}
{% assign rendered_search_dropdown_categories = rendered_search_dropdown_categories | strip %}

{% assign drawer_subpanel_count = 0 %}
{% capture drawer_subpanel_data_json %}
  [
    {% if category_menu_links != blank and category_menu_links.size > 0 %}
      {% for link in category_menu_links %}
        {% liquid
          assign drawer_json_key = link.title | handleize
        %}
        {% if drawer_json_key != 'outdoor' and link.links != blank and link.links.size > 0 %}
          {% if drawer_subpanel_count > 0 %},{% endif %}
          {
            "key": {{ link.title | handleize | json }},
            "name": {{ link.title | json }},
            "url": {{ link.url | json }},
            "items": [
              {% for child_link in link.links %}
                {% if forloop.index0 > 0 %},{% endif %}
                {
                  "name": {{ child_link.title | json }},
                  "url": {{ child_link.url | json }}
                }
              {% endfor %}
            ]
          }
          {% assign drawer_subpanel_count = drawer_subpanel_count | plus: 1 %}
        {% endif %}
      {% endfor %}
    {% endif %}
  ]
{% endcapture %}
{% assign drawer_subpanel_data_json = drawer_subpanel_data_json | strip %}

{% capture rendered_drawer_category_links %}
  {% if category_block_items != blank and category_block_items.size > 0 %}
    {% for block in category_block_items %}
      {% liquid
        assign category_url = block.settings.link
        if block.settings.collection != blank
          assign category_url = block.settings.collection.url
        endif
        assign nav_path = category_url | split: '?' | first
        assign nav_is_active = false
        if nav_path != blank and request.path == nav_path
          assign nav_is_active = true
        endif
        assign item_title = block.settings.label | downcase
        assign item_icon = block.settings.icon
        if item_title contains 'furniture'
          assign item_icon = '&#x1FA91;'
        elsif item_title contains 'tv'
          assign item_icon = '&#x1F4FA;'
        elsif item_title contains 'garden'
          assign item_icon = '&#x1F333;'
        elsif item_title contains 'outdoor'
          assign item_icon = '&#x26F0;&#xFE0F;'
        elsif item_title contains 'decor'
          assign item_icon = '&#x1F3E0;'
        elsif item_title contains 'hobby' or item_title contains 'hobbies'
          assign item_icon = '&#x1F9F5;'
        endif
        if item_icon == blank
          if item_title contains 'furniture'
            assign item_icon = '&#x1FA91;'
          elsif item_title contains 'tv'
            assign item_icon = '&#x1F4FA;'
          elsif item_title contains 'garden'
            assign item_icon = '&#x1F333;'
          elsif item_title contains 'outdoor'
            assign item_icon = '&#x26F0;&#xFE0F;'
          elsif item_title contains 'kitchen' or item_title contains 'dining'
            assign item_icon = '&#x1F373;'
          elsif item_title contains 'decor'
            assign item_icon = '&#x1F3E0;'
          elsif item_title contains 'storage' or item_title contains 'organ'
            assign item_icon = '&#x1F5C3;&#xFE0F;'
          elsif item_title contains 'bath'
            assign item_icon = '&#x1F6C1;'
          elsif item_title contains 'baby' or item_title contains 'kids'
            assign item_icon = '&#x1F37C;'
          elsif item_title contains 'toy' or item_title contains 'game'
            assign item_icon = '&#x1F3AE;'
          elsif item_title contains 'hobby' or item_title contains 'hobbies'
            assign item_icon = '&#x1F9F5;'
          elsif item_title contains 'sport'
            assign item_icon = '&#x26BD;'
          elsif item_title contains 'pet'
            assign item_icon = '&#x1F43E;'
          elsif item_title contains 'lighting' or item_title contains 'light'
            assign item_icon = '&#x1F4A1;'
          elsif item_title contains 'bedding' or item_title contains 'bed'
            assign item_icon = '&#x1F6CF;&#xFE0F;'
          elsif item_title contains 'sale' or item_title contains 'clearance'
            assign item_icon = '&#x1F3F7;&#xFE0F;'
          else
            assign item_icon = '&#x2726;'
          endif
        endif
        assign drawer_block_handle = block.settings.label | handleize
      %}
      {% unless drawer_block_handle == 'outdoor' %}
      <div class="pp-drawer__nav-item" role="listitem">
        {% if item_title contains 'sale' or item_title contains 'clearance' %}
          <a href="{{ category_url | default: '/collections/sale' }}" class="pp-drawer__nav-link pp-drawer-link pp-drawer-link--sale" {{ block.shopify_attributes }}>
            <span class="pp-drawer-link-content">
              <span class="pp-drawer-link-name">{{ block.settings.label | escape }}</span>
            </span>
          </a>
        {% else %}
          <a href="{{ category_url | default: routes.all_products_collection_url }}" class="pp-drawer__nav-link pp-drawer-link" {{ block.shopify_attributes }}>
            <span class="pp-drawer-link-content">
              <span class="pp-drawer-link-name">{{ block.settings.label | escape }}</span>
            </span>
            <svg class="pp-drawer-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </a>
        {% endif %}
      </div>
      {% endunless %}
    {% endfor %}
  {% elsif category_menu_links != blank and category_menu_links.size > 0 %}
    {% for link in category_menu_links %}
      {% liquid
        assign item_title = link.title | downcase
        if item_title contains 'furniture'
          assign item_icon = '&#x1FA91;'
        elsif item_title contains 'tv'
          assign item_icon = '&#x1F4FA;'
        elsif item_title contains 'garden'
          assign item_icon = '&#x1F333;'
        elsif item_title contains 'outdoor'
          assign item_icon = '&#x26F0;&#xFE0F;'
        elsif item_title contains 'kitchen' or item_title contains 'dining'
          assign item_icon = '&#x1F373;'
        elsif item_title contains 'decor'
          assign item_icon = '&#x1F3E0;'
        elsif item_title contains 'storage' or item_title contains 'organ'
          assign item_icon = '&#x1F5C3;&#xFE0F;'
        elsif item_title contains 'bath'
          assign item_icon = '&#x1F6C1;'
        elsif item_title contains 'baby' or item_title contains 'kids'
          assign item_icon = '&#x1F37C;'
        elsif item_title contains 'toy' or item_title contains 'game'
          assign item_icon = '&#x1F3AE;'
        elsif item_title contains 'hobby' or item_title contains 'hobbies'
          assign item_icon = '&#x1F9F5;'
        elsif item_title contains 'sport'
          assign item_icon = '&#x26BD;'
        elsif item_title contains 'pet'
          assign item_icon = '&#x1F43E;'
        elsif item_title contains 'lighting' or item_title contains 'light'
          assign item_icon = '&#x1F4A1;'
        elsif item_title contains 'bedding' or item_title contains 'bed'
          assign item_icon = '&#x1F6CF;&#xFE0F;'
        elsif item_title contains 'sale' or item_title contains 'clearance'
          assign item_icon = '&#x1F3F7;&#xFE0F;'
        else
          assign item_icon = '&#x2726;'
        endif
        assign drawer_url = link.url | default: routes.all_products_collection_url
        assign drawer_key = link.title | handleize
      %}
      {% unless drawer_key == 'outdoor' %}
      <div class="pp-drawer__nav-item" role="listitem">
        {% if item_title contains 'sale' or item_title contains 'clearance' %}
          <a href="{{ drawer_url | default: '/collections/sale' }}" class="pp-drawer__nav-link pp-drawer-link pp-drawer-link--sale">
            <span class="pp-drawer-link-content">
              <span class="pp-drawer-link-name">{{ link.title | escape }}</span>
            </span>
          </a>
        {% elsif link.links != blank and link.links.size > 0 %}
          <button type="button" class="pp-drawer__nav-link pp-drawer-link" data-category="{{ link.title | handleize | escape }}">
            <span class="pp-drawer-link-content">
              <span class="pp-drawer-link-name">{{ link.title | escape }}</span>
            </span>
            <svg class="pp-drawer-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        {% else %}
          <a href="{{ drawer_url }}" class="pp-drawer__nav-link pp-drawer-link">
            <span class="pp-drawer-link-content">
              <span class="pp-drawer-link-name">{{ link.title | escape }}</span>
            </span>
            <svg class="pp-drawer-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </a>
