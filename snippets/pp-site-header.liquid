<script>
  (function () {
    'use strict';

    const headerGroup = document.getElementById('header-group');
    const overlay = document.getElementById('ppOverlay');
    const sheetOverlay = document.getElementById('ppSheetOverlay');
    const drawer = document.getElementById('ppMobileDrawer');
    const drawerClose = document.getElementById('ppDrawerClose');
    const menuToggle = document.getElementById('ppMobileMenuToggle');
    const mobileSearchToggle = document.getElementById('ppMobileSearchToggle');
    const mobileSearchPanel = document.getElementById('ppMobileSearchPanel');
    const mobileSearchInput = document.getElementById('ppMobileSearchPanel')?.querySelector('input[type="search"]');
    const accountTrigger = document.querySelector('.pp-account-trigger');
    const accountDropdownPanel = document.getElementById('ppAccountDropdown');
    const accountSheet = document.getElementById('ppAccountSheet');
    const accountSheetClose = document.getElementById('ppAccountSheetClose');
    const siteHeader = document.getElementById('ppSiteHeader');
    const drawerCategories = drawer?.querySelector('[data-drawer-categories]');
    const drawerSubpanel = drawer?.querySelector('[data-subpanel]');
    const drawerSubpanelTitle = drawer?.querySelector('[data-subpanel-title]');
    const drawerSubpanelList = drawer?.querySelector('[data-subpanel-list]');
    const drawerSubpanelViewAll = drawer?.querySelector('[data-subpanel-viewall]');
    const drawerSubpanelBack = drawer?.querySelector('.pp-subpanel-back');
    const drawerSubpanelDataElement = document.getElementById('ppDrawerSubpanelData');
    const categoryNav = document.querySelector('[data-pp-category-nav]');
    const categoryMega = document.querySelector('[data-pp-catmega]');
    const categoryMegaTrigger = document.querySelector('[data-catmega-trigger]');
    const stickyMode = siteHeader?.getAttribute('data-sticky-mode') || 'always';
    let accountSheetTouchStartY = 0;
    let accountSheetTouchCurrentY = 0;
    let isDraggingAccountSheet = false;
    let drawerSubpanelData = [];
    if (drawerSubpanelDataElement) {
      try {
        drawerSubpanelData = JSON.parse(drawerSubpanelDataElement.textContent || '[]');
      } catch (error) {
        drawerSubpanelData = [];
      }
    }
    const drawerSubpanelMap = drawerSubpanelData.reduce(function (accumulator, item) {
      if (item && item.key) {
        accumulator[item.key] = item;
      }
      return accumulator;
    }, {});

    function isMobileViewport() {
      return window.innerWidth < 768;
    }

    function updateLockedHeaderHeight() {
      if (!(headerGroup instanceof HTMLElement)) return;
      document.documentElement.style.setProperty('--pp-header-group-height', Math.round(headerGroup.offsetHeight) + 'px');
    }

    if (stickyMode !== 'none' && headerGroup instanceof HTMLElement) {
      headerGroup.classList.add('pp-header-group--locked');
      document.body.classList.add('pp-header-locked');
      updateLockedHeaderHeight();

      if (typeof ResizeObserver === 'function') {
        const headerGroupResizeObserver = new ResizeObserver(function () {
          updateLockedHeaderHeight();
        });
        headerGroupResizeObserver.observe(headerGroup);
      }

      window.addEventListener('resize', updateLockedHeaderHeight);
      window.addEventListener('load', updateLockedHeaderHeight);
    }

    let megaCloseTimer = 0;
    let megaOpenedAt = 0;
    const firstCategoryKey = categoryMega?.querySelector('[data-catmega-tab]')?.getAttribute('data-catmega-tab') || '';

    function setCategoryPanel(key) {
      if (!(categoryMega instanceof HTMLElement) || !key) return;
      categoryMega.querySelectorAll('[data-catmega-tab]').forEach(function (tab) {
        tab.classList.toggle('is-active', tab.getAttribute('data-catmega-tab') === key);
      });
      categoryMega.querySelectorAll('[data-catmega-panel]').forEach(function (panel) {
        const isActive = panel.getAttribute('data-catmega-panel') === key;
        panel.classList.toggle('is-active', isActive);
        if (isActive) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });
      if (categoryNav instanceof HTMLElement) {
        categoryNav.querySelectorAll('[data-catmega-open]').forEach(function (link) {
          link.classList.toggle('is-mega-current', link.getAttribute('data-catmega-open') === key);
        });
      }
    }

    function openCategoryMega(key) {
      if (window.innerWidth < 769 || !(categoryMega instanceof HTMLElement) || !(categoryNav instanceof HTMLElement)) return;
      window.clearTimeout(megaCloseTimer);
      if (categoryMega.hidden) megaOpenedAt = Date.now();
      categoryMega.hidden = false;
      categoryNav.classList.add('is-mega-open');
      if (categoryMegaTrigger instanceof HTMLElement) {
        categoryMegaTrigger.setAttribute('aria-expanded', 'true');
      }
      if (key) setCategoryPanel(key);
    }

    function closeCategoryMega() {
      if (!(categoryMega instanceof HTMLElement) || !(categoryNav instanceof HTMLElement)) return;
      categoryMega.hidden = true;
      categoryNav.classList.remove('is-mega-open');
      if (categoryMegaTrigger instanceof HTMLElement) {
        categoryMegaTrigger.setAttribute('aria-expanded', 'false');
      }
      categoryNav.querySelectorAll('[data-catmega-open]').forEach(function (link) {
        link.classList.remove('is-mega-current');
      });
    }

    function scheduleCategoryMegaClose() {
      window.clearTimeout(megaCloseTimer);
      megaCloseTimer = window.setTimeout(closeCategoryMega, 160);
    }

    if (categoryNav instanceof HTMLElement && categoryMega instanceof HTMLElement) {
      categoryNav.addEventListener('mouseenter', function () {
        if (window.innerWidth < 769) return;
        window.clearTimeout(megaCloseTimer);
      });
      categoryNav.addEventListener('mouseleave', function () {
        scheduleCategoryMegaClose();
      });

      if (categoryMegaTrigger instanceof HTMLElement) {
        categoryMegaTrigger.addEventListener('mouseenter', function () {
          openCategoryMega(firstCategoryKey);
        });
        categoryMegaTrigger.addEventListener('click', function (event) {
          event.preventDefault();
          // Hovering the button opens the dropdown, so a click straight after that keeps it open.
          const justOpened = Date.now() - megaOpenedAt < 600;
          if (categoryNav.classList.contains('is-mega-open') && !justOpened) closeCategoryMega();
          else openCategoryMega(firstCategoryKey);
        });
      }

      categoryNav.querySelectorAll('[data-catmega-open]').forEach(function (link) {
        link.addEventListener('mouseenter', function () {
          openCategoryMega(link.getAttribute('data-catmega-open'));
        });
      });

      categoryMega.querySelectorAll('[data-catmega-tab]').forEach(function (tab) {
        tab.addEventListener('mouseenter', function () {
          openCategoryMega(tab.getAttribute('data-catmega-tab'));
        });
      });

      categoryNav.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeCategoryMega();
      });
    }

    document.querySelectorAll('.pp-mega-group').forEach(function (group) {
      const menu = group.querySelector('.pp-mega-menu');
      if (!(menu instanceof HTMLElement)) return;

      function placeDropdown() {
        menu.style.left = '0px';
        const edge = 16;
        const rect = menu.getBoundingClientRect();
        const overflowRight = rect.right - (window.innerWidth - edge);
        if (overflowRight > 0) {
          menu.style.left = -Math.ceil(overflowRight) + 'px';
        }
        const left = menu.getBoundingClientRect().left;
        if (left < edge) {
          menu.style.left = Math.round(edge - group.getBoundingClientRect().left) + 'px';
        }
      }

      group.addEventListener('mouseenter', placeDropdown);
      group.addEventListener('focusin', placeDropdown);
    });

    function openDrawer() {
      if (!drawer || !overlay || !menuToggle) return;
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      setTimeout(() => drawerClose && drawerClose.focus(), 50);
    }

    function closeDrawer() {
      if (!drawer || !overlay || !menuToggle) return;
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.dispatchEvent(new CustomEvent('drawer:close'));
      menuToggle.focus();
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function openDrawerSubpanel(catKey) {
      const data = drawerSubpanelMap[catKey];
      if (!data || !(drawerCategories instanceof HTMLElement) || !(drawerSubpanel instanceof HTMLElement) || !(drawerSubpanelTitle instanceof HTMLElement) || !(drawerSubpanelList instanceof HTMLElement) || !(drawerSubpanelViewAll instanceof HTMLAnchorElement)) return;
      drawerSubpanelTitle.textContent = data.name;
      drawerSubpanelViewAll.href = data.url || '#';
      const viewAllText = drawerSubpanelViewAll.querySelector('span');
      if (viewAllText) {
        viewAllText.textContent = 'View all ' + data.name;
      }
      drawerSubpanelList.innerHTML = data.items.map(function (item) {
        return '<a href="' + escapeHtml(item.url || '#') + '" class="pp-subpanel-item"><span>' + escapeHtml(item.name || '') + '</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></a>';
      }).join('');
      drawerSubpanel.removeAttribute('hidden');
      requestAnimationFrame(function () {
        drawerCategories.classList.add('is-pushed');
        drawerSubpanel.classList.add('is-open');
      });
    }

    function closeDrawerSubpanel() {
      if (!(drawerCategories instanceof HTMLElement) || !(drawerSubpanel instanceof HTMLElement)) return;
      drawerCategories.classList.remove('is-pushed');
      drawerSubpanel.classList.remove('is-open');
      setTimeout(function () {
        drawerSubpanel.setAttribute('hidden', '');
      }, 280);
    }

    function closeDesktopAccountDropdown() {
      if (!(accountTrigger instanceof HTMLElement) || !(accountDropdownPanel instanceof HTMLElement)) return;
      accountDropdownPanel.classList.remove('is-open');
      accountDropdownPanel.setAttribute('aria-hidden', 'true');
      accountDropdownPanel.setAttribute('hidden', '');
      accountTrigger.setAttribute('aria-expanded', 'false');
    }

    function openAccountSheet() {
      if (!(accountSheet instanceof HTMLElement) || !(sheetOverlay instanceof HTMLElement)) return;
      closeDesktopAccountDropdown();
      accountSheet.removeAttribute('aria-hidden');
      sheetOverlay.removeAttribute('aria-hidden');
      requestAnimationFrame(function () {
        accountSheet.classList.add('is-open');
        sheetOverlay.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeAccountSheet() {
      if (!(accountSheet instanceof HTMLElement) || !(sheetOverlay instanceof HTMLElement)) return;
      accountSheet.classList.remove('is-open');
      sheetOverlay.classList.remove('is-open');
      accountSheet.style.transform = '';
      accountSheet.setAttribute('aria-hidden', 'true');
      sheetOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function openMobileSearch() {
      if (!mobileSearchPanel || !mobileSearchToggle) return;
      mobileSearchPanel.classList.add('is-open');
      mobileSearchPanel.setAttribute('aria-hidden', 'false');
      mobileSearchToggle.setAttribute('aria-expanded', 'true');
      setTimeout(() => mobileSearchInput && mobileSearchInput.focus(), 60);
    }

    function closeMobileSearch() {
      if (!mobileSearchPanel || !mobileSearchToggle) return;
      mobileSearchPanel.classList.remove('is-open');
      mobileSearchPanel.setAttribute('aria-hidden', 'true');
      mobileSearchToggle.setAttribute('aria-expanded', 'false');
    }

    if (menuToggle) menuToggle.addEventListener('click', openDrawer);
    if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);
    if (mobileSearchToggle) {
      mobileSearchToggle.addEventListener('click', function () {
        if (mobileSearchPanel && mobileSearchPanel.classList.contains('is-open')) {
          closeMobileSearch();
        } else {
          openMobileSearch();
        }
      });
    }

    if (accountTrigger) {
      accountTrigger.addEventListener('click', function (event) {
        if (!isMobileViewport()) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        if (accountSheet && accountSheet.classList.contains('is-open')) {
          closeAccountSheet();
        } else {
          openAccountSheet();
        }
      }, true);
    }

    if (accountSheetClose) {
      accountSheetClose.addEventListener('click', closeAccountSheet);
    }

    if (sheetOverlay) {
      sheetOverlay.addEventListener('click', closeAccountSheet);
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeMegaGroups();
        if (drawer && drawer.classList.contains('is-open')) closeDrawer();
        if (mobileSearchPanel && mobileSearchPanel.classList.contains('is-open')) closeMobileSearch();
        if (accountSheet && accountSheet.classList.contains('is-open')) closeAccountSheet();
      }
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth < 990) closeMegaGroups();
      if (!isMobileViewport()) closeAccountSheet();
    });

    if (drawer) {
      drawer.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab') return;
        const focusable = drawer.querySelectorAll('a, button, input, [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;
        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }

    document.querySelectorAll('.pp-drawer__nav-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const targetId = btn.getAttribute('data-target');
        const sub = document.getElementById(targetId);
        if (!sub) return;
        const isOpen = sub.classList.toggle('is-open');
        btn.classList.toggle('is-open', isOpen);
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });

    if (drawer) {
      drawer.querySelectorAll('.pp-drawer-link[data-category]').forEach(function (btn) {
        btn.addEventListener('click', function (event) {
          event.preventDefault();
          const catKey = btn.getAttribute('data-category');
          if (catKey) {
            openDrawerSubpanel(catKey);
          }
        });
      });
    }

    if (drawerSubpanelBack) {
      drawerSubpanelBack.addEventListener('click', closeDrawerSubpanel);
    }

    document.addEventListener('drawer:close', closeDrawerSubpanel);

    if (accountSheet instanceof HTMLElement) {
      accountSheet.addEventListener('touchstart', function (event) {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest('.pp-sheet-handle')) return;
        accountSheetTouchStartY = event.touches[0].clientY;
        accountSheetTouchCurrentY = accountSheetTouchStartY;
        isDraggingAccountSheet = true;
      }, { passive: true });

      accountSheet.addEventListener('touchmove', function (event) {
        if (!isDraggingAccountSheet) return;
        accountSheetTouchCurrentY = event.touches[0].clientY;
        const diff = accountSheetTouchCurrentY - accountSheetTouchStartY;
        if (diff > 0) {
          accountSheet.style.transform = 'translateY(' + diff + 'px)';
        }
      }, { passive: true });

      accountSheet.addEventListener('touchend', function () {
        if (!isDraggingAccountSheet) return;
        const diff = accountSheetTouchCurrentY - accountSheetTouchStartY;
        accountSheet.style.transform = '';
        if (diff > 80) {
          closeAccountSheet();
        }
        isDraggingAccountSheet = false;
      });
    }

    function updatePrettyCartCount(count) {
      const safeCount = Number.isFinite(Number(count)) ? Number(count) : 0;
      document.querySelectorAll('.pp-header-cart-count').forEach(function (cartCount) {
        cartCount.textContent = safeCount;
        cartCount.setAttribute('aria-label', safeCount + ' item' + (safeCount === 1 ? '' : 's') + ' in cart');
      });
      document.querySelectorAll('.pp-cart-btn').forEach(function (cartButton) {
        cartButton.setAttribute('aria-label', 'Cart - ' + safeCount + ' item' + (safeCount === 1 ? '' : 's'));
        if (cartButton.classList.contains('pp-header__cart')) {
          cartButton.setAttribute('data-count', String(safeCount));
        }
      });
    }

    function unlockPageAfterCart() {
      document.documentElement.style.overflow = '';
      document.documentElement.removeAttribute('scroll-lock');
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.style.paddingRight = '';
      document.body.classList.remove('pp-cart-drawer-open');
      const headerGroup = document.querySelector('#header-group');
      if (headerGroup) headerGroup.style.paddingRight = '';
    }

    document.addEventListener('dialog:close', unlockPageAfterCart);
    document.addEventListener('click', function (event) {
      if (event.target.closest('[data-pp-lightbox-close], .pp-cart-overlay, .pp-cart-close')) {
        window.setTimeout(unlockPageAfterCart, 50);
        window.setTimeout(unlockPageAfterCart, 400);
      }
    });

    const cartDrawer = document.querySelector('cart-drawer-component');
    const cartDrawerTrigger = document.querySelector('[data-cart-drawer-trigger]');
    if (cartDrawer instanceof HTMLElement && cartDrawerTrigger instanceof HTMLAnchorElement) {
      cartDrawerTrigger.addEventListener('click', function (event) {
        if (
          event.defaultPrevented ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          event.button !== 0
        ) {
          return;
        }

        if (typeof cartDrawer.open !== 'function') {
          return;
        }

        event.preventDefault();
        cartDrawer.open();
      });
    }

    function refreshPrettyCartCount() {
      fetch('{{ routes.cart_url }}.js', { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Cart count refresh failed');
          return response.json();
        })
        .then(function (cart) {
          if (cart && cart.item_count !== undefined) updatePrettyCartCount(cart.item_count);
        })
        .catch(function () {});
    }

    document.addEventListener('cart:update', function (event) {
      const cartCount = event.detail?.resource?.item_count;
      if (cartCount !== undefined) {
        updatePrettyCartCount(cartCount);
      } else {
        refreshPrettyCartCount();
      }
    });

    document.addEventListener('submit', function (event) {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      const action = form.getAttribute('action') || '';
      if (!action.includes('/cart/add')) return;
      window.setTimeout(refreshPrettyCartCount, 350);
      window.setTimeout(refreshPrettyCartCount, 1000);
    }, true);

    refreshPrettyCartCount();

    if (siteHeader) {
      let ticking = false;
      window.addEventListener('scroll', function () {
        if (ticking) return;
        requestAnimationFrame(function () {
          if (window.scrollY > 4) {
            siteHeader.style.boxShadow = '0 4px 18px rgb(0 0 0 / .1)';
          } else {
            siteHeader.style.boxShadow = '';
          }
          ticking = false;
        });
        ticking = true;
      }, { passive: true });
    }
  })();
</script>
