<script>
  (function () {
    var bar = document.getElementById('ppAnnouncementTicker');
    var btn = document.getElementById('ppTickerClose');
    if (!bar || !btn) return;
    try { window.localStorage.removeItem('pp-ticker-hidden'); } catch (error) {}
    btn.addEventListener('click', function () {
      bar.hidden = true;
    });

    var track = bar.querySelector('.pp-ticker__track');
    var tickerViewport = bar.querySelector('.pp-announcement__ticker');
    if (track && tickerViewport) {
      var firstGroup = track.querySelector('.pp-ticker__group');
      if (firstGroup) {
        var fillTicker = function () {
          var safety = 0;
          while (track.scrollWidth < tickerViewport.offsetWidth * 2 && safety < 24) {
            var clone = firstGroup.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            track.appendChild(clone);
            safety += 1;
          }
          if (track.querySelectorAll('.pp-ticker__group').length % 2 === 1) {
            var extra = firstGroup.cloneNode(true);
            extra.setAttribute('aria-hidden', 'true');
            track.appendChild(extra);
          }
          var distance = track.scrollWidth / 2;
          if (distance > 0) {
            track.style.animationDuration = Math.max(40, Math.round(distance / 18)) + 's';
          }
        };
        fillTicker();
        window.addEventListener('resize', fillTicker);
      }
    }
  })();
</script>

