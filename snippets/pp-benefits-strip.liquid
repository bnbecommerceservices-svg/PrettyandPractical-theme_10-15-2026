{% doc %}
Shopping benefits strip (shipping, returns, secure checkout, brand) shown above the
footer on every page. Rendered by pp-site-footer so it picks up the footer's design tokens.
{% enddoc %}

<section class="pp-benefits" aria-label="Shopping benefits">
  <div class="pp-wrap">
    <div class="pp-benefits__grid">
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </span>
        <div class="pp-benefits__copy">
          <h3>Australia wide shipping</h3>
          <p>Fast, tracked delivery to your door.</p>
        </div>
      </div>
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </span>
        <div class="pp-benefits__copy">
          <h3>30 day returns</h3>
          <p>Easy returns on unused items.</p>
        </div>
      </div>
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <div class="pp-benefits__copy">
          <h3>Secure checkout</h3>
          <p>Encrypted payments you can trust.</p>
        </div>
      </div>
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </span>
        <div class="pp-benefits__copy">
          <h3>Pretty &amp; Practical</h3>
          <p>Designed for beautiful, everyday living.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .pp-site-footer .pp-benefits {
    padding: 40px 0 56px;
    background: #fff;
  }

  .pp-site-footer .pp-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .pp-site-footer .pp-benefits__item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 92px;
    padding: 16px 18px;
    border: 1px solid var(--pp-border);
    border-radius: 16px;
    background: #fff;
  }

  .pp-site-footer .pp-benefits__icon {
    flex-shrink: 0;
    display: inline-flex;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    margin: 0;
    border-radius: 50%;
    background: #fff1ec;
    color: var(--pp-primary);
    box-shadow: inset 0 0 0 1px rgb(232 83 42 / 0.12);
  }

  .pp-site-footer .pp-benefits__icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .pp-site-footer .pp-benefits__copy {
    min-width: 0;
  }

  .pp-site-footer .pp-benefits__item h3 {
    font-family: var(--pp-font-heading);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pp-navy);
    margin: 0 0 4px;
  }

  .pp-site-footer .pp-benefits__item p {
    margin: 0;
    font-size: 13px;
    color: var(--pp-text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 1100px) {
    .pp-site-footer .pp-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .pp-site-footer .pp-benefits__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}
