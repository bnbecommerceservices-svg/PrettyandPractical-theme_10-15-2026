{% doc %}
Shopping benefits strip (shipping, returns, secure checkout, support) shown above the
footer on every page. Rendered by pp-site-footer so it picks up the footer's design tokens.
{% enddoc %}

<section class="pp-benefits" aria-label="Shopping benefits">
  <div class="pp-wrap">
    <div class="pp-benefits__grid">
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          {% render 'pp-icon-3d', icon: 'truck', uid: 'foot-truck' %}
        </span>
        <div class="pp-benefits__copy">
          <h3>{{ settings.free_delivery_title | escape }}</h3>
          <p>{{ settings.free_delivery_detail | escape }}</p>
        </div>
      </div>
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          {% render 'pp-icon-3d', icon: 'returns', uid: 'foot-returns' %}
        </span>
        <div class="pp-benefits__copy">
          <h3>30 day returns</h3>
          <p>Easy returns on unused items.</p>
        </div>
      </div>
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          {% render 'pp-icon-3d', icon: 'secure', uid: 'foot-secure' %}
        </span>
        <div class="pp-benefits__copy">
          <h3>Secure checkout</h3>
          <p>Encrypted payments you can trust.</p>
        </div>
      </div>
      <div class="pp-benefits__item">
        <span class="pp-benefits__icon" aria-hidden="true">
          {% render 'pp-icon-3d', icon: 'support', uid: 'foot-support' %}
        </span>
        <div class="pp-benefits__copy">
          <h3>Friendly support</h3>
          <p>We&#39;re here to help.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .pp-site-footer .pp-benefits {
    padding: 40px 0 56px;
    background: #fff;
  }

  .pp-site-footer .pp-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .pp-site-footer .pp-benefits__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 0;
  }

  .pp-site-footer .pp-benefits__icon {
    flex-shrink: 0;
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .pp-site-footer .pp-benefits__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pp-site-footer .pp-benefits__copy {
    min-width: 0;
  }

  .pp-site-footer .pp-benefits__item h3 {
    font-family: var(--pp-font-heading);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pp-navy);
    margin: 0 0 4px;
  }

  .pp-site-footer .pp-benefits__item p {
    margin: 0;
    font-size: 13px;
    color: var(--pp-text-secondary);
    line-height: 1.4;
  }

  /* Desktop: first icon flush left, last item flush right. */
  @media (min-width: 1101px) {
    .pp-site-footer .pp-benefits__grid {
      display: flex;
      justify-content: space-between;
      gap: 32px;
    }
  }

  @media (max-width: 1100px) {
    .pp-site-footer .pp-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .pp-site-footer .pp-benefits__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}
