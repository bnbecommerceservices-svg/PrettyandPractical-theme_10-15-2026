{%- comment -%}
  Prints compact promo flags: |sale |bestseller

  Sale: the compare-at price is higher than the price. No tag is needed;
  clear a product's compare-at price to take it off sale.

  Bestseller: tagged bestseller / best seller / best-seller.
{%- endcomment -%}
{%- liquid
  if price != blank
    assign price_check = price
  else
    assign price_check = product.selected_or_first_available_variant.price | default: product.price
  endif

  if compare_at != blank
    assign compare_check = compare_at
  else
    assign compare_check = product.selected_or_first_available_variant.compare_at_price | default: product.compare_at_price
  endif

  assign has_bestseller_tag = false
  for tag in product.tags
    assign tag_l = tag | strip | downcase
    if tag_l == 'bestseller' or tag_l == 'best seller' or tag_l == 'best-seller'
      assign has_bestseller_tag = true
    endif
  endfor

  assign show_sale = false
  if compare_check > price_check
    assign show_sale = true
  endif

  assign flags = ''
  if show_sale
    assign flags = flags | append: '|sale'
  endif
  if has_bestseller_tag
    assign flags = flags | append: '|bestseller'
  endif
  echo flags
-%}
