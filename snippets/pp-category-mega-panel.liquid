{% doc %}
  One category in the "Shop by category" dropdown (snippets/pp-category-mega.liquid).
  Everything shown comes from the store: the category's sub-categories (the
  menu item's sub-links) or, when it has none, the collection's own product
  types as filter links.

  Text only, no images.
  layout 'column': a column of the "all categories" view, with the category
  name, up to 8 sub-links and a "Shop all" link.
  layout 'panel': the short box a top nav link opens: every sub-link (and its
  own sub-links, the third menu level, indented under it), then a
  "Shop all <category>" link.

  @param {string} layout - 'column' or 'panel'.
  @param {string} key - Matches the nav link's data-catmega-open value.
  @param {string} label - Category name.
  @param {string} url - Category link.
  @param {collection} [panel_collection] - The collection, when the category is one.
  @param {link[]} [child_links] - The menu item's sub-links, if it has any.
{% enddoc %}

{%- liquid
  assign has_children = false
  if child_links != blank and child_links.size > 0
    assign has_children = true
  endif
  assign link_limit = 18
  if layout == 'column'
    assign link_limit = 8
  endif
-%}

{%- capture panel_items -%}
  {%- if has_children -%}
    {%- for child in child_links limit: link_limit -%}
      {%- if layout == 'panel' and child.links.size > 0 -%}
        <li class="pp-catmega__item--parent">
          <a class="pp-catmega__link pp-catmega__link--parent" href="{{ child.url }}">{{ child.title | escape }}</a>
          <ul class="pp-catmega__sublinks" role="list">
            {%- for grandchild in child.links -%}
              <li><a class="pp-catmega__link pp-catmega__link--sub" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </li>
      {%- else -%}
        <li><a class="pp-catmega__link" href="{{ child.url }}">{{ child.title | escape }}</a></li>
      {%- endif -%}
    {%- endfor -%}
  {%- elsif panel_collection != blank and panel_collection.all_types.size > 0 -%}
    {%- assign seen = '|' -%}
    {%- assign shown = 0 -%}
    {%- for type in panel_collection.all_types -%}
      {%- assign type_label = type | strip -%}
      {%- assign type_key = type_label | downcase -%}
      {%- assign seen_key = '|' | append: type_key | append: '|' -%}
      {%- if type_label == blank or seen contains seen_key -%}{%- continue -%}{%- endif -%}
      {%- if shown >= link_limit -%}{%- break -%}{%- endif -%}
      {%- assign seen = seen | append: type_key | append: '|' -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- comment -%} One link covering every spelling of the type, e.g. "Plant Stand" and "Plant stand". {%- endcomment -%}
      {%- assign type_query = '' -%}
      {%- for other in panel_collection.all_types -%}
        {%- assign other_label = other | strip -%}
        {%- assign other_key = other_label | downcase -%}
        {%- if other_key == type_key -%}
          {%- if type_query != '' -%}{%- assign type_query = type_query | append: '&' -%}{%- endif -%}
          {%- assign other_value = other_label | url_encode -%}
          {%- assign type_query = type_query | append: 'filter.p.product_type=' | append: other_value -%}
        {%- endif -%}
      {%- endfor -%}
      <li><a class="pp-catmega__link" href="{{ url }}?{{ type_query }}">{{ type_label | escape }}</a></li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign panel_items = panel_items | strip -%}

{%- capture arrow -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
{%- endcapture -%}

{%- if layout == 'column' -%}
  <div class="pp-catmega__col">
    <a class="pp-catmega__col-head" href="{{ url }}">{{ label | escape }}</a>
    {%- if panel_items != blank -%}
      <ul class="pp-catmega__links" role="list">{{ panel_items }}</ul>
    {%- endif -%}
    <a class="pp-catmega__shop-all" href="{{ url }}">Shop all {{ arrow }}</a>
  </div>
{%- else -%}
  {%- comment -%}
    A department's own dropdown: a short box under its nav link with its
    sub-categories (their own sub-categories indented under them) and a
    "Shop all" link for the whole department at the end.
  {%- endcomment -%}
  <div class="pp-catmega__panel pp-catmega__panel--box" data-catmega-panel="{{ key | escape }}" hidden>
    {%- if panel_items != blank -%}
      <ul class="pp-catmega__links pp-catmega__box-links" role="list">{{ panel_items }}</ul>
    {%- endif -%}
    <a class="pp-catmega__box-all" href="{{ url }}" aria-label="Shop all {{ label | escape }}">
      <span>Shop all</span>
      {{ arrow }}
    </a>
  </div>
{%- endif -%}
