{% doc %}
  One panel of the "Shop by category" dropdown (snippets/pp-category-mega.liquid).
  Everything shown comes from the store: the menu item's sub-links, or the
  collection's own product types, its product count and its image.

  @param {string} key - Matches the rail tab's data-catmega-tab value.
  @param {string} label - Category name.
  @param {string} url - Category link.
  @param {collection} [panel_collection] - The collection, when the category is one.
  @param {link[]} [child_links] - The menu item's sub-links, if it has any.
  @param {boolean} [is_first] - Shows this panel when the dropdown first opens.
{% enddoc %}

{%- liquid
  assign panel_count = 0
  assign panel_image = blank
  if panel_collection != blank
    assign panel_count = panel_collection.all_products_count | default: 0
    assign panel_image = panel_collection.featured_image
  endif
  assign has_children = false
  if child_links != blank and child_links.size > 0
    assign has_children = true
  endif
-%}

<div class="pp-catmega__panel{% if is_first %} is-active{% endif %}" data-catmega-panel="{{ key | escape }}"{% unless is_first %} hidden{% endunless %}>
  {%- if has_children -%}
    <section class="pp-catmega__col">
      <h3>{{ label | escape }}</h3>
      <ul>
        {%- for child in child_links limit: 10 -%}
          <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </section>
  {%- elsif panel_collection != blank and panel_collection.all_types.size > 0 -%}
    {%- capture type_links -%}
        {%- assign seen = '|' -%}
        {%- assign shown = 0 -%}
        {%- for type in panel_collection.all_types -%}
          {%- assign type_label = type | strip -%}
          {%- assign type_key = type_label | downcase -%}
          {%- assign seen_key = '|' | append: type_key | append: '|' -%}
          {%- if type_label == blank or seen contains seen_key -%}{%- continue -%}{%- endif -%}
          {%- if shown >= 8 -%}{%- break -%}{%- endif -%}
          {%- assign seen = seen | append: type_key | append: '|' -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- comment -%} One link covering every spelling of the type, e.g. "Plant Stand" and "Plant stand". {%- endcomment -%}
          {%- assign type_query = '' -%}
          {%- for other in panel_collection.all_types -%}
            {%- assign other_label = other | strip -%}
            {%- assign other_key = other_label | downcase -%}
            {%- if other_key == type_key -%}
              {%- if type_query != '' -%}{%- assign type_query = type_query | append: '&' -%}{%- endif -%}
              {%- assign other_value = other_label | url_encode -%}
              {%- assign type_query = type_query | append: 'filter.p.product_type=' | append: other_value -%}
            {%- endif -%}
          {%- endfor -%}
          <li><a href="{{ url }}?{{ type_query }}">{{ type_label | escape }}</a></li>
        {%- endfor -%}
    {%- endcapture -%}
    {%- comment -%} Products without a type give an empty list; skip the column then. {%- endcomment -%}
    {%- if type_links != blank -%}
      <section class="pp-catmega__col">
        <h3>Shop by type</h3>
        <ul>
          {{ type_links }}
        </ul>
      </section>
    {%- endif -%}
  {%- endif -%}

  {%- if panel_collection != blank -%}
    <section class="pp-catmega__col">
      <h3>Browse</h3>
      <ul>
        <li><a href="{{ url }}">View all {{ panel_count }} {% if panel_count == 1 %}product{% else %}products{% endif %}</a></li>
        <li><a href="{{ url }}?sort_by=best-selling">Best sellers</a></li>
        <li><a href="{{ url }}?sort_by=created-descending">Newest</a></li>
      </ul>
    </section>
  {%- elsif has_children == false -%}
    <section class="pp-catmega__col">
      <h3>{{ label | escape }}</h3>
      <ul>
        <li><a href="{{ url }}">View {{ label | escape }}</a></li>
      </ul>
    </section>
  {%- endif -%}

  {%- if panel_image != blank -%}
    <a class="pp-catmega__feature" href="{{ url }}">
      <span class="pp-catmega__feature-media">
        {{
          panel_image
          | image_url: width: 480
          | image_tag:
            widths: '240, 360, 480',
            sizes: '240px',
            alt: label,
            loading: 'lazy'
        }}
      </span>
      <span class="pp-catmega__feature-label">
        <strong>{{ label | escape }}</strong>
        <span>Shop now <span aria-hidden="true">→</span></span>
      </span>
    </a>
  {%- endif -%}
</div>
