{% doc %}
  One panel of the "Shop by category" dropdown (snippets/pp-category-mega.liquid).
  Everything shown comes from the store: a "Shop all" link for the category,
  then its sub-categories (the menu item's sub-links) with their product counts,
  or the collection's own product types when the menu item has no sub-links.

  @param {string} key - Matches the rail tab's data-catmega-tab value.
  @param {string} label - Category name.
  @param {string} url - Category link.
  @param {collection} [panel_collection] - The collection, when the category is one.
  @param {link[]} [child_links] - The menu item's sub-links, if it has any.
  @param {boolean} [is_first] - Shows this panel when the dropdown first opens.
{% enddoc %}

{%- liquid
  assign panel_count = 0
  if panel_collection != blank
    assign panel_count = panel_collection.all_products_count | default: 0
  endif
  assign has_children = false
  if child_links != blank and child_links.size > 0
    assign has_children = true
  endif
-%}

{%- capture chevron -%}
  <svg class="pp-catmega__item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
{%- endcapture -%}

{%- capture panel_items -%}
  {%- if has_children -%}
    {%- for child in child_links limit: 12 -%}
      {%- assign child_count = blank -%}
      {%- if child.type == 'collection_link' -%}{%- assign child_count = child.object.all_products_count -%}{%- endif -%}
      <li>
        <a class="pp-catmega__item" href="{{ child.url }}">
          <span class="pp-catmega__item-text">
            <span class="pp-catmega__item-name">{{ child.title | escape }}</span>
            {%- if child_count != blank -%}
              <span class="pp-catmega__item-count">{{ child_count }} {% if child_count == 1 %}product{% else %}products{% endif %}</span>
            {%- endif -%}
          </span>
          {{ chevron }}
        </a>
      </li>
    {%- endfor -%}
  {%- elsif panel_collection != blank and panel_collection.all_types.size > 0 -%}
    {%- assign seen = '|' -%}
    {%- assign shown = 0 -%}
    {%- for type in panel_collection.all_types -%}
      {%- assign type_label = type | strip -%}
      {%- assign type_key = type_label | downcase -%}
      {%- assign seen_key = '|' | append: type_key | append: '|' -%}
      {%- if type_label == blank or seen contains seen_key -%}{%- continue -%}{%- endif -%}
      {%- if shown >= 12 -%}{%- break -%}{%- endif -%}
      {%- assign seen = seen | append: type_key | append: '|' -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- comment -%} One link covering every spelling of the type, e.g. "Plant Stand" and "Plant stand". {%- endcomment -%}
      {%- assign type_query = '' -%}
      {%- for other in panel_collection.all_types -%}
        {%- assign other_label = other | strip -%}
        {%- assign other_key = other_label | downcase -%}
        {%- if other_key == type_key -%}
          {%- if type_query != '' -%}{%- assign type_query = type_query | append: '&' -%}{%- endif -%}
          {%- assign other_value = other_label | url_encode -%}
          {%- assign type_query = type_query | append: 'filter.p.product_type=' | append: other_value -%}
        {%- endif -%}
      {%- endfor -%}
      <li>
        <a class="pp-catmega__item" href="{{ url }}?{{ type_query }}">
          <span class="pp-catmega__item-text">
            <span class="pp-catmega__item-name">{{ type_label | escape }}</span>
          </span>
          {{ chevron }}
        </a>
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div class="pp-catmega__panel{% if is_first %} is-active{% endif %}" data-catmega-panel="{{ key | escape }}"{% unless is_first %} hidden{% endunless %}>
  <div class="pp-catmega__head">
    <div class="pp-catmega__heading">
      <h3 class="pp-catmega__title">{{ label | escape }}</h3>
      {%- if panel_count > 0 -%}
        <p class="pp-catmega__meta">{{ panel_count }} {% if panel_count == 1 %}product{% else %}products{% endif %}</p>
      {%- endif -%}
    </div>
    <a class="pp-catmega__all" href="{{ url }}">
      Shop all {{ label | escape }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>

  {%- assign panel_items = panel_items | strip -%}
  {%- if panel_items != blank -%}
    <ul class="pp-catmega__grid">
      {{ panel_items }}
    </ul>
  {%- endif -%}
</div>
