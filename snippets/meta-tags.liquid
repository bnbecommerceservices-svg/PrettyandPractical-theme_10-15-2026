{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign pp_page_handle = page.handle | default: ''
  assign pp_noindex = false
  assign pp_canonical = canonical_url

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  if request.path contains '/policies/privacy'
    assign pp_canonical = '/policies/privacy-policy'
  elsif request.path contains '/policies/refund' or request.path contains '/policies/return'
    assign pp_canonical = '/policies/refund-policy'
  elsif request.path contains '/policies/shipping'
    assign pp_canonical = '/policies/shipping-policy'
  elsif request.path contains '/policies/terms'
    assign pp_canonical = '/policies/terms-of-service'
  elsif request.path contains '/policies/contact'
    assign pp_canonical = '/policies/contact-information'
  elsif request.page_type == 'page' and pp_page_handle == 'privacy-policy'
    assign pp_canonical = '/policies/privacy-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'privacy'
    assign pp_canonical = '/policies/privacy-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'refund-policy'
    assign pp_canonical = '/policies/refund-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'return-policy'
    assign pp_canonical = '/policies/refund-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'returns'
    assign pp_canonical = '/policies/refund-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'refunds'
    assign pp_canonical = '/policies/refund-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'shipping-policy'
    assign pp_canonical = '/policies/shipping-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'shipping'
    assign pp_canonical = '/policies/shipping-policy'
  elsif request.page_type == 'page' and pp_page_handle == 'terms-of-service'
    assign pp_canonical = '/policies/terms-of-service'
  elsif request.page_type == 'page' and pp_page_handle == 'terms'
    assign pp_canonical = '/policies/terms-of-service'
  elsif request.page_type == 'page' and pp_page_handle == 'terms-and-conditions'
    assign pp_canonical = '/policies/terms-of-service'
  elsif request.page_type == 'page' and pp_page_handle == 'contact-information'
    assign pp_canonical = '/policies/contact-information'
  endif
  if request.path contains '/policies/'
    if pp_canonical contains 'http'
      assign og_url = pp_canonical
    else
      assign og_url = request.origin | append: pp_canonical
    endif
  endif

  if pp_page_handle == 'sell-with-us' or pp_page_handle == 'seller-dashboard' or pp_page_handle == 'list-a-product' or pp_page_handle == 'bulk-list-products' or pp_page_handle == 'admin-dashboard' or pp_page_handle == 'product-listed' or pp_page_handle == 'ship-an-order' or pp_page_handle == 'bulk-upload-status' or pp_page_handle == 'shipment-recorded' or pp_page_handle == 'application-received'
    assign pp_noindex = true
  endif
%}
{%- if pp_noindex -%}
  <meta name="robots" content="noindex, nofollow">
{%- endif -%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ pp_canonical }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
