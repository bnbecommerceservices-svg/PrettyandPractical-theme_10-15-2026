{% doc %}
  Prints the inline background style for a colour swatch, or nothing when the
  colour can't be worked out (the option then shows its name without a dot).

  1. Shopify's own swatch for the option value (colour or image), when the
     option is linked to a colour in the product's category metafields.
  2. Otherwise the colour name is matched against the table below. Two-colour
     names such as "Black/Oak" or "White & Natural" show both colours.

  @param {object} value - Product option value (or plain string)
{% enddoc %}
{%- liquid
  assign swatch_out = ''

  if value.swatch.image
    assign swatch_img = value.swatch.image | image_url: width: 64
    assign swatch_out = 'background-image: url(' | append: swatch_img | append: '); background-size: cover; background-position: center;'
  elsif value.swatch.color
    assign swatch_out = 'background: ' | append: value.swatch.color | append: ';'
  endif

  if swatch_out == blank
    # Most specific names first: the first keyword found in the name wins.
    assign swatch_table = 'white-marble:#efece4;dark-marble:#3a3a3a;black-marble:#2b2b2b;grey-marble:#a9a9a9;gray-marble:#a9a9a9;marble:#e6e3db;rose-gold:#b76e79;light-grey:#d4d7dc;light-gray:#d4d7dc;dark-grey:#4b5563;dark-gray:#4b5563;off-white:#f5f2ea;natural-oak:#c8a165;light-oak:#d9b98a;dark-oak:#6f4e37;light-wood:#d9b98a;dark-wood:#5c4033;sky-blue:#87ceeb;light-blue:#a7c7e7;baby-blue:#a7c7e7;dusty-blue:#7d9bb5;royal-blue:#2a52be;navy-blue:#1f2a44;dark-blue:#1f3a6e;forest-green:#2e5e3e;dark-green:#24502f;light-green:#a8d5a2;sage-green:#9caf88;olive-green:#708238;light-pink:#f6c9d4;dusty-pink:#d8a7a7;hot-pink:#e0457b;dark-brown:#4a2f23;light-brown:#a47551;charcoal:#36454f;anthracite:#383e42;graphite:#3f4246;gunmetal:#53565a;slate:#5f6b73;ivory:#fffff0;cream:#f3ead3;beige:#e8dcc4;sand:#d8c7a6;stone:#c2b8a3;taupe:#8b7d6b;khaki:#b5a77a;oatmeal:#d9cdb4;linen:#ece3d2;greige:#bdb5a6;mocha:#7b5e4a;oak:#c8a165;walnut:#5c4033;teak:#a0703c;mahogany:#4e1f1a;cherry:#7b2d26;pine:#d6b57c;acacia:#b07d48;bamboo:#d8b97c;rattan:#c9a06b;wicker:#b88a4f;jute:#c9ad7f;timber:#b5895a;wood:#b5895a;natural:#c9a87c;espresso:#3b2a20;chocolate:#4a2f23;coffee:#6f4e37;brown:#7b5232;tan:#d2b48c;caramel:#b8763e;camel:#c19a6b;cognac:#9a4e1d;terracotta:#c8643b;rust:#b7472a;copper:#b87333;bronze:#8c6239;brass:#b5a642;gold:#c9a227;silver:#c0c0c0;chrome:#dfe3e8;nickel:#a7a9ac;steel:#8a9097;black:#111827;white:#ffffff;grey:#9ca3af;gray:#9ca3af;sage:#9caf88;olive:#708238;emerald:#2e8b57;mint:#b8e2c8;green:#3f8f4f;teal:#0f766e;turquoise:#40c4c4;aqua:#7fdbdb;navy:#1f2a44;denim:#3b5f8a;cobalt:#0047ab;blue:#2f5fb3;lavender:#c9b6e4;lilac:#c8a2c8;mauve:#b784a7;purple:#6b3fa0;violet:#7f4fc9;plum:#6e3a5a;burgundy:#800020;maroon:#7a1f2b;wine:#722f37;red:#c62828;coral:#f08070;blush:#f1c6c1;pink:#f2a6b8;peach:#f6c3a1;apricot:#f4b183;orange:#e8792b;mustard:#d4a72c;yellow:#f2c94c' | split: ';'

    assign swatch_name = value | append: ''
    assign swatch_parts = swatch_name | replace: ' & ', '/' | replace: ' and ', '/' | replace: ' with ', '/' | replace: '+', '/' | replace: ',', '/' | split: '/'
    assign swatch_found = ''
    assign swatch_found_count = 0

    for swatch_part in swatch_parts limit: 2
      assign swatch_padded = swatch_part | handleize | prepend: '-' | append: '-'
      for swatch_row in swatch_table
        assign swatch_key = swatch_row | split: ':' | first
        assign swatch_needle = swatch_key | prepend: '-' | append: '-'
        if swatch_padded contains swatch_needle
          assign swatch_hex = swatch_row | split: ':' | last
          if swatch_found == blank
            assign swatch_found = swatch_hex
            assign swatch_first_key = swatch_key
          else
            assign swatch_found = swatch_found | append: ',' | append: swatch_hex
          endif
          assign swatch_found_count = swatch_found_count | plus: 1
          break
        endif
      endfor
    endfor

    if swatch_found_count == 2
      assign swatch_colours = swatch_found | split: ','
      assign swatch_out = 'background: linear-gradient(135deg, ' | append: swatch_colours[0] | append: ' 50%, ' | append: swatch_colours[1] | append: ' 50%);'
    elsif swatch_found_count == 1
      if swatch_first_key contains 'marble'
        assign swatch_vein = '#ffffff'
        if swatch_first_key contains 'dark' or swatch_first_key contains 'black'
          assign swatch_vein = '#7a7a7a'
        endif
        assign swatch_out = 'background: linear-gradient(135deg, ' | append: swatch_found | append: ' 0%, ' | append: swatch_vein | append: ' 45%, ' | append: swatch_found | append: ' 100%);'
      else
        assign swatch_out = 'background: ' | append: swatch_found | append: ';'
      endif
    endif
  endif

  echo swatch_out
-%}
