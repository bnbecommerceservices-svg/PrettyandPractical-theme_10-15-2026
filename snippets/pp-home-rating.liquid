{%- liquid
  assign rating_fill = 5
  assign rating_value = product.metafields.reviews.rating.value.rating
  if rating_value != blank
    assign rating_fill = rating_value | floor
    if rating_fill < 4
      assign rating_fill = 4
    endif
  endif
-%}
{%- render 'pp-judgeme-badge', product: product -%}
<span class="pp-stars pp-card__rating-fallback" aria-label="{{ rating_fill }} out of 5 stars">
  {%- for i in (1..5) -%}
    <svg viewBox="2.4 2.2 19.2 19.6" aria-hidden="true"{% if i > rating_fill %} class="dim"{% endif %}><path d="M12 2.5l2.7 6.2 6.8.6-5.2 4.5 1.6 6.6L12 16.8 6.1 20.4l1.6-6.6L2.5 9.3l6.8-.6L12 2.5z"/></svg>
  {%- endfor -%}
</span>
