{%- comment -%}
  Collection sidebar / drawer filters, built only from Shopify's native
  filters (set up in the Search & Discovery app). Every input uses Shopify's
  own parameter names, so Shopify filters the whole collection and the
  counts next to each option are real.

  @param {string} source - desktop | drawer
  @param {string} section_id
  @param {filter[]} [filters] - defaults to collection.filters (search passes search.filters)
{%- endcomment -%}

{%- liquid
  assign pp_filters = filters | default: collection.filters
  assign auto_submit = false
  if source == 'desktop'
    assign auto_submit = true
  endif
-%}

{%- if pp_filters.size == 0 -%}
  <p class="pp-filters-empty">No filters are available for these products.</p>
{%- endif -%}

{%- for filter in pp_filters -%}
  {%- liquid
    assign group_open = true
    if forloop.index > 4 and filter.active_values.size == 0
      assign group_open = false
    endif
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign group_open = true
      endif
    endif
    assign filter_label_l = filter.label | strip | downcase
  -%}
  <section
    class="pp-filtergroup{% unless group_open %} is-collapsed{% endunless %}"
    data-filter-group
    data-filter-group-section="{{ filter.param_name | handle }}"
  >
    <button type="button" class="pp-filtergroup__head" data-group-toggle data-filter-toggle aria-expanded="{{ group_open }}">
      <span>{{ filter.label }}</span>
      <svg class="pp-filtergroup__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div class="pp-filtergroup__body">
      {%- case filter.type -%}
        {%- when 'price_range' -%}
          {%- liquid
            assign range_max = filter.range_max | divided_by: 100.0 | ceil
            assign price_min_val = ''
            assign price_max_val = ''
            assign cur_min = 'x'
            assign cur_max = 'x'
            if filter.min_value.value != null
              assign price_min_val = filter.min_value.value | money_without_currency | remove: ','
              assign cur_min = filter.min_value.value | divided_by: 100 | append: ''
            endif
            if filter.max_value.value != null
              assign price_max_val = filter.max_value.value | money_without_currency | remove: ','
              assign cur_max = filter.max_value.value | divided_by: 100 | append: ''
            endif
            # 'x' stands for "no limit" (Liquid's split drops empty items).
            assign band_mins = 'x,50,100,200,300' | split: ','
            assign band_maxs = '50,100,200,300,x' | split: ','
          -%}
          <div class="pp-fprice pp-fprice--go">
            <div class="pp-fprice__field pp-fprice__field--bare">
              <span class="pp-fprice__prefix" aria-hidden="true">$</span>
              <label class="sr-only" for="{{ source }}Min-{{ section_id }}">Minimum price</label>
              <input
                id="{{ source }}Min-{{ section_id }}"
                type="number"
                inputmode="decimal"
                name="{{ filter.min_value.param_name }}"
                value="{{ price_min_val }}"
                placeholder="0"
                min="0"
                max="{{ range_max }}"
                data-pp-filter-input
                data-price-input
                data-price-min
                autocomplete="off"
              >
            </div>
            <div class="pp-fprice__field pp-fprice__field--bare">
              <span class="pp-fprice__prefix" aria-hidden="true">$</span>
              <label class="sr-only" for="{{ source }}Max-{{ section_id }}">Maximum price</label>
              <input
                id="{{ source }}Max-{{ section_id }}"
                type="number"
                inputmode="decimal"
                name="{{ filter.max_value.param_name }}"
                value="{{ price_max_val }}"
                placeholder="{{ range_max }}"
                min="0"
                max="{{ range_max }}"
                data-pp-filter-input
                data-price-input
                data-price-max
                autocomplete="off"
              >
            </div>
            <button type="button" class="pp-fprice__go" data-pp-apply>Go</button>
          </div>

          {%- comment -%} Quick price bands, only those below the collection's highest price. {%- endcomment -%}
          <ul class="pp-fopts pp-fopts--radio" data-price-bands>
            <li>
              <label class="pp-fopt">
                <input type="radio" name="pp-price-band-{{ source }}" value="all" data-price-band="all" data-band-min="" data-band-max=""{% if cur_min == 'x' and cur_max == 'x' %} checked{% endif %}>
                <span class="pp-fopt__box pp-fopt__box--radio" aria-hidden="true"></span>
                <span class="pp-fopt__label">All prices</span>
              </label>
            </li>
            {%- for band_min in band_mins -%}
              {%- liquid
                assign band_max = band_maxs[forloop.index0]
                assign band_min_num = band_min | plus: 0
                if band_min != 'x' and band_min_num >= range_max
                  continue
                endif
                assign band_checked = false
                if cur_min == band_min and cur_max == band_max
                  assign band_checked = true
                endif
                assign band_key = band_min | append: '-' | append: band_max
                assign band_min_attr = band_min | remove: 'x'
                assign band_max_attr = band_max | remove: 'x'
              -%}
              <li>
                <label class="pp-fopt">
                  <input type="radio" name="pp-price-band-{{ source }}" value="{{ band_key }}" data-price-band="{{ band_key }}" data-band-min="{{ band_min_attr }}" data-band-max="{{ band_max_attr }}"{% if band_checked %} checked{% endif %}>
                  <span class="pp-fopt__box pp-fopt__box--radio" aria-hidden="true"></span>
                  <span class="pp-fopt__label">
                    {%- if band_min == 'x' -%}
                      Under ${{ band_max }}
                    {%- elsif band_max == 'x' -%}
                      ${{ band_min }}+
                    {%- else -%}
                      ${{ band_min }} – ${{ band_max }}
                    {%- endif -%}
                  </span>
                </label>
              </li>
            {%- endfor -%}
          </ul>

        {%- else -%}
          {%- liquid
            assign is_swatch = false
            if filter.presentation == 'swatch'
              assign is_swatch = true
            elsif filter_label_l == 'color' or filter_label_l == 'colour'
              assign is_swatch = true
            endif
          -%}
          {%- if is_swatch -%}
            <ul class="pp-fopts pp-fopts--swatch">
              {%- for value in filter.values -%}
                {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  capture swatch_style
                    render 'pp-swatch-style', value: value
                  endcapture
                  assign swatch_style = swatch_style | strip
                -%}
                <li>
                  <label class="pp-fopt">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      data-pp-filter-input
                      {% if auto_submit %}data-auto-submit-desktop{% endif %}
                    >
                    <span class="pp-fopt__box" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                    {%- if swatch_style != blank -%}
                      <span class="pp-fopt__swatch" style="{{ swatch_style }}" aria-hidden="true"></span>
                    {%- endif -%}
                    <span class="pp-fopt__label">{{ value.label }}</span>
                    <span class="pp-fopt__count">({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <ul class="pp-fopts">
              {%- for value in filter.values -%}
                {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign value_label = value.label
                  if filter.type == 'boolean'
                    if value.value == '1' or value.value == 'true'
                      assign value_label = 'Yes'
                    elsif value.value == '0' or value.value == 'false'
                      assign value_label = 'No'
                    endif
                  endif
                  if filter_label_l contains 'rating'
                    assign value_label = value.label | append: ' stars & up'
                  endif
                -%}
                <li>
                  <label class="pp-fopt">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      data-pp-filter-input
                      {% if auto_submit %}data-auto-submit-desktop{% endif %}
                    >
                    <span class="pp-fopt__box" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                    <span class="pp-fopt__label">{{ value_label }}</span>
                    <span class="pp-fopt__count">({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
      {%- endcase -%}
    </div>
  </section>
{%- endfor -%}
