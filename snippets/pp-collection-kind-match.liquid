{%- comment -%}
  Sets pp_match false when an empty collection is proxying another
  collection and this product does not belong in the empty one.
{%- endcomment -%}
{%- if pp_empty_map -%}
  {%- liquid
    assign kind_ok = false
    assign kind_type = product.type | downcase
    assign kind_title = product.title | downcase
    assign kind_tags = product.tags | join: ' ' | downcase
    assign kind_hay = kind_title | append: ' ' | append: kind_type | append: ' ' | append: kind_tags
  -%}
  {%- case pp_empty_kind -%}
    {%- when 'tv' -%}
      {%- if kind_type == 'tv stands & mounts' or kind_type == 'tv stands' or kind_hay contains 'tv stand' or kind_hay contains 'tv trolley' or kind_hay contains 'tv cart' or kind_hay contains 'tv mount' or kind_hay contains 'tv cabinet' or kind_hay contains 'entertainment unit' -%}
        {%- assign kind_ok = true -%}
      {%- endif -%}
    {%- when 'outdoor' -%}
      {%- if kind_type == 'outdoor' or kind_hay contains 'camping' or kind_hay contains 'kayak' or kind_hay contains 'canoe' or kind_hay contains 'golf bag' or kind_hay contains 'surfboard' or kind_hay contains 'surf board' or kind_hay contains 'wood burning' or kind_hay contains 'tent stove' or kind_hay contains 'caravan' -%}
        {%- assign kind_ok = true -%}
      {%- endif -%}
    {%- when 'bedroom' -%}
      {%- if kind_tags contains 'room:bedroom' or kind_hay contains 'bedside' or kind_hay contains 'nightstand' or kind_hay contains 'night stand' or kind_hay contains 'wardrobe' or kind_hay contains 'jewellery cabinet' or kind_hay contains 'jewelry cabinet' or kind_hay contains 'shoe rack' or kind_hay contains 'shoe cabinet' -%}
        {%- assign kind_ok = true -%}
      {%- endif -%}
    {%- when 'living' -%}
      {%- if kind_tags contains 'room:living' or kind_hay contains 'coffee table' or kind_hay contains 'side table' or kind_hay contains 'nesting' or kind_hay contains 'bookshelf' or kind_hay contains 'bookcase' or kind_hay contains 'tv stand' or kind_hay contains 'console table' -%}
        {%- assign kind_ok = true -%}
      {%- endif -%}
    {%- when 'office' -%}
      {%- if kind_tags contains 'room:office' or kind_hay contains 'desk' or kind_hay contains 'filing' or kind_hay contains 'office chair' or kind_hay contains 'pedestal' -%}
        {%- assign kind_ok = true -%}
      {%- endif -%}
  {%- endcase -%}
  {%- unless kind_ok -%}
    {%- assign pp_match = false -%}
  {%- endunless -%}
{%- endif -%}
