{%- comment -%}
  3D benefit icon used on the homepage, footer, product page and cart.
  Pass icon: 'truck', 'returns', 'secure', 'support' (or 'star') or 'heart',
  and a uid that is unique on the page, so the gradient ids don't clash.
{%- endcomment -%}
{%- assign p = 'ppi-' | append: uid | append: '-' | append: icon | append: '-' -%}
{%- case icon -%}
  {%- when 'truck' -%}
    <svg class="pp-icon3d" viewBox="-0.75 4.5 60 60" fill="none" focusable="false" aria-hidden="true"><defs><linearGradient id="{{ p }}o" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9d76"/><stop offset="1" stop-color="#e0481e"/></linearGradient><linearGradient id="{{ p }}d" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d9481b"/><stop offset="1" stop-color="#a22d0d"/></linearGradient><linearGradient id="{{ p }}l" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe0d2"/><stop offset="1" stop-color="#ffb594"/></linearGradient><linearGradient id="{{ p }}n" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#52627a"/><stop offset="1" stop-color="#0f172a"/></linearGradient></defs><path d="M8 22l5-6h28l-5 6z" fill="url(#{{ p }}l)"/><rect x="8" y="22" width="28" height="22" rx="2.5" fill="url(#{{ p }}o)"/><path d="M36 22l5-6v22l-5 6z" fill="url(#{{ p }}d)"/><rect x="11" y="26" width="9" height="3" rx="1.5" fill="#fff" opacity=".45"/><path d="M41 27h9.5l8 9.5V44H41z" fill="url(#{{ p }}n)"/><path d="M45 30.5h4.2l5.2 6H45z" fill="#cfe3f5"/><circle cx="19" cy="46" r="7" fill="url(#{{ p }}n)"/><circle cx="19" cy="46" r="3" fill="#e2e8f0"/><circle cx="19" cy="46" r="1.1" fill="#e8532a"/><circle cx="49" cy="46" r="7" fill="url(#{{ p }}n)"/><circle cx="49" cy="46" r="3" fill="#e2e8f0"/><circle cx="49" cy="46" r="1.1" fill="#e8532a"/><path d="M2 30h6M0 36h8M3 42h5" stroke="#e8532a" stroke-width="2.2" stroke-linecap="round" opacity=".55"/></svg>
  {%- when 'returns' -%}
    <svg class="pp-icon3d" viewBox="3 3 58 58" fill="none" focusable="false" aria-hidden="true"><defs><linearGradient id="{{ p }}o" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9d76"/><stop offset="1" stop-color="#e0481e"/></linearGradient><linearGradient id="{{ p }}d" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d9481b"/><stop offset="1" stop-color="#a22d0d"/></linearGradient><linearGradient id="{{ p }}l" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe0d2"/><stop offset="1" stop-color="#ffb594"/></linearGradient><linearGradient id="{{ p }}n" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#52627a"/><stop offset="1" stop-color="#0f172a"/></linearGradient></defs><path d="M32 21l11 6-11 6-11-6z" fill="url(#{{ p }}l)"/><path d="M21 27l11 6v13l-11-6z" fill="url(#{{ p }}o)"/><path d="M43 27v13l-11 6V33z" fill="url(#{{ p }}d)"/><path d="M27 24.5l11 6" stroke="#fff" stroke-width="1.6" opacity=".6" stroke-linecap="round"/><path d="M9.5 28A24 24 0 0 1 44 9.5" stroke="url(#{{ p }}n)" stroke-width="5" stroke-linecap="round"/><path d="M42 3.5l8.5 5.5-7.5 7z" fill="url(#{{ p }}n)"/><path d="M54.5 36A24 24 0 0 1 20 54.5" stroke="url(#{{ p }}n)" stroke-width="5" stroke-linecap="round"/><path d="M22 60.5L13.5 55l7.5-7z" fill="url(#{{ p }}n)"/></svg>
  {%- when 'secure' -%}
    <svg class="pp-icon3d" viewBox="3 3.5 58 58" fill="none" focusable="false" aria-hidden="true"><defs><linearGradient id="{{ p }}o" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9d76"/><stop offset="1" stop-color="#e0481e"/></linearGradient><linearGradient id="{{ p }}d" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d9481b"/><stop offset="1" stop-color="#a22d0d"/></linearGradient><linearGradient id="{{ p }}l" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe0d2"/><stop offset="1" stop-color="#ffb594"/></linearGradient><linearGradient id="{{ p }}n" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#52627a"/><stop offset="1" stop-color="#0f172a"/></linearGradient></defs><path d="M32 4l23 8.5v17C55 44.5 45 55 32 61 19 55 9 44.5 9 29.5v-17z" fill="url(#{{ p }}n)"/><path d="M32 4l23 8.5v17C55 44.5 45 55 32 61z" fill="#000" opacity=".2"/><path d="M32 11l16 6v12.5c0 10-6.6 18-16 23-9.4-5-16-13-16-23V17z" fill="url(#{{ p }}o)"/><path d="M32 11l16 6v12.5c0 10-6.600 18-16 23z" fill="#000" opacity=".12"/><path d="M22.5 33.5l7 7 13-15.5" stroke="#7c1f06" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" opacity=".3" transform="translate(0 1.6)"/><path d="M22.5 33.5l7 7 13-15.5" stroke="#fff" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 15l5-2" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".35"/></svg>
  {%- when 'support', 'star' -%}
    <svg class="pp-icon3d" viewBox="3 8 58 58" fill="none" focusable="false" aria-hidden="true"><defs><linearGradient id="{{ p }}o" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9d76"/><stop offset="1" stop-color="#e0481e"/></linearGradient><linearGradient id="{{ p }}d" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d9481b"/><stop offset="1" stop-color="#a22d0d"/></linearGradient><linearGradient id="{{ p }}l" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe0d2"/><stop offset="1" stop-color="#ffb594"/></linearGradient><linearGradient id="{{ p }}n" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#52627a"/><stop offset="1" stop-color="#0f172a"/></linearGradient></defs><path d="M11 38v-6a21 21 0 0 1 42 0v6" stroke="url(#{{ p }}n)" stroke-width="5.5" stroke-linecap="round"/><rect x="5.5" y="31" width="13" height="21" rx="6" fill="url(#{{ p }}o)"/><rect x="45.5" y="31" width="13" height="21" rx="6" fill="url(#{{ p }}d)"/><rect x="8" y="35" width="3.2" height="10" rx="1.6" fill="#fff" opacity=".45"/><rect x="48" y="35" width="3.2" height="10" rx="1.6" fill="#fff" opacity=".3"/><path d="M52 52c0 6.500-5 8.500-12 8.500" stroke="url(#{{ p }}n)" stroke-width="3.6" stroke-linecap="round"/><rect x="31" y="56.500" width="10" height="6.500" rx="3.200" fill="url(#{{ p }}o)"/></svg>
  {%- when 'heart' -%}
    <svg class="pp-icon3d" viewBox="3 3 58 58" fill="none" focusable="false" aria-hidden="true"><defs><linearGradient id="{{ p }}o" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9d76"/><stop offset="1" stop-color="#e0481e"/></linearGradient><linearGradient id="{{ p }}d" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d9481b"/><stop offset="1" stop-color="#a22d0d"/></linearGradient></defs><path d="M32 56C16 45 6 35 6 23 6 14 13 8 21 8c5 0 9 2.5 11 6.5C34 10.5 38 8 43 8c8 0 15 6 15 15 0 12-10 22-26 33z" fill="url(#{{ p }}o)"/><path d="M32 14.5C34 10.5 38 8 43 8c8 0 15 6 15 15 0 12-10 22-26 33z" fill="url(#{{ p }}d)" opacity=".55"/><ellipse cx="18" cy="18" rx="5" ry="3.2" transform="rotate(-35 18 18)" fill="#fff" opacity=".45"/></svg>
{%- endcase -%}
