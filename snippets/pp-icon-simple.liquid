{%- comment -%}
  Simple line benefit icon. All four are drawn on the same 24px grid with the
  same stroke and about the same visual size, so they read as one set. Coloured
  with currentColor, so the wrapper sets the colour and size.
  Pass icon: 'truck', 'returns', 'secure' or 'support' (or 'star', shown as support).
{%- endcomment -%}
{%- case icon -%}
  {%- when 'truck' -%}
    <svg class="pp-icon-simple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><g transform="translate(.5 0)"><path d="M4.9 17H3.75a1.25 1.25 0 0 1-1.25-1.25v-8.5A1.25 1.25 0 0 1 3.75 6h8.5a1.25 1.25 0 0 1 1.25 1.25V17"/><path d="M8.6 17h6.3"/><path d="M13.5 9.5h3.4c.45 0 .87.21 1.14.57l2.13 2.86c.2.26.33.57.33.9v1.92a1.25 1.25 0 0 1-1.25 1.25h-.65"/><circle cx="6.75" cy="17" r="1.85"/><circle cx="16.75" cy="17" r="1.85"/></g></svg>
  {%- when 'returns' -%}
    <svg class="pp-icon-simple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.35-5.65L4 8.7"/><path d="M4 4.25V8.7h4.45"/><path d="M12 8v4.25l2.75 1.75"/></svg>
  {%- when 'secure' -%}
    <svg class="pp-icon-simple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M12 2.75 4.75 5.5v5.75c0 4.6 3 8.3 7.25 9.95 4.25-1.65 7.25-5.35 7.25-9.95V5.5z"/><path d="m8.75 12 2.25 2.25 4.25-4.5"/></svg>
  {%- when 'support', 'star' -%}
    <svg class="pp-icon-simple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M5.25 12.5v-.75a6.75 6.75 0 0 1 13.5 0v.75"/><rect x="3.25" y="12.5" width="4" height="6" rx="1.5"/><rect x="16.75" y="12.5" width="4" height="6" rx="1.5"/><path d="M18.75 18.5a2.5 2.5 0 0 1-2.5 2.5H14"/></svg>
{%- endcase -%}
